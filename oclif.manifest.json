{
  "commands": {
    "schema": {
      "aliases": [],
      "args": {},
      "description": "Print one line per command, or one command in full with --command, from the oclif manifest.",
      "examples": [
        "<%= config.bin %> <%= command.id %>",
        "<%= config.bin %> <%= command.id %> --output json",
        "<%= config.bin %> <%= command.id %> --command \"get indexes\"",
        "<%= config.bin %> <%= command.id %> | jq '.commands[].id'"
      ],
      "flags": {
        "project-url": {
          "description": "Project URL, the Meilisearch instance to talk to.",
          "name": "project-url",
          "hasDynamicHelp": false,
          "helpValue": "<url>",
          "multiple": false,
          "type": "option"
        },
        "project-api-key": {
          "description": "Project API key. `-` reads it from stdin.",
          "name": "project-api-key",
          "hasDynamicHelp": false,
          "helpValue": "<key>",
          "multiple": false,
          "type": "option"
        },
        "project": {
          "description": "A project of the config file. Cannot be combined with --project-url. Required when the file has several projects.",
          "name": "project",
          "hasDynamicHelp": false,
          "helpValue": "<name>",
          "multiple": false,
          "type": "option"
        },
        "output": {
          "char": "o",
          "description": "json (default): one document, the API body as it is, indented in a terminal, compact when piped. ndjson: one item per line, list commands only, streams with --all.",
          "name": "output",
          "hasDynamicHelp": false,
          "helpValue": "<mode>",
          "multiple": false,
          "options": [
            "json",
            "ndjson"
          ],
          "type": "option"
        },
        "debug": {
          "description": "Print every HTTP request and response on stderr, secrets redacted.",
          "name": "debug",
          "allowNo": false,
          "type": "boolean"
        },
        "command": {
          "description": "Print this command in full instead of the index: its API, its routes, its key actions, the flags it declares itself and its examples.",
          "name": "command",
          "hasDynamicHelp": false,
          "helpValue": "<command>",
          "multiple": false,
          "type": "option"
        }
      },
      "hasDynamicHelp": false,
      "hiddenAliases": [],
      "id": "schema",
      "pluginAlias": "@meilisearch/cli",
      "pluginName": "@meilisearch/cli",
      "pluginType": "core",
      "strict": true,
      "enableJsonFlag": false,
      "api": "none",
      "routes": [],
      "keyActions": [],
      "waitFlags": {
        "wait": {
          "description": "Poll the task until it reaches a final status, then print the final task.",
          "allowNo": false,
          "type": "boolean"
        },
        "timeout": {
          "description": "Maximum wait time, for example 30s, 2m. Default 60s. Only with --wait.",
          "helpValue": "<duration>",
          "dependsOn": [
            "wait"
          ],
          "input": [],
          "multiple": false,
          "type": "option"
        }
      },
      "paginationFlags": {
        "limit": {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "input": [],
          "multiple": false,
          "type": "option"
        },
        "offset": {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "input": [],
          "multiple": false,
          "type": "option"
        },
        "all": {
          "description": "Fetch every page. Streams with ndjson, buffers into one array with json.",
          "allowNo": false,
          "type": "boolean"
        }
      },
      "bodyInputFlags": {
        "file": {
          "description": "Read the body from a file. `-` reads from stdin.",
          "helpValue": "<path>",
          "exclusive": [
            "data"
          ],
          "input": [],
          "multiple": false,
          "type": "option"
        },
        "data": {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "input": [],
          "multiple": false,
          "type": "option"
        }
      },
      "confirmFlags": {
        "yes": {
          "required": true,
          "description": "Confirm the deletion. Nothing is sent to the API without it.",
          "allowNo": false,
          "type": "boolean"
        }
      },
      "isESM": true,
      "relativePath": [
        "dist",
        "commands",
        "schema.js"
      ]
    },
    "search": {
      "aliases": [],
      "args": {},
      "description": "Search an index, and get the hits with the API envelope around them.",
      "examples": [
        "<%= config.bin %> <%= command.id %> --index movies --q nosferatu",
        "<%= config.bin %> <%= command.id %> --index movies --q vampire --limit 5 --output json",
        "<%= config.bin %> <%= command.id %> --index movies --filter 'year > 1920' --sort year:asc",
        "<%= config.bin %> <%= command.id %> --index movies --data '{\"q\":\"vampire\",\"hybrid\":{\"embedder\":\"default\"}}'"
      ],
      "flags": {
        "project-url": {
          "description": "Project URL, the Meilisearch instance to talk to.",
          "name": "project-url",
          "hasDynamicHelp": false,
          "helpValue": "<url>",
          "multiple": false,
          "type": "option"
        },
        "project-api-key": {
          "description": "Project API key. `-` reads it from stdin.",
          "name": "project-api-key",
          "hasDynamicHelp": false,
          "helpValue": "<key>",
          "multiple": false,
          "type": "option"
        },
        "project": {
          "description": "A project of the config file. Cannot be combined with --project-url. Required when the file has several projects.",
          "name": "project",
          "hasDynamicHelp": false,
          "helpValue": "<name>",
          "multiple": false,
          "type": "option"
        },
        "output": {
          "char": "o",
          "description": "json (default): one document, the API body as it is, indented in a terminal, compact when piped. ndjson: one item per line, list commands only, streams with --all.",
          "name": "output",
          "hasDynamicHelp": false,
          "helpValue": "<mode>",
          "multiple": false,
          "options": [
            "json",
            "ndjson"
          ],
          "type": "option"
        },
        "debug": {
          "description": "Print every HTTP request and response on stderr, secrets redacted.",
          "name": "debug",
          "allowNo": false,
          "type": "boolean"
        },
        "index": {
          "description": "The index to search.",
          "name": "index",
          "required": true,
          "hasDynamicHelp": false,
          "helpValue": "<index>",
          "multiple": false,
          "type": "option"
        },
        "q": {
          "description": "The search terms.",
          "name": "q",
          "hasDynamicHelp": false,
          "helpValue": "<query>",
          "multiple": false,
          "type": "option"
        },
        "filter": {
          "description": "A filter expression, on the filterable attributes of the index.",
          "name": "filter",
          "hasDynamicHelp": false,
          "helpValue": "<filter>",
          "multiple": false,
          "type": "option"
        },
        "sort": {
          "description": "Attributes to sort by, each one as attribute:asc or attribute:desc.",
          "name": "sort",
          "hasDynamicHelp": false,
          "helpValue": "<attributes>",
          "multiple": false,
          "type": "option"
        },
        "limit": {
          "description": "Maximum number of hits.",
          "name": "limit",
          "hasDynamicHelp": false,
          "helpValue": "<n>",
          "multiple": false,
          "type": "option"
        },
        "offset": {
          "description": "Number of hits to skip.",
          "name": "offset",
          "hasDynamicHelp": false,
          "helpValue": "<n>",
          "multiple": false,
          "type": "option"
        },
        "page": {
          "description": "Page of hits to return. The envelope then carries totalHits and totalPages instead of estimatedTotalHits.",
          "name": "page",
          "hasDynamicHelp": false,
          "helpValue": "<n>",
          "multiple": false,
          "type": "option"
        },
        "hits-per-page": {
          "description": "Hits per page.",
          "name": "hits-per-page",
          "hasDynamicHelp": false,
          "helpValue": "<n>",
          "multiple": false,
          "type": "option"
        },
        "facets": {
          "description": "Attributes to return facet counts for.",
          "name": "facets",
          "hasDynamicHelp": false,
          "helpValue": "<attributes>",
          "multiple": false,
          "type": "option"
        },
        "attributes-to-retrieve": {
          "description": "Attributes to keep in each hit.",
          "name": "attributes-to-retrieve",
          "hasDynamicHelp": false,
          "helpValue": "<attributes>",
          "multiple": false,
          "type": "option"
        },
        "attributes-to-search-on": {
          "description": "Attributes to search in, among the searchable ones.",
          "name": "attributes-to-search-on",
          "hasDynamicHelp": false,
          "helpValue": "<attributes>",
          "multiple": false,
          "type": "option"
        },
        "distinct": {
          "description": "Return one hit per distinct value of this attribute.",
          "name": "distinct",
          "hasDynamicHelp": false,
          "helpValue": "<attribute>",
          "multiple": false,
          "type": "option"
        },
        "matching-strategy": {
          "description": "How the engine drops query terms when a document matches none of them.",
          "name": "matching-strategy",
          "hasDynamicHelp": false,
          "helpValue": "<strategy>",
          "multiple": false,
          "options": [
            "last",
            "all",
            "frequency"
          ],
          "type": "option"
        },
        "show-ranking-score": {
          "description": "Add _rankingScore to every hit.",
          "name": "show-ranking-score",
          "allowNo": false,
          "type": "boolean"
        },
        "file": {
          "description": "Read the body from a file. `-` reads from stdin.",
          "exclusive": [
            "data"
          ],
          "name": "file",
          "hasDynamicHelp": false,
          "helpValue": "<path>",
          "multiple": false,
          "type": "option"
        },
        "data": {
          "description": "Inline JSON body.",
          "name": "data",
          "hasDynamicHelp": false,
          "helpValue": "<json>",
          "multiple": false,
          "type": "option"
        }
      },
