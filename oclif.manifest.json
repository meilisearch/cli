{
  "commands": {
    "schema": {
      "aliases": [],
      "args": {},
      "description": "Print every command with its flags and examples as JSON, from the oclif manifest.",
      "examples": [
        "<%= config.bin %> <%= command.id %>",
        "<%= config.bin %> <%= command.id %> --output json",
        "<%= config.bin %> <%= command.id %> | jq '.commands[].id'"
      ],
      "flags": {
        "project-url": {
          "description": "Project URL, the Meilisearch instance to talk to.",
          "name": "project-url",
          "hasDynamicHelp": false,
          "helpValue": "<url>",
          "multiple": false,
          "type": "option"
        },
        "project-api-key": {
          "description": "Project API key.",
          "name": "project-api-key",
          "hasDynamicHelp": false,
          "helpValue": "<key>",
          "multiple": false,
          "type": "option"
        },
        "output": {
          "char": "o",
          "description": "json (default): one document, the API body as it is, indented in a terminal, compact when piped. ndjson: one item per line, list commands only, streams with --all.",
          "name": "output",
          "hasDynamicHelp": false,
          "helpValue": "<mode>",
          "multiple": false,
          "options": [
            "json",
            "ndjson"
          ],
          "type": "option"
        },
        "debug": {
          "description": "Print every HTTP request and response on stderr, secrets redacted.",
          "name": "debug",
          "allowNo": false,
          "type": "boolean"
        }
      },
      "hasDynamicHelp": false,
      "hiddenAliases": [],
      "id": "schema",
      "pluginAlias": "@meilisearch/cli",
      "pluginName": "@meilisearch/cli",
      "pluginType": "core",
      "strict": true,
      "enableJsonFlag": false,
      "api": "none",
      "routes": [],
      "waitFlags": {
        "wait": {
          "description": "Poll the task until it reaches a final status, then print the final task.",
          "allowNo": false,
          "type": "boolean"
        },
        "timeout": {
          "description": "Maximum wait time, for example 30s, 2m. Default 60s. Only with --wait.",
          "helpValue": "<duration>",
          "dependsOn": [
            "wait"
          ],
          "input": [],
          "multiple": false,
          "type": "option"
        }
      },
      "paginationFlags": {
        "limit": {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "input": [],
          "multiple": false,
          "type": "option"
        },
        "offset": {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "input": [],
          "multiple": false,
          "type": "option"
        },
        "all": {
          "description": "Fetch every page. Streams with ndjson, buffers into one array with json.",
          "allowNo": false,
          "type": "boolean"
        }
      },
      "bodyInputFlags": {
        "file": {
          "description": "Read the body from a file. `-` reads from stdin.",
          "helpValue": "<path>",
          "exclusive": [
            "data"
          ],
          "input": [],
          "multiple": false,
          "type": "option"
        },
        "data": {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "input": [],
          "multiple": false,
          "type": "option"
        }
      },
      "isESM": true,
      "relativePath": [
        "dist",
        "commands",
        "schema.js"
      ]
    },
