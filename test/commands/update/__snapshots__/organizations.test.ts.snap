// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili update organizations > passes the API's error body through on a 403, with exit 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"project_not_accessible","type":"auth","message":"You cannot access this project.","link":"https://www.meilisearch.com/docs/reference/errors#project_not_accessible"}}
",
  "stdout": "",
}
`;

exports[`meili update organizations > prints its help without any network call 1`] = `
"Rename a Meilisearch Cloud organization.

USAGE
  $ meili update organizations --id <id> [-o <mode>] [--debug] [--name <name>]
    [--file <path> | --data <json>]

FLAGS
  -o, --output=<mode>  json (default): one document, the API body as it is,
                       indented in a terminal, compact when piped. ndjson: one
                       item per line, list commands only, streams with --all.
      --data=<json>    Inline JSON body.
      --debug          Print every HTTP request and response on stderr, secrets
                       redacted.
      --file=<path>    Read the body from a file. \`-\` reads from stdin.
      --id=<id>        (required) The organization to update.
      --name=<name>    New name of the organization.

DESCRIPTION
  Rename a Meilisearch Cloud organization.

EXAMPLES
  $ meili update organizations --id 7 --name Acme

  $ meili update organizations --id 7 --name Acme --output json

  $ meili update organizations --id 7 --data '{"name":"Acme"}'

"
`;

exports[`meili update organizations > sends the new name for the organization of --id, and prints the organization updated 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"id":1,"name":"Renamed","identifier":"acme","ownerId":"user-1","isAdmin":true,"defaultTeamId":12,"customerTier":null}
",
}
`;
