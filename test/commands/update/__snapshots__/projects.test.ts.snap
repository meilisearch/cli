// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili update projects > maps a 403 to management_forbidden and exit 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"management_forbidden","type":"management","message":"Forbidden"}}
",
  "stdout": "",
}
`;

exports[`meili update projects > prints its help without any network call 1`] = `
"Rename a Meilisearch Cloud project.

USAGE
  $ meili update projects --id <id> [--project-url <url>] [--project-api-key
    <key>] [--project <name>] [--management-token <pat>] [--management-url
    <url>] [-o <mode>] [--debug] [--name <name>] [--file <path> | --data <json>]

FLAGS
  -o, --output=<mode>           json (default): one document, the API body as it
                                is, indented in a terminal, compact when piped.
                                ndjson: one item per line, list commands only,
                                streams with --all.
      --data=<json>             Inline JSON body.
      --debug                   Print every HTTP request and response on stderr,
                                secrets redacted.
      --file=<path>             Read the body from a file. \`-\` reads from stdin.
      --id=<id>                 (required) The project to update.
      --management-token=<pat>  Management API personal access token.
      --management-url=<url>    Management API base URL. Default
                                https://api.meilisearch.com.
      --name=<name>             New name of the project.
      --project=<name>          A project of the config file. Cannot be combined
                                with --project-url. Required when the file has
                                several projects.
      --project-api-key=<key>   Project API key. \`-\` reads it from stdin.
      --project-url=<url>       Project URL, the Meilisearch instance to talk
                                to.

DESCRIPTION
  Rename a Meilisearch Cloud project.

EXAMPLES
  $ meili update projects --id 343 --name renamed

  $ meili update projects --id 343 --name renamed --output json

  $ meili update projects --id 343 --data '{"name":"renamed"}'

"
`;

exports[`meili update projects > sends the new name for the project of --id, and prints the project updated 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"id":343,"name":"renamed","projectUid":"ms-abc","url":"https://ms-abc.sfo.meilisearch.io","apikey":"projectmasterkey9z8y","teamId":12,"resourceId":3,"msVersion":"v1.54.0","workloadType":"production","readOnly":false,"status":"running","paused":false,"createdAt":"2026-10-14T10:00:00Z","resource":{"id":3,"name":"build","plan":"build","regionId":1}}
",
}
`;
