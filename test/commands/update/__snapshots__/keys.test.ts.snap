// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili update keys > passes an authentication error through with a hint and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\` or \`MEILI_PROJECT_API_KEY\`."}}
",
  "stdout": "",
}
`;

exports[`meili update keys > passes the 404 of an unknown key through and exits 4 1`] = `
{
  "exitCode": 4,
  "stderr": "{"error":{"code":"api_key_not_found","type":"invalid_request","message":"API key not found.","link":"https://docs.meilisearch.com/errors#api_key_not_found"}}
",
  "stdout": "",
}
`;

exports[`meili update keys > prints its help without any network call 1`] = `
"Change the name or the description of an API key, the two fields the route takes, and reset one with the value null.

USAGE
  $ meili update keys --id <key> [-o <mode>] [--debug] [--project-url
    <url>] [--project-api-key <key>] [--project <name>] [--name <name>]
    [--description <text>] [--file <path> | --data <json>]

FLAGS
  -o, --output=<mode>          json (default): one document, the API body as it
                               is, indented in a terminal, compact when piped.
                               ndjson: one item per line, list commands only,
                               streams with --all.
      --data=<json>            Inline JSON body.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --description=<text>     New description of the key. The value null
                               removes the one it has.
      --file=<path>            Read the body from a file. \`-\` reads from stdin.
      --id=<key>               (required) The key to update, by its uid or by
                               its key value.
      --name=<name>            New name of the key. The value null removes the
                               one it has.
      --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. Required when the file has
                               several projects.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.

DESCRIPTION
  Change the name or the description of an API key, the two fields the route
  takes, and reset one with the value null.

EXAMPLES
  $ meili update keys --id 52787ccd-48ff-48e5-9c4b-03cd76978a60 --name 'CI indexer'

  $ meili update keys --id 52787ccd-48ff-48e5-9c4b-03cd76978a60 --description 'Indexes the catalog nightly' --output json

  $ meili update keys --id 52787ccd-48ff-48e5-9c4b-03cd76978a60 --description null

"
`;

exports[`meili update keys > prints the key the API returned, as it returned it 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"name":"CI indexer","description":null,"key":"115f7b0806e6eb3409870fbfef319371dff43dd036746816358c1d71ad4e2221","actions":["search"],"indexes":["*"],"expiresAt":null,"createdAt":"2026-09-24T10:00:00.000000Z","updatedAt":"2026-09-24T10:00:00.000000Z","uid":"52787ccd-48ff-48e5-9c4b-03cd76978a60"}
",
}
`;
