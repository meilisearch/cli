// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili update documents > passes an authentication error through and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\` or \`MEILI_PROJECT_API_KEY\`."}}
",
  "stdout": "",
}
`;

exports[`meili update documents > prints its help without any network call 1`] = `
"Update documents of an index, merging each one into the stored document that shares its identifier.

USAGE
  $ meili update documents --index <index> [--project-url <url>]
    [--project-api-key <key>] [--project <name>] [-o <mode>] [--debug]
    [--primary-key <field>] [--skip-creation] [--custom-metadata <text>] [--file
    <path> | --data <json>] [--timeout <duration> --wait]

FLAGS
  -o, --output=<mode>           json (default): one document, the API body as it
                                is, indented in a terminal, compact when piped.
                                ndjson: one item per line, list commands only,
                                streams with --all.
      --custom-metadata=<text>  A string stored with the task, to recognize it
                                later.
      --data=<json>             Inline JSON body.
      --debug                   Print every HTTP request and response on stderr,
                                secrets redacted.
      --file=<path>             Read the body from a file. \`-\` reads from stdin.
      --index=<index>           (required) The index the documents go to.
      --primary-key=<field>     The field that holds the identifier of each
                                document. Only read the first time documents are
                                added to the index.
      --project=<name>          A project of the config file. Cannot be combined
                                with --project-url. Required when the file has
                                several projects.
      --project-api-key=<key>   Project API key. \`-\` reads it from stdin.
      --project-url=<url>       Project URL, the Meilisearch instance to talk
                                to.
      --skip-creation           Only update documents that already exist, and
                                ignore the others.
      --timeout=<duration>      Maximum wait time, for example 30s, 2m. Default
                                60s. Only with --wait.
      --wait                    Poll the task until it reaches a final status,
                                then print the final task.

DESCRIPTION
  Update documents of an index, merging each one into the stored document that
  shares its identifier.

EXAMPLES
  $ meili update documents --index movies --file patch.json

  $ meili update documents --index movies --file - --wait --output json

  $ meili update documents --index movies --data '[{"id":1,"rating":9}]'

"
`;

exports[`meili update documents > sends the partial documents on the PUT route and prints the enqueued task 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":12,"indexUid":"movies","status":"enqueued","type":"documentAdditionOrUpdate","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;
