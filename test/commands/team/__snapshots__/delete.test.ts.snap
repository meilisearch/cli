// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili team delete > passes the API's error body through on an unknown id, with exit 4 1`] = `
{
  "exitCode": 4,
  "stderr": "{"error":{"code":"team_not_found","type":"invalid_request","message":"Team not found.","link":"https://www.meilisearch.com/docs/reference/errors#team_not_found"}}
",
  "stdout": "",
}
`;

exports[`meili team delete > prints its help without any network call 1`] = `
"Delete a Meilisearch Cloud team.

USAGE
  $ meili team delete --id <id> --yes [--debug]

FLAGS
  --debug    Print every HTTP request and response on stderr, secrets redacted.
  --id=<id>  (required) The team to delete.
  --yes      (required) Confirm the deletion. Nothing is sent to the API without
             it.

DESCRIPTION
  Delete a Meilisearch Cloud team.

  The team must have no project left. Prints nothing on success.

EXAMPLES
  $ meili team delete --id 12 --yes

"
`;
