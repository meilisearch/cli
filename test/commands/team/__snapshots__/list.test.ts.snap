// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili team list > exits 6 on a 401 without a body 1`] = `
{
  "exitCode": 6,
  "stderr": "{"error":{"code":"cli_network","type":"cli","message":"The server at https://management.test/api/v2/teams answered HTTP 401 without a Management API error body."}}
",
  "stdout": "",
}
`;

exports[`meili team list > lists the teams in the envelope the API returns 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"offset":0,"limit":20,"total":2,"results":[{"id":12,"name":"Search","organizationId":1,"ownerId":"user-1","isAdmin":true},{"id":13,"name":"Docs","organizationId":1,"ownerId":"user-1","isAdmin":true}]}
",
}
`;

exports[`meili team list > prints its help without any network call 1`] = `
"List the Meilisearch Cloud teams.

USAGE
  $ meili team list [--json] [--no-color] [--debug] [--organization-id
    <id>] [--limit <n>] [--offset <n>] [--all]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  --all                   Fetch every page, and print them as one list.
  --debug                 Print every HTTP request and response on stderr,
                          secrets redacted.
  --limit=<n>             Passed to the API.
  --offset=<n>            Passed to the API.
  --organization-id=<id>  Only the teams of this organization.

DESCRIPTION
  List the Meilisearch Cloud teams.

  Only the teams the token sees.

EXAMPLES
  $ meili team list

  $ meili team list --organization-id 1

"
`;
