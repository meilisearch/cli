// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili key add > passes an authentication error through with a hint and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\`."}}
",
  "stdout": "",
}
`;

exports[`meili key add > prints its help without any network call 1`] = `
"Create an API key.

USAGE
  $ meili key add [--json] [--no-color] [--debug] [--project-url
    <url>] [--project-api-key <key>] [-p <name>] [--id <uuid>] [--actions
    <actions>] [--indexes <indexes>] [--expires-at <date>] [--name <name>]
    [--description <text>] [--file <path> | --data <json>]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  -p, --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. One of --project or
                               --project-url is required.
      --actions=<actions>      Actions the key permits, comma-separated, for
                               example \`search\` or \`documents.*\`. \`*\` permits
                               them all.
      --data=<json>            Inline JSON body.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --description=<text>     Description of the key.
      --expires-at=<date>      Expiration date in RFC 3339 format. The value
                               null creates a key that never expires.
      --file=<path>            Read the body from a file. \`-\` reads from stdin.
      --id=<uuid>              Uid of the key, a uuid v4. Without it,
                               Meilisearch generates one.
      --indexes=<indexes>      Indexes the key reaches, comma-separated. \`*\`
                               reaches them all, and \`products_*\` every index of
                               that prefix.
      --name=<name>            Name of the key.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.
                               One of --project or --project-url is required.

DESCRIPTION
  Create an API key.

  The key runs --actions on --indexes until --expires-at.

  The answer carries the \`key\` field, the credential itself, on stdout like any
  other data.

EXAMPLES
  $ meili key add --project prod --actions search --indexes movies --expires-at null

  $ meili key add -p prod --actions search --indexes '*' --expires-at 2027-01-01T00:00:00Z

  $ meili key add -p prod --actions documents.add,documents.delete --indexes movies --expires-at null --name 'CI indexer'

  $ meili key add -p prod --data '{"actions":["search"],"indexes":["movies"],"expiresAt":null}'

"
`;

exports[`meili key add > prints the key the API created, its key value included 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"name":"CI indexer","description":null,"key":"115f7b0806e6eb3409870fbfef319371dff43dd036746816358c1d71ad4e2221","actions":["documents.add"],"indexes":["movies"],"expiresAt":null,"createdAt":"2026-09-24T10:00:00.000000Z","updatedAt":"2026-09-24T10:00:00.000000Z","uid":"52787ccd-48ff-48e5-9c4b-03cd76978a60"}
",
}
`;

exports[`meili key add > tells a human in a terminal what it did 1`] = `
{
  "exitCode": 0,
  "stderr": "✓ Key CI indexer is created.
Actions documents.add • Indexes movies • Expires never

",
  "stdout": "  name         CI indexer
  description  null
  key          115f7b0806e6eb3409870fbfef319371dff43dd036746816358c1d71ad4e2221
  actions      documents.add
  indexes      movies
  expiresAt    null
  createdAt    2026-09-24T10:00:00.000000Z
  updatedAt    2026-09-24T10:00:00.000000Z
  uid          52787ccd-48ff-48e5-9c4b-03cd76978a60
",
}
`;
