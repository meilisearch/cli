// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili key list > passes an authentication error through with a hint and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\`."}}
",
  "stdout": "",
}
`;

exports[`meili key list > prints its help without any network call 1`] = `
"List the API keys of the instance.

USAGE
  $ meili key list [-o <mode>] [--debug] [--project-url <url>]
    [--project-api-key <key>] [--project <name>] [--limit <n>] [--offset <n>]
    [--all]

FLAGS
  -o, --output=<mode>          json (default): one document, the API body as it
                               is, indented in a terminal, compact when piped.
                               ndjson: one item per line, only for the commands
                               that print a list of items, streams with --all.
      --all                    Fetch every page. Streams with ndjson, buffers
                               into one array with json.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --limit=<n>              Passed to the API.
      --offset=<n>             Passed to the API.
      --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. One of --project or
                               --project-url is required.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.
                               One of --project or --project-url is required.

DESCRIPTION
  List the API keys of the instance.

  The answer is the API body as it is, so it carries the \`key\` field of every
  key it returns: credentials that work, on stdout, like any other data.

EXAMPLES
  $ meili key list --project prod

  $ meili key list --project prod --output json

  $ meili key list --project prod --limit 5 --offset 10

  $ meili key list --project prod --all --output ndjson

"
`;

exports[`meili key list > prints the API envelope as it is, the key of every key included 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"results":[{"name":"Default Search API Key","description":"Use it to search from the frontend","key":"115f7b0806e6eb3409870fbfef319371dff43dd036746816358c1d71ad4e2221","actions":["search"],"indexes":["*"],"expiresAt":null,"createdAt":"2026-09-24T10:00:00.000000Z","updatedAt":"2026-09-24T10:00:00.000000Z","uid":"52787ccd-48ff-48e5-9c4b-03cd76978a60"},{"name":"Default Admin API Key","description":"Use it for anything that is not a search operation","key":"5dad55f9b953543783f152231fae2213ecc10c218498369b50e6925b1163c657","actions":["*"],"indexes":["*"],"expiresAt":null,"createdAt":"2026-09-24T10:00:00.000000Z","updatedAt":"2026-09-24T10:00:00.000000Z","uid":"89208a34-d4e0-4e00-80e0-f21039c312b8"}],"offset":0,"limit":20,"total":2}
",
}
`;
