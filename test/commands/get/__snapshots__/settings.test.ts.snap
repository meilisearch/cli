// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili get settings > passes the API error of a missing index through and exits 4 1`] = `
{
  "exitCode": 4,
  "stderr": "{"error":{"code":"index_not_found","type":"invalid_request","message":"Index \`missing\` not found.","link":"https://docs.meilisearch.com/errors#index_not_found"}}
",
  "stdout": "",
}
`;

exports[`meili get settings > prints its help without any network call 1`] = `
"Get every setting of an index, each with its current value or its default.

USAGE
  $ meili get settings --index <index> [-o <mode>] [--debug]
    [--project-url <url>] [--project-api-key <key>] [--project <name>]

FLAGS
  -o, --output=<mode>          json (default): one document, the API body as it
                               is, indented in a terminal, compact when piped.
                               ndjson: one item per line, list commands only,
                               streams with --all.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --index=<index>          (required) The index to read the settings of.
      --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. Required when the file has
                               several projects.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.

DESCRIPTION
  Get every setting of an index, each with its current value or its default.

EXAMPLES
  $ meili get settings --index movies

  $ meili get settings --index movies --output json

"
`;

exports[`meili get settings > prints the settings as the API returned them 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"displayedAttributes":["*"],"searchableAttributes":["title","overview"],"filterableAttributes":["genres"],"sortableAttributes":[],"rankingRules":["words","typo","proximity","attribute","sort","exactness"],"stopWords":["the"],"synonyms":{"phone":["iPhone"]},"distinctAttribute":null,"typoTolerance":{"enabled":true,"minWordSizeForTypos":{"oneTypo":5,"twoTypos":9}},"pagination":{"maxTotalHits":1000},"searchCutoffMs":null,"facetSearch":true,"prefixSearch":"indexingTime"}
",
}
`;
