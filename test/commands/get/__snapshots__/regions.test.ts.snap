exports[`meili get regions > prints its help without any network call 1`] = `
"List the Meilisearch Cloud regions where a project can run.

USAGE
  $ meili get regions [-o <mode>] [--debug]

FLAGS
  -o, --output=<mode>  json (default): one document, the API body as it is,
                       indented in a terminal, compact when piped. ndjson: one
                       item per line, list commands only, streams with --all.
      --debug          Print every HTTP request and response on stderr, secrets
                       redacted.

DESCRIPTION
  List the Meilisearch Cloud regions where a project can run.

EXAMPLES
  $ meili get regions

  $ meili get regions --output json

  $ meili get regions --output ndjson

"
`;
