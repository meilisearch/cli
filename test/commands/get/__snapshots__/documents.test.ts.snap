// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili get documents > passes the 404 of an unknown index through and exits 4 1`] = `
{
  "exitCode": 4,
  "stderr": "{"error":{"code":"index_not_found","type":"invalid_request","message":"Index \`nope\` not found.","link":"https://docs.meilisearch.com/errors#index_not_found"}}
",
  "stdout": "",
}
`;

exports[`meili get documents > prints its help without any network call 1`] = `
"List the documents of an index, or the ones --ids or --filter selects.

USAGE
  $ meili get documents --index <index> [--project-url <url>]
    [--project-api-key <key>] [--project <name>] [-o <mode>] [--debug] [--ids
    <ids>] [--filter <filter>] [--fields <attributes>] [--sort <attributes>]
    [--retrieve-vectors] [--limit <n>] [--offset <n>] [--all] [--file <path> |
    --data <json>]

FLAGS
  -o, --output=<mode>          json (default): one document, the API body as it
                               is, indented in a terminal, compact when piped.
                               ndjson: one item per line, list commands only,
                               streams with --all.
      --all                    Fetch every page. Streams with ndjson, buffers
                               into one array with json.
      --data=<json>            Inline JSON body.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --fields=<attributes>    Attributes to keep in each document.
      --file=<path>            Read the body from a file. \`-\` reads from stdin.
      --filter=<filter>        A filter expression, on the filterable attributes
                               of the index.
      --ids=<ids>              Identifiers of the documents to return.
      --index=<index>          (required) The index to read the documents from.
      --limit=<n>              Passed to the API.
      --offset=<n>             Passed to the API.
      --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. Required when the file has
                               several projects.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.
      --retrieve-vectors       Add the embeddings of each document under
                               _vectors.
      --sort=<attributes>      Attributes to sort by, each one as attribute:asc
                               or attribute:desc.

DESCRIPTION
  List the documents of an index, or the ones --ids or --filter selects.

EXAMPLES
  $ meili get documents --index movies --limit 5 --output json

  $ meili get documents --index movies --ids 1,2

  $ meili get documents --index movies --filter 'year > 1920' --fields id,title

  $ meili get documents --index movies --all --output ndjson

"
`;

exports[`meili get documents > prints the API envelope as it is 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"results":[{"id":1,"title":"Movie 1","year":1921},{"id":2,"title":"Movie 2","year":1922}],"offset":0,"limit":20,"total":2}
",
}
`;
