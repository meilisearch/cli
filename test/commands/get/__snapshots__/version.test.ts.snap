// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili get version > passes the API error of a key the instance refuses through and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\` or \`MEILI_PROJECT_API_KEY\`."}}
",
  "stdout": "",
}
`;

exports[`meili get version > prints its help without any network call 1`] = `
"Get the version of the Meilisearch instance, with the commit it was built from.

USAGE
  $ meili get version [-o <mode>] [--debug] [--project-url <url>]
    [--project-api-key <key>] [--project <name>]

FLAGS
  -o, --output=<mode>          json (default): one document, the API body as it
                               is, indented in a terminal, compact when piped.
                               ndjson: one item per line, list commands only,
                               streams with --all.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. Required when the file has
                               several projects.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.

DESCRIPTION
  Get the version of the Meilisearch instance, with the commit it was built
  from.

EXAMPLES
  $ meili get version

  $ meili get version --output json

"
`;

exports[`meili get version > prints the version as the API returned it 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"commitSha":"b46889b5f0f2f8b91438a08a358ba8f05fc09fc1","commitDate":"2026-09-24T10:00:00.000000Z","pkgVersion":"1.54.0"}
",
}
`;
