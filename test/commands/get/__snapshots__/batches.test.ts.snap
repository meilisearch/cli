{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"results":[{"progress":null,"details":{"receivedDocuments":1,"indexedDocuments":1},"stats":{"totalNbTasks":1,"status":{"succeeded":1},"types":{"documentAdditionOrUpdate":1},"indexUids":{"movies":1}},"duration":"PT0.001S","startedAt":"2026-09-24T10:00:00.000000Z","finishedAt":"2026-09-24T10:00:00.001000Z","batchStrategy":"batched all enqueued tasks","uid":5},{"progress":null,"details":{"receivedDocuments":1,"indexedDocuments":1},"stats":{"totalNbTasks":1,"status":{"succeeded":1},"types":{"documentAdditionOrUpdate":1},"indexUids":{"movies":1}},"duration":"PT0.001S","startedAt":"2026-09-24T10:00:00.000000Z","finishedAt":"2026-09-24T10:00:00.001000Z","batchStrategy":"batched all enqueued tasks","uid":4},{"progress":null,"details":{"receivedDocuments":1,"indexedDocuments":1},"stats":{"totalNbTasks":1,"status":{"succeeded":1},"types":{"documentAdditionOrUpdate":1},"indexUids":{"movies":1}},"duration":"PT0.001S","startedAt":"2026-09-24T10:00:00.000000Z","finishedAt":"2026-09-24T10:00:00.001000Z","batchStrategy":"batched all enqueued tasks","uid":3},{"progress":null,"details":{"receivedDocuments":1,"indexedDocuments":1},"stats":{"totalNbTasks":1,"status":{"succeeded":1},"types":{"documentAdditionOrUpdate":1},"indexUids":{"movies":1}},"duration":"PT0.001S","startedAt":"2026-09-24T10:00:00.000000Z","finishedAt":"2026-09-24T10:00:00.001000Z","batchStrategy":"batched all enqueued tasks","uid":2},{"progress":null,"details":{"receivedDocuments":1,"indexedDocuments":1},"stats":{"totalNbTasks":1,"status":{"succeeded":1},"types":{"documentAdditionOrUpdate":1},"indexUids":{"movies":1}},"duration":"PT0.001S","startedAt":"2026-09-24T10:00:00.000000Z","finishedAt":"2026-09-24T10:00:00.001000Z","batchStrategy":"batched all enqueued tasks","uid":1}],"total":5,"limit":20,"from":5,"next":null}
",
}
`;
