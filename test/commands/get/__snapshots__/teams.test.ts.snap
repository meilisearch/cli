// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili get teams > gets one team with --id 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"id":13,"name":"Search","organizationId":1,"ownerId":"user-1","isAdmin":true}
",
}
`;

exports[`meili get teams > lists the teams in the envelope the API returns, with no paging flag yet 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"page":1,"limit":20,"total":2,"totalPages":1,"results":[{"id":12,"name":"Search","organizationId":1,"ownerId":"user-1","isAdmin":true},{"id":13,"name":"Docs","organizationId":1,"ownerId":"user-1","isAdmin":true}]}
",
}
`;

exports[`meili get teams > passes the API's error body through on an unknown id, with exit 4 1`] = `
{
  "exitCode": 4,
  "stderr": "{"error":{"code":"team_not_found","type":"invalid_request","message":"Team not found.","link":"https://www.meilisearch.com/docs/reference/errors#team_not_found"}}
",
  "stdout": "",
}
`;

exports[`meili get teams > prints its help without any network call 1`] = `
"List the Meilisearch Cloud teams the token sees, or get one with --id.

USAGE
  $ meili get teams [-o <mode>] [--debug] [--id <id>]

FLAGS
  -o, --output=<mode>  json (default): one document, the API body as it is,
                       indented in a terminal, compact when piped. ndjson: one
                       item per line, list commands only, streams with --all.
      --debug          Print every HTTP request and response on stderr, secrets
                       redacted.
      --id=<id>        The team to get. Without it, the command lists the teams.

DESCRIPTION
  List the Meilisearch Cloud teams the token sees, or get one with --id.

EXAMPLES
  $ meili get teams

  $ meili get teams --output json

  $ meili get teams --id 12

  $ meili get teams --output ndjson

"
`;
