// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili get organizations > gets one organization with --id 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"id":2,"name":"Beta","identifier":"beta","ownerId":"user-1","isAdmin":false,"defaultTeamId":12,"customerTier":null}
",
}
`;

exports[`meili get organizations > lists the organizations in the envelope the API returns, with no paging flag yet 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"page":1,"limit":20,"total":2,"totalPages":1,"results":[{"id":1,"name":"Acme","identifier":"acme","ownerId":"user-1","isAdmin":true,"defaultTeamId":12,"customerTier":null},{"id":2,"name":"Beta","identifier":"beta","ownerId":"user-1","isAdmin":false,"defaultTeamId":12,"customerTier":null}]}
",
}
`;

exports[`meili get organizations > passes the API's error body through on an organization it does not show, with exit 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"project_not_accessible","type":"auth","message":"You cannot access this project.","link":"https://www.meilisearch.com/docs/reference/errors#project_not_accessible"}}
",
  "stdout": "",
}
`;

exports[`meili get organizations > prints its help without any network call 1`] = `
"List the Meilisearch Cloud organizations the token sees, or get one with --id.

USAGE
  $ meili get organizations [-o <mode>] [--debug] [--id <id>]

FLAGS
  -o, --output=<mode>  json (default): one document, the API body as it is,
                       indented in a terminal, compact when piped. ndjson: one
                       item per line, list commands only, streams with --all.
      --debug          Print every HTTP request and response on stderr, secrets
                       redacted.
      --id=<id>        The organization to get. Without it, the command lists
                       the organizations.

DESCRIPTION
  List the Meilisearch Cloud organizations the token sees, or get one with --id.

EXAMPLES
  $ meili get organizations

  $ meili get organizations --output json

  $ meili get organizations --id 7

  $ meili get organizations --output ndjson

"
`;
