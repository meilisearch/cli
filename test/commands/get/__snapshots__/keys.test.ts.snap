exports[`meili get keys > passes an authentication error through with a hint and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\` or \`MEILI_PROJECT_API_KEY\`."}}
",
  "stdout": "",
}
`;

exports[`meili get keys > passes the 404 of an unknown key through and exits 4 1`] = `
{
  "exitCode": 4,
  "stderr": "{"error":{"code":"api_key_not_found","type":"invalid_request","message":"API key not found.","link":"https://docs.meilisearch.com/errors#api_key_not_found"}}
",
  "stdout": "",
}
`;

exports[`meili get keys > prints its help without any network call 1`] = `
"List the API keys of the instance, or get one with --id.

USAGE
  $ meili get keys [-o <mode>] [--debug] [--project-url <url>]
    [--project-api-key <key>] [--project <name>] [--id <key>] [--limit <n>]
    [--offset <n>] [--all]

FLAGS
  -o, --output=<mode>          json (default): one document, the API body as it
                               is, indented in a terminal, compact when piped.
                               ndjson: one item per line, list commands only,
                               streams with --all.
      --all                    Fetch every page. Streams with ndjson, buffers
                               into one array with json.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --id=<key>               The key to get, by its uid or by its key value.
                               Without it, the command lists the keys.
      --limit=<n>              Passed to the API.
      --offset=<n>             Passed to the API.
      --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. Required when the file has
                               several projects.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.

DESCRIPTION
  List the API keys of the instance, or get one with --id.

  The answer is the API body as it is, so it carries the \`key\` field of every
  key it returns: credentials that work, on stdout, like any other data.

EXAMPLES
  $ meili get keys

  $ meili get keys --output json

  $ meili get keys --id 52787ccd-48ff-48e5-9c4b-03cd76978a60

  $ meili get keys --limit 5 --offset 10

  $ meili get keys --all --output ndjson

"
`;

