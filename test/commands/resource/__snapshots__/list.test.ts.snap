exports[`meili resource list > fails with cli_auth_missing and exit 3 without a token, before any network call 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"cli_auth_missing","type":"cli","message":"No Management API credentials.","hint":"Run \`meili auth login\` to log in with a browser."}}
",
  "stdout": "",
}
`;

exports[`meili resource list > lists the resources in the envelope the API returns 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"offset":0,"limit":20,"total":2,"results":[{"id":3,"name":"build","displayName":"Build","plan":"build_plan","regionId":1,"storage":10,"memory":1,"vcpu":0.5,"fullPlan":null},{"id":7,"name":"build","displayName":"Build","plan":"build_plan","regionId":2,"storage":10,"memory":1,"vcpu":0.5,"fullPlan":null}]}
",
}
`;

exports[`meili resource list > prints its help without any network call 1`] = `
"List the Meilisearch Cloud resources.

USAGE
  $ meili resource list [--json] [--no-color] [--debug] [--region-id <id>]
    [--plan legacy|build_plan|pro_plan|custom_plan|grow_plan|free_trial|enterpri
    se_plan|resource_based_plan] [--limit <n>] [--offset <n>] [--all]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  --all             Fetch every page, and print them as one list.
  --debug           Print every HTTP request and response on stderr, secrets
                    redacted.
  --limit=<n>       Passed to the API.
  --offset=<n>      Passed to the API.
  --plan=<option>   Only the resources of this plan.
                    <options: legacy|build_plan|pro_plan|custom_plan|grow_plan|f
                    ree_trial|enterprise_plan|resource_based_plan>
  --region-id=<id>  Only the resources of this region.

DESCRIPTION
  List the Meilisearch Cloud resources.

  The active plans a project runs on, with their pricing.

EXAMPLES
  $ meili resource list

  $ meili resource list --region-id 1

  $ meili resource list --plan resource_based_plan

"
`;
