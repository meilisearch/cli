exports[`meili resource list > fails with cli_auth_missing and exit 3 without a token, before any network call 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"cli_auth_missing","type":"cli","message":"No Management API credentials.","hint":"Run \`meili auth login\` to log in with a browser."}}
",
  "stdout": "",
}
`;

exports[`meili resource list > lists the resources in the envelope the API returns, with no paging flag yet 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"page":1,"limit":20,"total":2,"totalPages":1,"results":[{"id":3,"name":"build","displayName":"Build","plan":"build","regionId":1,"storage":10,"memory":1,"vcpu":0.5,"fullPlan":null},{"id":7,"name":"build","displayName":"Build","plan":"build","regionId":2,"storage":10,"memory":1,"vcpu":0.5,"fullPlan":null}]}
",
}
`;

exports[`meili resource list > prints its help without any network call 1`] = `
"List the Meilisearch Cloud resources.

USAGE
  $ meili resource list [-o <mode>] [--debug] [--region-id <id>]

FLAGS
  -o, --output=<mode>   json (default): one document, the API body as it is,
                        indented in a terminal, compact when piped. ndjson: one
                        item per line, only for the commands that print a list
                        of items, streams with --all.
      --debug           Print every HTTP request and response on stderr, secrets
                        redacted.
      --region-id=<id>  Only the resources of this region.

DESCRIPTION
  List the Meilisearch Cloud resources.

  The active plans a project runs on, with their pricing.

EXAMPLES
  $ meili resource list

  $ meili resource list --output json

  $ meili resource list --region-id 1

"
`;
