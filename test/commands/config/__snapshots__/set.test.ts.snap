// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili config set > keeps the key given, and writes the entry without a key, with a warning, when the master key is not readable 1`] = `
{
  "exitCode": 0,
  "stderr": "{"warning":{"code":"not_an_owner","type":"auth","message":"No master key for project 343 (demo): only an owner of its team or organization can read it.","link":"https://www.meilisearch.com/docs/reference/errors#not_an_owner","hint":"Ask an owner of the team for a key, then run \`meili config update --project member --project-api-key -\`."}}
",
  "stdout": "",
}
`;

exports[`meili config set > prints its help without any network call 1`] = `
"Add a project to the config file.

USAGE
  $ meili config set -p <name> --project-url <url> [--debug]
    [--project-api-key <key>] [--sync-with-cloud]

FLAGS
  -p, --project=<name>         (required) Name of the project to set.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --project-api-key=<key>  API key of the project. \`-\` reads it from stdin,
                               out of the shell history.
      --project-url=<url>      (required) URL of the project.
      --sync-with-cloud        Write the entry's cloud identifiers from
                               Meilisearch Cloud, and its master key when the
                               entry has no key. Never replaces a key.

DESCRIPTION
  Add a project to the config file.

  Creates the file, owner-only, and refuses a name that exists. Talks to the
  Management API only with --sync-with-cloud.

EXAMPLES
  $ meili config set --project local --project-url http://localhost:7700

  $ meili config set -p prod --project-url https://ms-abc.sfo.meilisearch.io --project-api-key - < key.txt

  $ meili config set -p prod --project-url https://ms-abc.sfo.meilisearch.io --sync-with-cloud

"
`;
