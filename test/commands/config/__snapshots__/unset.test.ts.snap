// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili config unset > prints its help without any network call 1`] = `
"Remove a project from the config file.

USAGE
  $ meili config unset --project <name> [-o <mode>] [--debug]

FLAGS
  -o, --output=<mode>   json (default): one document, the API body as it is,
                        indented in a terminal, compact when piped. ndjson: one
                        item per line, list commands only, streams with --all.
      --debug           Print every HTTP request and response on stderr, secrets
                        redacted.
      --project=<name>  (required) Name of the project to remove.

DESCRIPTION
  Remove a project from the config file.

  The file holds API keys and decides where every later command goes, for every
  process that reads it: an agent runs this only when the human asked for it
  explicitly.

EXAMPLES
  $ meili config unset --project prod

  $ meili config unset --project prod --output json

"
`;
