// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili config update > prints its help without any network call 1`] = `
"Change a project of the config file.

USAGE
  $ meili config update --project <name> [--debug] [--project-url <url>]
    [--project-api-key <key>] [--sync-with-cloud]

FLAGS
  --debug                  Print every HTTP request and response on stderr,
                           secrets redacted.
  --project=<name>         (required) Name of the project to change.
  --project-api-key=<key>  New API key of the project. \`-\` reads it from stdin,
                           out of the shell history.
  --project-url=<url>      New URL of the project.
  --sync-with-cloud        Write the entry's cloud identifiers from Meilisearch
                           Cloud, and its master key when the entry has no key.
                           Never replaces a key.

DESCRIPTION
  Change a project of the config file.

  Changes the fields given, and refuses a name that does not exist. Talks to the
  Management API only with --sync-with-cloud.

EXAMPLES
  $ meili config update --project prod --sync-with-cloud

  $ meili config update --project prod --project-api-key - < key.txt

  $ meili config update --project local --project-url http://localhost:7701

"
`;

exports[`meili config update > refreshes the cloud identifiers of the entry's cloud.id, keeps its key and its URL, and warns on a URL the Cloud does not give 1`] = `
{
  "exitCode": 0,
  "stderr": "{"warning":{"code":"cli_config","type":"cli","message":"The URL of \`prod\`, https://elsewhere.example.com, is not the URL Meilisearch Cloud gives for project 343, https://ms-abc.sfo.meilisearch.io. The entry keeps its URL."}}
",
  "stdout": "",
}
`;
