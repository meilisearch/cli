// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili config update > prints its help without any network call 1`] = `
"Change the fields given of a project of the config file; refuses a name that does not exist. Talks to the Management API only with --sync-with-cloud.

USAGE
  $ meili config update --project <name> [-o <mode>] [--debug]
    [--project-url <url>] [--project-api-key <key>] [--management-token <pat>
    --sync-with-cloud] [--management-url <url> ]

FLAGS
  -o, --output=<mode>           json (default): one document, the API body as it
                                is, indented in a terminal, compact when piped.
                                ndjson: one item per line, list commands only,
                                streams with --all.
      --debug                   Print every HTTP request and response on stderr,
                                secrets redacted.
      --management-token=<pat>  Management API personal access token.
      --management-url=<url>    Management API base URL. Default
                                https://api.meilisearch.com.
      --project=<name>          (required) Name of the project to change.
      --project-api-key=<key>   New API key of the project. \`-\` reads it from
                                stdin, out of the shell history.
      --project-url=<url>       New URL of the project.
      --sync-with-cloud         Write the entry's cloud identifiers from
                                Meilisearch Cloud, and its master key when the
                                entry has no key. Never replaces a key.

DESCRIPTION
  Change the fields given of a project of the config file; refuses a name that
  does not exist. Talks to the Management API only with --sync-with-cloud.

  The file holds API keys and decides where every later command goes, for every
  process that reads it: an agent runs this only when the human asked for it
  explicitly.

EXAMPLES
  $ meili config update --project prod --sync-with-cloud

  $ meili config update --project prod --project-api-key - < key.txt

  $ meili config update --project local --project-url http://localhost:7701 --output json

"
`;

exports[`meili config update > refreshes the cloud identifiers of the entry's cloud.id, keeps its key and its URL, and warns on a URL the Cloud does not give 1`] = `
{
  "exitCode": 0,
  "stderr": "{"warning":{"code":"cli_config","type":"cli","message":"The URL of \`prod\`, https://elsewhere.example.com, is not the URL Meilisearch Cloud gives for project 343, https://ms-abc.sfo.meilisearch.io. The entry keeps its URL."}}
",
  "stdout": "",
}
`;
