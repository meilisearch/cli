// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili config list > prints its help without any network call 1`] = `
"List the projects of the config file.

USAGE
  $ meili config list [--json] [--no-color] [--debug]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  --debug  Print every HTTP request and response on stderr, secrets redacted.

DESCRIPTION
  List the projects of the config file.

  Prints the path of the file and its projects as JSON, keys masked.

EXAMPLES
  $ meili config list

  MEILI_CONFIG=./meili.json meili config list

"
`;
