// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili config add > prints its help without any network call 1`] = `
"Add a project to the config file, creating it owner-only; refuses a name that exists.

USAGE
  $ meili config add --project <name> --project-url <url> [-o <mode>]
    [--debug] [--project-api-key <key>]

FLAGS
  -o, --output=<mode>          json (default): one document, the API body as it
                               is, indented in a terminal, compact when piped.
                               ndjson: one item per line, list commands only,
                               streams with --all.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --project=<name>         (required) Name of the project to add.
      --project-api-key=<key>  API key of the project. \`-\` reads it from stdin,
                               out of the shell history.
      --project-url=<url>      (required) URL of the project.

DESCRIPTION
  Add a project to the config file, creating it owner-only; refuses a name that
  exists.

  The file holds API keys and decides where every later command goes, for every
  process that reads it: an agent runs this only when the human asked for it
  explicitly.

EXAMPLES
  $ meili config add --project local --project-url http://localhost:7700

  $ meili config add --project prod --project-url https://ms-abc.sfo.meilisearch.io --project-api-key - < key.txt

  $ meili config add --project local --project-url http://localhost:7700 --output json

"
`;
