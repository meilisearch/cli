// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili batch view > passes the 404 of an unknown batch through and exits 4 1`] = `
{
  "exitCode": 4,
  "stderr": "{"error":{"code":"batch_not_found","type":"invalid_request","message":"Batch \`99\` not found.","link":"https://docs.meilisearch.com/errors#batch_not_found"}}
",
  "stdout": "",
}
`;

exports[`meili batch view > prints its help without any network call 1`] = `
"Get one batch of tasks.

USAGE
  $ meili batch view --id <uid> [-o <mode>] [--debug] [--project-url
    <url>] [--project-api-key <key>] [--project <name>]

FLAGS
  -o, --output=<mode>          json (default): one document, the API body as it
                               is, indented in a terminal, compact when piped.
                               ndjson: one item per line, only for the commands
                               that print a list of items, streams with --all.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --id=<uid>               (required) The batch uid.
      --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. One of --project or
                               --project-url is required.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.
                               One of --project or --project-url is required.

DESCRIPTION
  Get one batch of tasks.

EXAMPLES
  $ meili batch view --project prod --id 7

  $ meili batch view --project prod --id 7 --output json

"
`;

exports[`meili batch view > prints the batch as the API returns it, with no list envelope 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"progress":null,"details":{"receivedDocuments":1,"indexedDocuments":1},"stats":{"totalNbTasks":1,"status":{"succeeded":1},"types":{"documentAdditionOrUpdate":1},"indexUids":{"movies":1}},"duration":"PT0.001S","startedAt":"2026-09-24T10:00:00.000000Z","finishedAt":"2026-09-24T10:00:00.001000Z","batchStrategy":"batched all enqueued tasks","uid":7}
",
}
`;
