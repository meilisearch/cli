// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili auth status > prints its help without any network call 1`] = `
"Show the Meilisearch Cloud session.

USAGE
  $ meili auth status [-o <mode>] [--debug]

FLAGS
  -o, --output=<mode>  json (default): one document, the API body as it is,
                       indented in a terminal, compact when piped. ndjson: one
                       item per line, only for the commands that print a list of
                       items, streams with --all.
      --debug          Print every HTTP request and response on stderr, secrets
                       redacted.

DESCRIPTION
  Show the Meilisearch Cloud session.

  Says whether a session of \`auth login\` exists, whether the authorization
  server still accepts it, and who it logs in.

EXAMPLES
  $ meili auth status

  $ meili auth status --output json

"
`;
