// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili auth logout > prints its help without any network call 1`] = `
"Log out of Meilisearch Cloud.

USAGE
  $ meili auth logout [-o <mode>] [--debug]

FLAGS
  -o, --output=<mode>  json (default): one document, the API body as it is,
                       indented in a terminal, compact when piped. ndjson: one
                       item per line, only for the commands that print a list of
                       items, streams with --all.
      --debug          Print every HTTP request and response on stderr, secrets
                       redacted.

DESCRIPTION
  Log out of Meilisearch Cloud.

  Revokes the token of \`auth login\` and forgets it. Does nothing when nobody is
  logged in.

EXAMPLES
  $ meili auth logout

  $ meili auth logout --output json

"
`;
