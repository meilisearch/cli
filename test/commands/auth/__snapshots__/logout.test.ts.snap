// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili auth logout > prints its help without any network call 1`] = `
"Revoke the token of \`auth login\` and forget it. Does nothing when nobody is logged in.

USAGE
  $ meili auth logout [-o <mode>] [--debug]

FLAGS
  -o, --output=<mode>  json (default): one document, the API body as it is,
                       indented in a terminal, compact when piped. ndjson: one
                       item per line, list commands only, streams with --all.
      --debug          Print every HTTP request and response on stderr, secrets
                       redacted.

DESCRIPTION
  Revoke the token of \`auth login\` and forget it. Does nothing when nobody is
  logged in.

EXAMPLES
  $ meili auth logout

  $ meili auth logout --output json

"
`;
