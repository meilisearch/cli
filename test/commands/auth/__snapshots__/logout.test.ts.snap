// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili auth logout > prints its help without any network call 1`] = `
"Log out of Meilisearch Cloud.

USAGE
  $ meili auth logout [--json] [--no-color] [--debug]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  --debug  Print every HTTP request and response on stderr, secrets redacted.

DESCRIPTION
  Log out of Meilisearch Cloud.

  Revokes the token of \`auth login\` and forgets it. Does nothing when nobody is
  logged in.

EXAMPLES
  $ meili auth logout

"
`;
