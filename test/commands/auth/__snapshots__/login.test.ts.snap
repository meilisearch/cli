// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili auth login > prints its help without any network call 1`] = `
"Log in to Meilisearch Cloud in a browser.

USAGE
  $ meili auth login [-o <mode>] [--debug] [--browser]

FLAGS
  -o, --output=<mode>  json (default): one document, the API body as it is,
                       indented in a terminal, compact when piped. ndjson: one
                       item per line, only for the commands that print a list of
                       items, streams with --all.
      --[no-]browser   Open the consent page in a browser. --no-browser only
                       prints the URL.
      --debug          Print every HTTP request and response on stderr, secrets
                       redacted.

DESCRIPTION
  Log in to Meilisearch Cloud in a browser.

  Stores the token for the management commands.

EXAMPLES
  $ meili auth login

  $ meili auth login --output json

  $ meili auth login --no-browser

"
`;
