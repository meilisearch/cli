// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili auth refresh > prints its help without any network call 1`] = `
"Trade the refresh token of the stored session for a new access token, before it expires.

USAGE
  $ meili auth refresh [--project-url <url>] [--project-api-key <key>]
    [--project <name>] [-o <mode>] [--debug]

FLAGS
  -o, --output=<mode>          json (default): one document, the API body as it
                               is, indented in a terminal, compact when piped.
                               ndjson: one item per line, list commands only,
                               streams with --all.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. Required when the file has
                               several projects.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.

DESCRIPTION
  Trade the refresh token of the stored session for a new access token, before
  it expires.

EXAMPLES
  $ meili auth refresh

  $ meili auth refresh --output json

"
`;
