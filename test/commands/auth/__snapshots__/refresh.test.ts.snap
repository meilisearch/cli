exports[`meili auth refresh > prints its help without any network call 1`] = `
"Refresh the Meilisearch Cloud session.

USAGE
  $ meili auth refresh [--debug]

FLAGS
  --debug  Print every HTTP request and response on stderr, secrets redacted.

DESCRIPTION
  Refresh the Meilisearch Cloud session.

  Trades the refresh token of the stored session for a new access token, before
  it expires.

EXAMPLES
  $ meili auth refresh

"
`;
