// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili delete keys > passes an authentication error through with a hint and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\` or \`MEILI_PROJECT_API_KEY\`."}}
",
  "stdout": "",
}
`;

exports[`meili delete keys > prints its help without any network call 1`] = `
"Delete an API key, which stops authenticating every request that carries it.

USAGE
  $ meili delete keys --id <key> --yes [-o <mode>] [--debug]
    [--project-url <url>] [--project-api-key <key>] [--project <name>]

FLAGS
  -o, --output=<mode>          json (default): one document, the API body as it
                               is, indented in a terminal, compact when piped.
                               ndjson: one item per line, list commands only,
                               streams with --all.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --id=<key>               (required) The key to delete, by its uid or by
                               its key value.
      --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. Required when the file has
                               several projects.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.
      --yes                    (required) Confirm the deletion. Nothing is sent
                               to the API without it.

DESCRIPTION
  Delete an API key, which stops authenticating every request that carries it.

EXAMPLES
  $ meili delete keys --id 52787ccd-48ff-48e5-9c4b-03cd76978a60 --yes

  $ meili delete keys --id 52787ccd-48ff-48e5-9c4b-03cd76978a60 --yes --output json

"
`;

exports[`meili delete keys > writes nothing on stdout and exits 0, the route answering 204 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "",
}
`;
