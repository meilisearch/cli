// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili delete organizations > passes the API's error body through when the organization has projects, with exit 1 1`] = `
{
  "exitCode": 1,
  "stderr": "{"error":{"code":"organization_has_projects","type":"invalid_request","message":"The organization still has projects. Delete them first.","link":"https://www.meilisearch.com/docs/reference/errors#organization_has_projects"}}
",
  "stdout": "",
}
`;

exports[`meili delete organizations > prints its help without any network call 1`] = `
"Delete a Meilisearch Cloud organization. Prints nothing on success.

USAGE
  $ meili delete organizations --id <id> --yes [-o <mode>] [--debug]

FLAGS
  -o, --output=<mode>  json (default): one document, the API body as it is,
                       indented in a terminal, compact when piped. ndjson: one
                       item per line, list commands only, streams with --all.
      --debug          Print every HTTP request and response on stderr, secrets
                       redacted.
      --id=<id>        (required) The organization to delete.
      --yes            (required) Confirm the deletion. Nothing is sent to the
                       API without it.

DESCRIPTION
  Delete a Meilisearch Cloud organization. Prints nothing on success.

EXAMPLES
  $ meili delete organizations --id 7 --yes

  $ meili delete organizations --id 7 --yes --output json

"
`;
