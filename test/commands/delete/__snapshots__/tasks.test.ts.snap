// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili delete tasks > passes an authentication error through with a hint and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\` or \`MEILI_PROJECT_API_KEY\`."}}
",
  "stdout": "",
}
`;

exports[`meili delete tasks > prints its help without any network call 1`] = `
"Delete the finished tasks matched by --ids, --statuses, --types and the other filters of the route.

USAGE
  $ meili delete tasks --yes [-o <mode>] [--debug] [--project-url <url>]
    [--project-api-key <key>] [--project <name>] [--ids <uids>] [--batch-ids
    <uids>] [--index-ids <indexes>] [--canceled-by <uids>] [--types <types>]
    [--statuses <statuses>] [--after-enqueued-at <date>] [--before-enqueued-at
    <date>] [--after-started-at <date>] [--before-started-at <date>]
    [--after-finished-at <date>] [--before-finished-at <date>] [--timeout
    <duration> --wait]

FLAGS
  -o, --output=<mode>              json (default): one document, the API body as
                                   it is, indented in a terminal, compact when
                                   piped. ndjson: one item per line, list
                                   commands only, streams with --all.
      --after-enqueued-at=<date>   Match the tasks enqueued after this date, in
                                   RFC 3339 format.
      --after-finished-at=<date>   Match the tasks finished after this date, in
                                   RFC 3339 format.
      --after-started-at=<date>    Match the tasks started after this date, in
                                   RFC 3339 format.
      --batch-ids=<uids>           Match the tasks of these batch uids,
                                   comma-separated. \`*\` matches every one.
      --before-enqueued-at=<date>  Match the tasks enqueued before this date, in
                                   RFC 3339 format.
      --before-finished-at=<date>  Match the tasks finished before this date, in
                                   RFC 3339 format.
      --before-started-at=<date>   Match the tasks started before this date, in
                                   RFC 3339 format.
      --canceled-by=<uids>         Match the tasks canceled by these
                                   taskCancelation uids, comma-separated. \`*\`
                                   matches every one.
      --debug                      Print every HTTP request and response on
                                   stderr, secrets redacted.
      --ids=<uids>                 Task uids to match, comma-separated. \`*\`
                                   matches every one.
      --index-ids=<indexes>        Match the tasks of these indexes,
                                   comma-separated. \`*\` matches every one.
      --project=<name>             A project of the config file. Cannot be
                                   combined with --project-url. Required when
                                   the file has several projects.
      --project-api-key=<key>      Project API key. \`-\` reads it from stdin.
      --project-url=<url>          Project URL, the Meilisearch instance to talk
                                   to.
      --statuses=<statuses>        Task statuses to match, comma-separated:
                                   enqueued, processing, succeeded, failed or
                                   canceled. \`*\` matches every one.
      --timeout=<duration>         Maximum wait time, for example 30s, 2m.
                                   Default 60s. Only with --wait.
      --types=<types>              Task types to match, comma-separated, as the
                                   \`type\` field of a task spells them, for
                                   example \`documentAdditionOrUpdate\`. \`*\`
                                   matches every one.
      --wait                       Poll the task until it reaches a final
                                   status, then print the final task.
      --yes                        (required) Confirm the deletion. Nothing is
                                   sent to the API without it.

DESCRIPTION
  Delete the finished tasks matched by --ids, --statuses, --types and the other
  filters of the route.

EXAMPLES
  $ meili delete tasks --ids 42,1344 --yes

  $ meili delete tasks --ids 42 --yes --output json

  $ meili delete tasks --statuses succeeded --before-enqueued-at 2026-01-01T00:00:00Z --yes

  $ meili delete tasks --index-ids movies --yes --wait

"
`;

exports[`meili delete tasks > prints the enqueued task as the API returned it, without waiting 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":8,"indexUid":null,"status":"enqueued","type":"taskDeletion","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;

exports[`meili delete tasks > refuses to run without a filter, before any network call 1`] = `
{
  "exitCode": 2,
  "stderr": "{"error":{"code":"cli_usage","type":"cli","message":"The tasks to delete are missing.","hint":"Name them with \`--ids <uids>\`, or match them with \`--statuses <statuses>\`, \`--types <types>\`, \`--index-ids <indexes>\` or a date filter such as \`--before-enqueued-at <date>\`."}}
",
  "stdout": "",
}
`;
