// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili delete documents > passes an authentication error through with a hint and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\` or \`MEILI_PROJECT_API_KEY\`."}}
",
  "stdout": "",
}
`;

exports[`meili delete documents > prints its help without any network call 1`] = `
"Delete the documents of an index named by --ids, matched by --filter, or every one of them with --all.

USAGE
  $ meili delete documents --index <index> --yes [-o <mode>] [--debug]
    [--project-url <url>] [--project-api-key <key>] [--project <name>] [--ids
    <ids> | --filter <filter> | --all] [--custom-metadata <string>] [--file
    <path> | --data <json>] [--timeout <duration> --wait]

FLAGS
  -o, --output=<mode>             json (default): one document, the API body as
                                  it is, indented in a terminal, compact when
                                  piped. ndjson: one item per line, list
                                  commands only, streams with --all.
      --all                       Delete every document of the index.
      --custom-metadata=<string>  String attached to the task, returned in the
                                  task object.
      --data=<json>               Inline JSON body.
      --debug                     Print every HTTP request and response on
                                  stderr, secrets redacted.
      --file=<path>               Read the body from a file. \`-\` reads from
                                  stdin.
      --filter=<filter>           Delete the documents matching this filter
                                  expression, for example \`rating < 2\`.
      --ids=<ids>                 Document identifiers to delete,
                                  comma-separated.
      --index=<index>             (required) The index to delete the documents
                                  from.
      --project=<name>            A project of the config file. Cannot be
                                  combined with --project-url. Required when the
                                  file has several projects.
      --project-api-key=<key>     Project API key. \`-\` reads it from stdin.
      --project-url=<url>         Project URL, the Meilisearch instance to talk
                                  to.
      --timeout=<duration>        Maximum wait time, for example 30s, 2m.
                                  Default 60s. Only with --wait.
      --wait                      Poll the task until it reaches a final status,
                                  then print the final task.
      --yes                       (required) Confirm the deletion. Nothing is
                                  sent to the API without it.

DESCRIPTION
  Delete the documents of an index named by --ids, matched by --filter, or every
  one of them with --all.

EXAMPLES
  $ meili delete documents --index movies --ids 42,1344 --yes

  $ meili delete documents --index movies --ids 42 --yes --output json

  $ meili delete documents --index movies --filter 'rating < 2' --yes

  $ meili delete documents --index movies --file ids.json --yes

  $ meili delete documents --index movies --all --yes --wait

"
`;

exports[`meili delete documents > takes the delete route with --filter, and prints the task it answered 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":43,"indexUid":"movies","status":"enqueued","type":"documentDeletion","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;

