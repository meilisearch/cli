exports[`meili delete documents > takes the route that deletes every document with --all, and prints the task it answered 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":44,"indexUid":"movies","status":"enqueued","type":"documentDeletion","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;
