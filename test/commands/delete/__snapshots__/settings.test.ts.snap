// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili delete settings > passes an authentication error through with a hint and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\` or \`MEILI_PROJECT_API_KEY\`."}}
",
  "stdout": "",
}
`;

exports[`meili delete settings > prints its help without any network call 1`] = `
"Reset every setting of an index to its default value, which reindexes the documents.

USAGE
  $ meili delete settings --index <index> --yes [-o <mode>] [--debug]
    [--project-url <url>] [--project-api-key <key>] [--project <name>]
    [--timeout <duration> --wait]

FLAGS
  -o, --output=<mode>          json (default): one document, the API body as it
                               is, indented in a terminal, compact when piped.
                               ndjson: one item per line, list commands only,
                               streams with --all.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --index=<index>          (required) The index to reset the settings of.
                               \`update settings --<setting> null\` resets one of
                               them.
      --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. Required when the file has
                               several projects.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.
      --timeout=<duration>     Maximum wait time, for example 30s, 2m. Default
                               60s. Only with --wait.
      --wait                   Poll the task until it reaches a final status,
                               then print the final task.
      --yes                    (required) Confirm the deletion. Nothing is sent
                               to the API without it.

DESCRIPTION
  Reset every setting of an index to its default value, which reindexes the
  documents.

EXAMPLES
  $ meili delete settings --index movies --yes

  $ meili delete settings --index movies --yes --output json

  $ meili delete settings --index movies --yes --wait

"
`;

exports[`meili delete settings > prints the enqueued task as the API returned it, without waiting 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":15,"indexUid":"movies","status":"enqueued","type":"settingsUpdate","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;
