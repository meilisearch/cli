// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili organization update > passes the API's error body through on a 403, with exit 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"project_not_accessible","type":"auth","message":"You cannot access this project.","link":"https://www.meilisearch.com/docs/reference/errors#project_not_accessible"}}
",
  "stdout": "",
}
`;

exports[`meili organization update > prints its help without any network call 1`] = `
"Rename a Meilisearch Cloud organization.

USAGE
  $ meili organization update --id <id> [--debug] [--name <name>] [--file <path>
    | --data <json>]

FLAGS
  --data=<json>  Inline JSON body.
  --debug        Print every HTTP request and response on stderr, secrets
                 redacted.
  --file=<path>  Read the body from a file. \`-\` reads from stdin.
  --id=<id>      (required) The organization to update.
  --name=<name>  New name of the organization.

DESCRIPTION
  Rename a Meilisearch Cloud organization.

EXAMPLES
  $ meili organization update --id 7 --name Acme

  $ meili organization update --id 7 --data '{"name":"Acme"}'

"
`;

exports[`meili organization update > sends the new name for the organization of --id, and prints the organization updated 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"id":1,"name":"Renamed","identifier":"acme","ownerId":"user-1","isAdmin":true,"defaultTeamId":12,"customerTier":null}
",
}
`;
