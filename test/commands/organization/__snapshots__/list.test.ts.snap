exports[`meili organization list > exits 6 on a 401 without a body 1`] = `
{
  "exitCode": 6,
  "stderr": "{"error":{"code":"cli_network","type":"cli","message":"The server at https://management.test/api/v2/organizations answered HTTP 401 without a Management API error body."}}
",
  "stdout": "",
}
`;

exports[`meili organization list > lists the organizations in the envelope the API returns 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"offset":0,"limit":20,"total":2,"results":[{"id":1,"name":"Acme","identifier":"acme","ownerId":"user-1","isAdmin":true},{"id":2,"name":"Beta","identifier":"beta","ownerId":"user-1","isAdmin":false}]}
",
}
`;

exports[`meili organization list > prints a table for a human in a terminal, isAdmin in place of ownerId 1`] = `
{
  "exitCode": 0,
  "stderr": "Showing 2 of 2
offset 0 • limit 20

",
  "stdout": "ID  NAME  IDENTIFIER  IS_ADMIN
1   Acme  acme        true
2   Beta  beta        false
",
}
`;

exports[`meili organization list > prints its help without any network call 1`] = `
"List the Meilisearch Cloud organizations.

USAGE
  $ meili organization list [--json] [--no-color] [--debug] [--limit <n>]
    [--offset <n>] [--all]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  --all         Fetch every page, and print them as one list.
  --debug       Print every HTTP request and response on stderr, secrets
                redacted.
  --limit=<n>   Passed to the API.
  --offset=<n>  Passed to the API.

DESCRIPTION
  List the Meilisearch Cloud organizations.

  Only the organizations the token sees.

EXAMPLES
  $ meili organization list

"
`;
