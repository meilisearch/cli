// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili organization delete > passes the API's error body through when the organization has projects, with exit 1 1`] = `
{
  "exitCode": 1,
  "stderr": "{"error":{"code":"organization_has_projects","type":"invalid_request","message":"The organization still has projects. Delete them first.","link":"https://www.meilisearch.com/docs/reference/errors#organization_has_projects"}}
",
  "stdout": "",
}
`;

exports[`meili organization delete > prints its help without any network call 1`] = `
"Delete a Meilisearch Cloud organization.

USAGE
  $ meili organization delete --id <id> --yes [--debug]

FLAGS
  --debug    Print every HTTP request and response on stderr, secrets redacted.
  --id=<id>  (required) The organization to delete.
  --yes      (required) Confirm the deletion. Nothing is sent to the API without
             it.

DESCRIPTION
  Delete a Meilisearch Cloud organization.

  Prints nothing on success.

EXAMPLES
  $ meili organization delete --id 7 --yes

"
`;
