// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili organization view > gets one organization with --id 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"id":2,"name":"Beta","identifier":"beta","ownerId":"user-1","isAdmin":false,"defaultTeamId":12,"customerTier":null}
",
}
`;

exports[`meili organization view > passes the API's error body through on an organization it does not show, with exit 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"project_not_accessible","type":"auth","message":"You cannot access this project.","link":"https://www.meilisearch.com/docs/reference/errors#project_not_accessible"}}
",
  "stdout": "",
}
`;

exports[`meili organization view > prints its help without any network call 1`] = `
"Get one Meilisearch Cloud organization.

USAGE
  $ meili organization view --id <id> [-o <mode>] [--debug]

FLAGS
  -o, --output=<mode>  json (default): one document, the API body as it is,
                       indented in a terminal, compact when piped. ndjson: one
                       item per line, only for the commands that print a list of
                       items, streams with --all.
      --debug          Print every HTTP request and response on stderr, secrets
                       redacted.
      --id=<id>        (required) The organization to get.

DESCRIPTION
  Get one Meilisearch Cloud organization.

EXAMPLES
  $ meili organization view --id 7

  $ meili organization view --id 7 --output json

"
`;
