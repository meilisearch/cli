// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili organization view > gets one organization with --id 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"id":2,"name":"Beta","identifier":"beta","ownerId":"user-1","isAdmin":false}
",
}
`;

exports[`meili organization view > passes the API's error body through on an organization it does not show, with exit 4 1`] = `
{
  "exitCode": 4,
  "stderr": "{"error":{"code":"organization_not_found","type":"invalid_request","message":"Organization not found.","link":"https://www.meilisearch.com/docs/reference/errors#organization_not_found"}}
",
  "stdout": "",
}
`;

exports[`meili organization view > prints a summary, then every attribute, for a human in a terminal 1`] = `
{
  "exitCode": 0,
  "stderr": "Beta
Organization 2 (beta)

",
  "stdout": "  id          2
  name        Beta
  identifier  beta
  ownerId     user-1
  isAdmin     false
",
}
`;

exports[`meili organization view > prints its help without any network call 1`] = `
"Get one Meilisearch Cloud organization.

USAGE
  $ meili organization view --id <id> [--json] [--no-color] [--debug]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  --debug    Print every HTTP request and response on stderr, secrets redacted.
  --id=<id>  (required) The organization to get.

DESCRIPTION
  Get one Meilisearch Cloud organization.

EXAMPLES
  $ meili organization view --id 7

"
`;
