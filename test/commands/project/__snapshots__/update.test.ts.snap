// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili project update > passes the API's error body through on a 403, with exit 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"project_not_accessible","type":"auth","message":"You cannot access this project.","link":"https://www.meilisearch.com/docs/reference/errors#project_not_accessible"}}
",
  "stdout": "",
}
`;

exports[`meili project update > prints its help without any network call 1`] = `
"Rename a Meilisearch Cloud project.

USAGE
  $ meili project update [--debug] [--project <name>] [--id <id>] [--name
    <name>] [--sync-config] [--file <path> | --data <json>]

FLAGS
  --data=<json>     Inline JSON body.
  --debug           Print every HTTP request and response on stderr, secrets
                    redacted.
  --file=<path>     Read the body from a file. \`-\` reads from stdin.
  --id=<id>         The project to update, or give --project <name> and its
                    cloud.id from the config file.
  --name=<name>     New name of the project.
  --project=<name>  A project of the config file, whose cloud.id names the Cloud
                    project, in place of --id.
  --sync-config     Rename the project's entry of the config file after it: the
                    entry --project names, or the one whose cloud.id is --id.
                    Refreshes its cloud identifiers.

DESCRIPTION
  Rename a Meilisearch Cloud project.

EXAMPLES
  $ meili project update --id 343 --name renamed

  $ meili project update --project prod --name renamed

  $ meili project update --project prod --name renamed --sync-config

  $ meili project update --id 343 --data '{"name":"renamed"}'

"
`;

exports[`meili project update > sends the new name for the project of --id, and prints the project updated 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"id":343,"name":"renamed","projectUid":"ms-abc","url":"https://ms-abc.sfo.meilisearch.io","masterKey":"projectmasterkey9z8y","teamId":12,"resourceId":3,"msVersion":"v1.54.0","workloadType":"production","readOnly":false,"status":"running","paused":false,"createdAt":"2026-10-14T10:00:00Z","resource":{"id":3,"name":"build","plan":"build","regionId":1}}
",
}
`;
