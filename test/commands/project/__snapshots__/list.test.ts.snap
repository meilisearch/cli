exports[`meili project list > prints a table for a human in a terminal, and says what to do when there is no project 2`] = `
{
  "exitCode": 0,
  "stderr": "No projects yet. Create one: meili project add --name <name> --team-id <id> --resource-id <id>
Find the ids with meili team list and meili resource list.
",
  "stdout": "",
}
`;

exports[`meili project list > prints its help without any network call 1`] = `
"List the Meilisearch Cloud projects.

USAGE
  $ meili project list [--json] [--no-color] [--debug] [--team-id <id>]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  --debug         Print every HTTP request and response on stderr, secrets
                  redacted.
  --team-id=<id>  Only the projects of this team.

DESCRIPTION
  List the Meilisearch Cloud projects.

  Only the projects the token sees.

EXAMPLES
  $ meili project list

  $ meili project list --team-id 12

"
`;
