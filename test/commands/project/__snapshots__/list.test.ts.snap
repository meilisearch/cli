exports[`meili project list > prints its help without any network call 1`] = `
"List the Meilisearch Cloud projects.

USAGE
  $ meili project list [--debug] [--team-id <id>]

FLAGS
  --debug         Print every HTTP request and response on stderr, secrets
                  redacted.
  --team-id=<id>  Only the projects of this team.

DESCRIPTION
  List the Meilisearch Cloud projects.

  Only the projects the token sees.

EXAMPLES
  $ meili project list

  $ meili project list --team-id 12

"
`;
