// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili index add > passes an authentication error through with a hint and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\`."}}
",
  "stdout": "",
}
`;

exports[`meili index add > prints its help without any network call 1`] = `
"Create an index.

USAGE
  $ meili index add --id <index> [--debug] [--project-url <url>]
    [--project-api-key <key>] [-p <name>] [--primary-key <field>] [--file <path>
    | --data <json>] [--timeout <duration> --wait]

FLAGS
  -p, --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. One of --project or
                               --project-url is required.
      --data=<json>            Inline JSON body.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --file=<path>            Read the body from a file. \`-\` reads from stdin.
      --id=<index>             (required) The index to create.
      --primary-key=<field>    The field that holds the identifier of each
                               document. Without it, Meilisearch infers it from
                               the first documents.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.
                               One of --project or --project-url is required.
      --timeout=<duration>     Maximum wait time, for example 30s, 2m. Default
                               10m. Only with --wait.
      --wait                   Poll the task until it reaches a final status,
                               then print the final task.

DESCRIPTION
  Create an index.

  --id names it, and --primary-key sets its primary key.

EXAMPLES
  $ meili index add --project prod --id movies

  $ meili index add -p prod --id movies --primary-key id

  $ meili index add -p prod --id movies --wait

"
`;

exports[`meili index add > prints the enqueued task as the API returned it, without waiting 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":11,"indexUid":"movies","status":"enqueued","type":"indexCreation","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;
