// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili index list > passes an authentication error through with a hint and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\`."}}
",
  "stdout": "",
}
`;

exports[`meili index list > prints its help without any network call 1`] = `
"List the indexes of the instance.

USAGE
  $ meili index list [-o <mode>] [--debug] [--project-url <url>]
    [--project-api-key <key>] [--project <name>] [--limit <n>] [--offset <n>]
    [--all]

FLAGS
  -o, --output=<mode>          json (default): one document, the API body as it
                               is, indented in a terminal, compact when piped.
                               ndjson: one item per line, only for the commands
                               that print a list of items, streams with --all.
      --all                    Fetch every page. Streams with ndjson, buffers
                               into one array with json.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --limit=<n>              Passed to the API.
      --offset=<n>             Passed to the API.
      --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. One of --project or
                               --project-url is required.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.
                               One of --project or --project-url is required.

DESCRIPTION
  List the indexes of the instance.

EXAMPLES
  $ meili index list --project prod

  $ meili index list --project prod --output json

  $ meili index list --project prod --limit 5 --offset 10

  $ meili index list --project prod --all --output ndjson

"
`;

exports[`meili index list > prints the API envelope as it is in JSON 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"results":[{"uid":"movies","primaryKey":"id","createdAt":"2026-09-24T10:00:00.000000Z","updatedAt":"2026-09-24T10:00:00.000000Z"},{"uid":"books","primaryKey":"isbn","createdAt":"2026-09-24T10:00:00.000000Z","updatedAt":"2026-09-24T10:00:00.000000Z"},{"uid":"songs","createdAt":"2026-09-24T10:00:00.000000Z","updatedAt":"2026-09-24T10:00:00.000000Z"}],"offset":0,"limit":20,"total":3}
",
}
`;
