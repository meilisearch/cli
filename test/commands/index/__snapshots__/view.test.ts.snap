// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili index view > gets one index with --id, as the API returns it 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"uid":"books","primaryKey":"isbn","createdAt":"2026-09-24T10:00:00.000000Z","updatedAt":"2026-09-24T10:00:00.000000Z"}
",
}
`;

exports[`meili index view > passes the 404 of an unknown --id through and exits 4 1`] = `
{
  "exitCode": 4,
  "stderr": "{"error":{"code":"index_not_found","type":"invalid_request","message":"Index \`nope\` not found.","link":"https://docs.meilisearch.com/errors#index_not_found"}}
",
  "stdout": "",
}
`;

exports[`meili index view > prints its help without any network call 1`] = `
"Get one index.

USAGE
  $ meili index view --id <index> [--debug] [--project-url <url>]
    [--project-api-key <key>] [--project <name>]

FLAGS
  --debug                  Print every HTTP request and response on stderr,
                           secrets redacted.
  --id=<index>             (required) The index to get.
  --project=<name>         A project of the config file. Cannot be combined with
                           --project-url. One of --project or --project-url is
                           required.
  --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
  --project-url=<url>      Project URL, the Meilisearch instance to talk to. One
                           of --project or --project-url is required.

DESCRIPTION
  Get one index.

EXAMPLES
  $ meili index view --project prod --id movies

"
`;
