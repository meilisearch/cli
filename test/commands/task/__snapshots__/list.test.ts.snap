// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili task list > passes an authentication error through with a hint and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\`."}}
",
  "stdout": "",
}
`;

exports[`meili task list > prints its help without any network call 1`] = `
"List the tasks of the instance.

USAGE
  $ meili task list [--json] [--no-color] [--debug] [--project-url
    <url>] [--project-api-key <key>] [-p <name>] [--ids <uids>] [--batch-ids
    <uids>] [--index-ids <indexes>] [--canceled-by <uids>] [--types <types>]
    [--statuses <statuses>] [--after-enqueued-at <date>] [--before-enqueued-at
    <date>] [--after-started-at <date>] [--before-started-at <date>]
    [--after-finished-at <date>] [--before-finished-at <date>] [--reverse]
    [--limit <n>] [--from <uid>] [--all]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  -p, --project=<name>             A project of the config file. Cannot be
                                   combined with --project-url. One of --project
                                   or --project-url is required.
      --after-enqueued-at=<date>   Match the tasks enqueued after this date, in
                                   RFC 3339 format.
      --after-finished-at=<date>   Match the tasks finished after this date, in
                                   RFC 3339 format.
      --after-started-at=<date>    Match the tasks started after this date, in
                                   RFC 3339 format.
      --all                        Fetch every page, and print them as one list.
      --batch-ids=<uids>           Match the tasks of these batch uids,
                                   comma-separated. \`*\` matches every one.
      --before-enqueued-at=<date>  Match the tasks enqueued before this date, in
                                   RFC 3339 format.
      --before-finished-at=<date>  Match the tasks finished before this date, in
                                   RFC 3339 format.
      --before-started-at=<date>   Match the tasks started before this date, in
                                   RFC 3339 format.
      --canceled-by=<uids>         Match the tasks canceled by these
                                   taskCancelation uids, comma-separated. \`*\`
                                   matches every one.
      --debug                      Print every HTTP request and response on
                                   stderr, secrets redacted.
      --from=<uid>                 Passed to the API: the uid the page starts
                                   at, going down.
      --ids=<uids>                 Task uids to match, comma-separated. \`*\`
                                   matches every one.
      --index-ids=<indexes>        Match the tasks of these indexes,
                                   comma-separated. \`*\` matches every one.
      --limit=<n>                  Passed to the API.
      --project-api-key=<key>      Project API key. \`-\` reads it from stdin.
      --project-url=<url>          Project URL, the Meilisearch instance to talk
                                   to. One of --project or --project-url is
                                   required.
      --reverse                    Return the tasks from the oldest uid up,
                                   instead of the newest down.
      --statuses=<statuses>        Task statuses to match, comma-separated:
                                   enqueued, processing, succeeded, failed or
                                   canceled. \`*\` matches every one.
      --types=<types>              Task types to match, comma-separated, as the
                                   \`type\` field of a task spells them, for
                                   example \`documentAdditionOrUpdate\`. \`*\`
                                   matches every one.

DESCRIPTION
  List the tasks of the instance.

  --ids, --statuses, --types and the other filters of the route narrow the list.

EXAMPLES
  $ meili task list --project prod

  $ meili task list -p prod --ids 42

  $ meili task list -p prod --statuses failed,canceled --limit 5

  $ meili task list -p prod --index-ids movies --types documentAdditionOrUpdate

"
`;

exports[`meili task list > prints the API envelope as it is in JSON 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"results":[{"indexUid":"movies","type":"indexCreation","enqueuedAt":"2026-09-24T10:00:00Z","startedAt":null,"finishedAt":null,"duration":null,"batchUid":null,"canceledBy":null,"uid":5,"status":"enqueued"},{"indexUid":"movies","type":"indexCreation","enqueuedAt":"2026-09-24T10:00:00Z","startedAt":null,"finishedAt":null,"duration":null,"batchUid":null,"canceledBy":null,"uid":4,"status":"enqueued"},{"indexUid":"movies","type":"indexCreation","enqueuedAt":"2026-09-24T10:00:00Z","startedAt":null,"finishedAt":null,"duration":null,"batchUid":null,"canceledBy":null,"uid":3,"status":"succeeded"},{"indexUid":"movies","type":"indexCreation","enqueuedAt":"2026-09-24T10:00:00Z","startedAt":null,"finishedAt":null,"duration":null,"batchUid":null,"canceledBy":null,"uid":2,"status":"succeeded"},{"indexUid":"movies","type":"indexCreation","enqueuedAt":"2026-09-24T10:00:00Z","startedAt":null,"finishedAt":null,"duration":null,"batchUid":null,"canceledBy":null,"uid":1,"status":"succeeded"}],"total":5,"limit":20,"from":5,"next":null}
",
}
`;
