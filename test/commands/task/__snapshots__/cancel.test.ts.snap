// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili task cancel > passes an authentication error through with a hint and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\`."}}
",
  "stdout": "",
}
`;

exports[`meili task cancel > prints its help without any network call 1`] = `
"Cancel tasks.

USAGE
  $ meili task cancel [--json] [--no-color] [--debug] [--project-url
    <url>] [--project-api-key <key>] [-p <name>] [--ids <uids>] [--batch-ids
    <uids>] [--index-ids <indexes>] [--canceled-by <uids>] [--types <types>]
    [--statuses <statuses>] [--after-enqueued-at <date>] [--before-enqueued-at
    <date>] [--after-started-at <date>] [--before-started-at <date>]
    [--after-finished-at <date>] [--before-finished-at <date>] [--timeout
    <duration> --wait]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  -p, --project=<name>             A project of the config file. Cannot be
                                   combined with --project-url. One of --project
                                   or --project-url is required.
      --after-enqueued-at=<date>   Match the tasks enqueued after this date, in
                                   RFC 3339 format.
      --after-finished-at=<date>   Match the tasks finished after this date, in
                                   RFC 3339 format.
      --after-started-at=<date>    Match the tasks started after this date, in
                                   RFC 3339 format.
      --batch-ids=<uids>           Match the tasks of these batch uids,
                                   comma-separated. \`*\` matches every one.
      --before-enqueued-at=<date>  Match the tasks enqueued before this date, in
                                   RFC 3339 format.
      --before-finished-at=<date>  Match the tasks finished before this date, in
                                   RFC 3339 format.
      --before-started-at=<date>   Match the tasks started before this date, in
                                   RFC 3339 format.
      --canceled-by=<uids>         Match the tasks canceled by these
                                   taskCancelation uids, comma-separated. \`*\`
                                   matches every one.
      --debug                      Print every HTTP request and response on
                                   stderr, secrets redacted.
      --ids=<uids>                 Task uids to match, comma-separated. \`*\`
                                   matches every one.
      --index-ids=<indexes>        Match the tasks of these indexes,
                                   comma-separated. \`*\` matches every one.
      --project-api-key=<key>      Project API key. \`-\` reads it from stdin.
      --project-url=<url>          Project URL, the Meilisearch instance to talk
                                   to. One of --project or --project-url is
                                   required.
      --statuses=<statuses>        Task statuses to match, comma-separated:
                                   enqueued, processing, succeeded, failed or
                                   canceled. \`*\` matches every one.
      --timeout=<duration>         Maximum wait time, for example 30s, 2m.
                                   Default 10m. Only with --wait.
      --types=<types>              Task types to match, comma-separated, as the
                                   \`type\` field of a task spells them, for
                                   example \`documentAdditionOrUpdate\`. \`*\`
                                   matches every one.
      --wait                       Poll the task until it reaches a final
                                   status, then print the final task.

DESCRIPTION
  Cancel tasks.

  Cancels the enqueued and processing tasks matched by --ids, --statuses,
  --types and the other filters of the route.

EXAMPLES
  $ meili task cancel --project prod --ids 42,1344

  $ meili task cancel -p prod --ids 42

  $ meili task cancel -p prod --statuses enqueued --index-ids movies

  $ meili task cancel -p prod --statuses processing --wait

"
`;

exports[`meili task cancel > prints the enqueued task as the API returned it, without waiting 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":7,"indexUid":null,"status":"enqueued","type":"taskCancelation","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;

exports[`meili task cancel > tells a human in a terminal what it did 1`] = `
{
  "exitCode": 0,
  "stderr": "◐ Meilisearch received the request. Task 7 will cancel the matching tasks.


They go on until the task succeeds. Follow it: meili task view --id 7
Next time, wait for the end with --wait.
",
  "stdout": "  taskUid     7
  indexUid    null
  status      enqueued
  type        taskCancelation
  enqueuedAt  2026-09-24T10:00:00Z
",
}
`;
