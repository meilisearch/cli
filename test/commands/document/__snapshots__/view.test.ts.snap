// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili document view > passes the 404 of an unknown document through and exits 4 1`] = `
{
  "exitCode": 4,
  "stderr": "{"error":{"code":"document_not_found","type":"invalid_request","message":"Document \`99\` not found.","link":"https://docs.meilisearch.com/errors#document_not_found"}}
",
  "stdout": "",
}
`;

exports[`meili document view > prints its help without any network call 1`] = `
"Get one document of an index.

USAGE
  $ meili document view --index <index> --id <id> [-o <mode>] [--debug]
    [--project-url <url>] [--project-api-key <key>] [--project <name>] [--fields
    <fields>] [--retrieve-vectors]

FLAGS
  -o, --output=<mode>          json (default): one document, the API body as it
                               is, indented in a terminal, compact when piped.
                               ndjson: one item per line, only for the commands
                               that print a list of items, streams with --all.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --fields=<fields>        Document attributes to return, comma-separated.
                               Defaults to all of them.
      --id=<id>                (required) The document identifier.
      --index=<index>          (required) The index to read the document from.
      --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. One of --project or
                               --project-url is required.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.
                               One of --project or --project-url is required.
      --retrieve-vectors       Include the vector embeddings of the document, if
                               it has them.

DESCRIPTION
  Get one document of an index.

EXAMPLES
  $ meili document view --project prod --index movies --id 42

  $ meili document view --project prod --index movies --id 42 --fields id,title --output json

"
`;

exports[`meili document view > prints the document as the API returns it 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"id":2,"title":"Alien","rating":5}
",
}
`;
