exports[`meili document view > passes the 404 of an unknown document through and exits 4 1`] = `
{
  "exitCode": 4,
  "stderr": "{"error":{"code":"document_not_found","type":"invalid_request","message":"Document \`99\` not found.","link":"https://docs.meilisearch.com/errors#document_not_found"}}
",
  "stdout": "",
}
`;

exports[`meili document view > prints every attribute for a human in a terminal, long text wrapped and nested values indented 1`] = `
{
  "exitCode": 0,
  "stderr": "Document 11 in index movies

",
  "stdout": "  id        11
  title     Star Wars
  overview  Princess Leia is captured and held hostage by the evil Imperial
            forces in their effort to take over the galactic Empire.
  genres    Adventure, Action, Science Fiction
  rating    4.8
  sequel    null
  cast
    - name       Mark Hamill
      character  Luke Skywalker
    - name       Harrison Ford
      character  Han Solo
  studio
    name     Lucasfilm
    country  US
",
}
`;

exports[`meili document view > prints its help without any network call 1`] = `
"Get one document of an index.

USAGE
  $ meili document view -i <index> --id <id> [--json] [--no-color]
    [--debug] [--project-url <url>] [--project-api-key <key>] [-p <name>]
    [--fields <fields>] [--retrieve-vectors]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  -i, --index=<index>          (required) The index to read the document from.
  -p, --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. One of --project or
                               --project-url is required.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --fields=<fields>        Document attributes to return, comma-separated.
                               Defaults to all of them.
      --id=<id>                (required) The document identifier.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.
                               One of --project or --project-url is required.
      --retrieve-vectors       Include the vector embeddings of the document, if
                               it has them.

DESCRIPTION
  Get one document of an index.

EXAMPLES
  $ meili document view --project prod --index movies --id 42

  $ meili document view -p prod -i movies --id 42 --fields id,title

"
`;

exports[`meili document view > prints the document as the API returns it 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"id":2,"title":"Alien","rating":5}
",
}
`;
