// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili document update > passes the 404 of an unknown index through and exits 4 1`] = `
{
  "exitCode": 4,
  "stderr": "{"error":{"code":"index_not_found","type":"invalid_request","message":"Index \`nope\` not found.","link":"https://docs.meilisearch.com/errors#index_not_found"}}
",
  "stdout": "",
}
`;

exports[`meili document update > prints its help without any network call 1`] = `
"Add or update documents in an index.

USAGE
  $ meili document update --index <index> [-o <mode>] [--debug]
    [--project-url <url>] [--project-api-key <key>] [--project <name>]
    [--primary-key <field>] [--custom-metadata <string>] [--skip-creation]
    [--file <path> | --data <json>] [--timeout <duration> --wait]

FLAGS
  -o, --output=<mode>             json (default): one document, the API body as
                                  it is, indented in a terminal, compact when
                                  piped. ndjson: one item per line, only for the
                                  commands that print a list of items, streams
                                  with --all.
      --custom-metadata=<string>  String attached to the task, returned in the
                                  task object.
      --data=<json>               Inline JSON body.
      --debug                     Print every HTTP request and response on
                                  stderr, secrets redacted.
      --file=<path>               Read the body from a file. \`-\` reads from
                                  stdin.
      --index=<index>             (required) The index to update the documents
                                  of.
      --primary-key=<field>       Primary key of the index. Only taken into
                                  account on its first documents.
      --project=<name>            A project of the config file. Cannot be
                                  combined with --project-url. One of --project
                                  or --project-url is required.
      --project-api-key=<key>     Project API key. \`-\` reads it from stdin.
      --project-url=<url>         Project URL, the Meilisearch instance to talk
                                  to. One of --project or --project-url is
                                  required.
      --skip-creation             Only update documents that already exist,
                                  ignore the new ones.
      --timeout=<duration>        Maximum wait time, for example 30s, 2m.
                                  Default 10m. Only with --wait.
      --wait                      Poll the task until it reaches a final status,
                                  then print the final task.

DESCRIPTION
  Add or update documents in an index.

  The fields of a document are merged into the one that has the same primary
  key.

EXAMPLES
  $ meili document update --project prod --index movies --file changes.json

  $ meili document update --project prod --index movies --file changes.json --output json

  cat changes.json | meili document update --project prod --index movies --file -

  $ meili document update --project prod --index movies --data '[{"id":1,"rating":4}]'

  $ meili document update --project prod --index movies --file changes.json --wait

"
`;

exports[`meili document update > prints the enqueued task as the API returned it, without waiting 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":42,"indexUid":"movies","status":"enqueued","type":"documentAdditionOrUpdate","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;
