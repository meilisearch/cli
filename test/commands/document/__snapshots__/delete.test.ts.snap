exports[`meili document delete > names the selector for a human in a terminal 1`] = `
{
  "exitCode": 0,
  "stderr": "◐ Task 43 will delete the documents matching rating < 2 in index movies.


They are still there until the task succeeds. Follow it: meili task view --id 43
Next time, wait for the end with --wait.
",
  "stdout": "  Task      43
  Status    enqueued
  Type      documentDeletion
  Index     movies
  Enqueued  2026-09-24T10:00:00Z
",
}
`;

exports[`meili document delete > passes an authentication error through with a hint and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\`."}}
",
  "stdout": "",
}
`;

exports[`meili document delete > prints its help without any network call 1`] = `
"Delete documents from an index.

USAGE
  $ meili document delete -i <index> --yes [--json] [--no-color] [--debug]
    [--project-url <url>] [--project-api-key <key>] [-p <name>] [--ids <ids> |
    --filter <filter> | --all] [--custom-metadata <string>] [--file <path> |
    --data <json>] [--timeout <duration> --wait]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  -i, --index=<index>             (required) The index to delete the documents
                                  from.
  -p, --project=<name>            A project of the config file. Cannot be
                                  combined with --project-url. One of --project
                                  or --project-url is required.
      --all                       Delete every document of the index.
      --custom-metadata=<string>  String attached to the task, returned in the
                                  task object.
      --data=<json>               Inline JSON body.
      --debug                     Print every HTTP request and response on
                                  stderr, secrets redacted.
      --file=<path>               Read the body from a file. \`-\` reads from
                                  stdin.
      --filter=<filter>           Delete the documents matching this filter
                                  expression, for example \`rating < 2\`.
      --ids=<ids>                 Document identifiers to delete,
                                  comma-separated.
      --project-api-key=<key>     Project API key. \`-\` reads it from stdin.
      --project-url=<url>         Project URL, the Meilisearch instance to talk
                                  to. One of --project or --project-url is
                                  required.
      --timeout=<duration>        Maximum wait time, for example 30s, 2m.
                                  Default 10m. Only with --wait.
      --wait                      Poll the task until it reaches a final status,
                                  then print the final task.
      --yes                       (required) Confirm the deletion. Nothing is
                                  sent to the API without it.

DESCRIPTION
  Delete documents from an index.

  Deletes the documents named by --ids, matched by --filter, or every one of
  them with --all.

EXAMPLES
  $ meili document delete --project prod --index movies --ids 42,1344 --yes

  $ meili document delete -p prod -i movies --ids 42 --yes

  $ meili document delete -p prod -i movies --filter 'rating < 2' --yes

  $ meili document delete -p prod -i movies --file ids.json --yes

  $ meili document delete -p prod -i movies --all --yes --wait

"
`;

exports[`meili document delete > takes the delete route with --filter, and prints the task it answered 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":43,"indexUid":"movies","status":"enqueued","type":"documentDeletion","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;

