// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili document delete > passes an authentication error through with a hint and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\`."}}
",
  "stdout": "",
}
`;

exports[`meili document delete > prints its help without any network call 1`] = `
"Delete documents from an index.

USAGE
  $ meili document delete --index <index> --yes [--debug] [--project-url
    <url>] [--project-api-key <key>] [--project <name>] [--ids <ids> | --filter
    <filter> | --all] [--custom-metadata <string>] [--file <path> | --data
    <json>] [--timeout <duration> --wait]

FLAGS
  --all                       Delete every document of the index.
  --custom-metadata=<string>  String attached to the task, returned in the task
                              object.
  --data=<json>               Inline JSON body.
  --debug                     Print every HTTP request and response on stderr,
                              secrets redacted.
  --file=<path>               Read the body from a file. \`-\` reads from stdin.
  --filter=<filter>           Delete the documents matching this filter
                              expression, for example \`rating < 2\`.
  --ids=<ids>                 Document identifiers to delete, comma-separated.
  --index=<index>             (required) The index to delete the documents from.
  --project=<name>            A project of the config file. Cannot be combined
                              with --project-url. One of --project or
                              --project-url is required.
  --project-api-key=<key>     Project API key. \`-\` reads it from stdin.
  --project-url=<url>         Project URL, the Meilisearch instance to talk to.
                              One of --project or --project-url is required.
  --timeout=<duration>        Maximum wait time, for example 30s, 2m. Default
                              10m. Only with --wait.
  --wait                      Poll the task until it reaches a final status,
                              then print the final task.
  --yes                       (required) Confirm the deletion. Nothing is sent
                              to the API without it.

DESCRIPTION
  Delete documents from an index.

  Deletes the documents named by --ids, matched by --filter, or every one of
  them with --all.

EXAMPLES
  $ meili document delete --project prod --index movies --ids 42,1344 --yes

  $ meili document delete --project prod --index movies --ids 42 --yes

  $ meili document delete --project prod --index movies --filter 'rating < 2' --yes

  $ meili document delete --project prod --index movies --file ids.json --yes

  $ meili document delete --project prod --index movies --all --yes --wait

"
`;

exports[`meili document delete > takes the delete route with --filter, and prints the task it answered 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":43,"indexUid":"movies","status":"enqueued","type":"documentDeletion","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;

exports[`meili document delete > takes the delete-batch route with --ids, and prints the task it answered 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":42,"indexUid":"movies","status":"enqueued","type":"documentDeletion","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;

exports[`meili document delete > takes the route that deletes every document with --all, and prints the task it answered 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":44,"indexUid":"movies","status":"enqueued","type":"documentDeletion","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;
