// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili document list > passes an authentication error through with a hint and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\`."}}
",
  "stdout": "",
}
`;

exports[`meili document list > prints its help without any network call 1`] = `
"List the documents of an index.

USAGE
  $ meili document list -i <index> [--debug] [--project-url <url>]
    [--project-api-key <key>] [-p <name>] [--ids <ids>] [--filter <filter>]
    [--fields <fields>] [--sort <sort>] [--retrieve-vectors] [--limit <n>]
    [--offset <n>] [--file <path> | --data <json>]

FLAGS
  -i, --index=<index>          (required) The index to read the documents from.
  -p, --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. One of --project or
                               --project-url is required.
      --data=<json>            Inline JSON body.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --fields=<fields>        Document attributes to return, comma-separated.
                               Defaults to all of them.
      --file=<path>            Read the body from a file. \`-\` reads from stdin.
      --filter=<filter>        Filter expression, for example \`rating > 4\`. Its
                               array-of-arrays form goes through --data.
      --ids=<ids>              Document identifiers to return, comma-separated.
      --limit=<n>              Passed to the API.
      --offset=<n>             Passed to the API.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.
                               One of --project or --project-url is required.
      --retrieve-vectors       Include the vector embeddings of the documents
                               that have them.
      --sort=<sort>            Attributes to sort on, comma-separated, each as
                               \`attribute:asc\` or \`:desc\`.

DESCRIPTION
  List the documents of an index.

  --ids or --filter narrow the list.

EXAMPLES
  $ meili document list --project prod --index movies

  $ meili document list -p prod -i movies --ids 42,1344 --fields id,title

  $ meili document list -p prod -i movies --filter 'rating > 4' --sort rating:desc

"
`;

exports[`meili document list > prints the API envelope as it is in JSON 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"results":[{"id":1,"title":"Nosferatu","rating":4.5},{"id":2,"title":"Alien","rating":5},{"id":3,"title":"Solaris","rating":4}],"offset":0,"limit":20,"total":3}
",
}
`;
