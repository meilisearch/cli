// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili document add > passes the 404 of an unknown index through and exits 4 1`] = `
{
  "exitCode": 4,
  "stderr": "{"error":{"code":"index_not_found","type":"invalid_request","message":"Index \`nope\` not found.","link":"https://docs.meilisearch.com/errors#index_not_found"}}
",
  "stdout": "",
}
`;

exports[`meili document add > prints its help without any network call 1`] = `
"Add or replace documents in an index.

USAGE
  $ meili document add -i <index> [--json] [--no-color] [--debug]
    [--project-url <url>] [--project-api-key <key>] [-p <name>] [--primary-key
    <field>] [--custom-metadata <string>] [--skip-creation] [--file <path> |
    --data <json>] [--timeout <duration> --wait]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  -i, --index=<index>             (required) The index to add the documents to.
  -p, --project=<name>            A project of the config file. Cannot be
                                  combined with --project-url. One of --project
                                  or --project-url is required.
      --custom-metadata=<string>  String attached to the task, returned in the
                                  task object.
      --data=<json>               Inline JSON body.
      --debug                     Print every HTTP request and response on
                                  stderr, secrets redacted.
      --file=<path>               Read the body from a file. \`-\` reads from
                                  stdin.
      --primary-key=<field>       Primary key of the index. Only taken into
                                  account on its first documents.
      --project-api-key=<key>     Project API key. \`-\` reads it from stdin.
      --project-url=<url>         Project URL, the Meilisearch instance to talk
                                  to. One of --project or --project-url is
                                  required.
      --skip-creation             Only update documents that already exist,
                                  ignore the new ones.
      --timeout=<duration>        Maximum wait time, for example 30s, 2m.
                                  Default 10m. Only with --wait.
      --wait                      Poll the task until it reaches a final status,
                                  then print the final task.

DESCRIPTION
  Add or replace documents in an index.

  A document replaces the one that has the same primary key.

EXAMPLES
  $ meili document add --project prod --index movies --file movies.json

  cat movies.json | meili document add -p prod -i movies --file -

  $ meili document add -p prod -i movies --data '[{"id":1,"title":"Nosferatu"}]' --primary-key id

  $ meili document add -p prod -i movies --file movies.json --wait

"
`;

exports[`meili document add > prints the enqueued task as the API returned it, without waiting 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":42,"indexUid":"movies","status":"enqueued","type":"documentAdditionOrUpdate","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;

exports[`meili document add > tells a human in a terminal what the task will do, then what it did with --wait 1`] = `
{
  "exitCode": 0,
  "stderr": "◐ Meilisearch received the documents. Task 42 will add them to index movies.


The new documents are not searchable yet. Follow the task: meili task view --id 42
Next time, wait for the end with --wait.
",
  "stdout": "  taskUid     42
  indexUid    movies
  status      enqueued
  type        documentAdditionOrUpdate
  enqueuedAt  2026-09-24T10:00:00Z
",
}
`;

exports[`meili document add > tells a human in a terminal what the task will do, then what it did with --wait 2`] = `
"  indexUid    movies
  type        documentAdditionOrUpdate
  enqueuedAt  2026-09-24T10:00:00Z
  startedAt   2026-09-24T10:00:00Z
  finishedAt  2026-09-24T10:00:01Z
  duration    PT1.204S
  batchUid    null
  canceledBy  null
  details
    receivedDocuments  2
    indexedDocuments   2
  uid         42
  status      succeeded
"
`;

exports[`meili document add > writes the error of a failed task first for a human, once, and exits 7 1`] = `
{
  "exitCode": 7,
  "stderr": "✗ Task 42 failed: The primary key of index \`movies\` is missing. (index_primary_key_no_candidate_found)
  Docs: https://docs.meilisearch.com/errors#index_primary_key_no_candidate_found

",
  "stdout": "  indexUid    movies
  type        documentAdditionOrUpdate
  enqueuedAt  2026-09-24T10:00:00Z
  startedAt   null
  finishedAt  null
  duration    null
  batchUid    null
  canceledBy  null
  error
    message  The primary key of index \`movies\` is missing.
    code     index_primary_key_no_candidate_found
    type     invalid_request
    link     https://docs.meilisearch.com/errors#index_primary_key_no_candidate_found
  uid         42
  status      failed
",
}
`;
