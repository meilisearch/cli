// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili multi-search > passes the API error of a missing index through, which the route answers 400 1`] = `
{
  "exitCode": 1,
  "stderr": "{"error":{"code":"index_not_found","type":"invalid_request","message":"Inside \`.queries[0]\`: Index \`missing\` not found.","link":"https://docs.meilisearch.com/errors#index_not_found"}}
",
  "stdout": "",
}
`;

exports[`meili multi-search > prints its help without any network call 1`] = `
"Run several searches in one request.

USAGE
  $ meili multi-search [--debug] [--project-url <url>] [--project-api-key
    <key>] [--project <name>] [--queries <json>] [--federation <json>] [--file
    <path> | --data <json>]

FLAGS
  --data=<json>            Inline JSON body.
  --debug                  Print every HTTP request and response on stderr,
                           secrets redacted.
  --federation=<json>      Merge the hits of every query into one ranked list,
                           as JSON: \`{}\` for the defaults, \`{"limit":5}\` to
                           narrow it. Without it each query answers its own
                           envelope.
  --file=<path>            Read the body from a file. \`-\` reads from stdin.
  --project=<name>         A project of the config file. Cannot be combined with
                           --project-url. One of --project or --project-url is
                           required.
  --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
  --project-url=<url>      Project URL, the Meilisearch instance to talk to. One
                           of --project or --project-url is required.
  --queries=<json>         The search queries as a JSON array, each one an index
                           to search and its search parameters:
                           \`[{"indexUid":"movies","q":"nosferatu"}]\`.

DESCRIPTION
  Run several searches in one request.

  Each query of --queries names its index. The results come side by side, or
  merged into one ranked list with --federation.

EXAMPLES
  $ meili multi-search --project prod --queries '[{"indexUid":"movies","q":"nosferatu"},{"indexUid":"books","q":"nosferatu"}]'

  $ meili multi-search --project prod --queries '[{"indexUid":"movies","q":"nosferatu"}]'

  $ meili multi-search --project prod --queries '[{"indexUid":"movies","q":"horror"},{"indexUid":"books","q":"horror"}]' --federation '{"limit":5}'

  cat queries.json | meili multi-search --project prod --file -

"
`;

exports[`meili multi-search > prints the API envelope as it is in JSON 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"results":[{"indexUid":"movies","hits":[{"id":1,"title":"Nosferatu"}],"query":"nosferatu","processingTimeMs":1,"limit":20,"offset":0,"estimatedTotalHits":1},{"indexUid":"books","hits":[{"id":"dracula","title":"Dracula"}],"query":"nosferatu","processingTimeMs":1,"limit":20,"offset":0,"estimatedTotalHits":1}]}
",
}
`;
