exports[`meili teleport > names the failed tasks of the new project, and what exists in Meilisearch Cloud 1`] = `
"  meili teleport · move your data to Meilisearch Cloud

  ✔ Source      local, http://meili.test:7700
  ✔ Logged in   ada@example.com

[J  ⠋ Loading the regions, the organizations and the teams
[J  ✔ Region      Frankfurt
  ✔ Team        Search (Acme)
  ✔ Project     local-cloud, free trial, free for 14 days

[J  ⠋ Creating local-cloud: running. It can take several minutes.  0s
    Tip: Choose the best plan for your usage: https://www.meilisearch.com/pricing[2A
[J  ✔ Created     local-cloud is running, in the config file as \`local-cloud\`  0s

[J  ⠋ Sending   ──────────────────────────────   0%  0s
[J  ✔ Sent        the data of local  0s

[J  ⠋ Indexing  ──────────────────────────────   0%  0/3 tasks  0s
[J  ⠋ Indexing  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ 100%  3/3 tasks  0s
  ✖ Task 2 (indexCreation) failed: Bad document.

  ✖ Error: 1 task failed in project local-cloud.
    Run \`meili task list --project local-cloud --statuses failed\` to see them.
    Project local-cloud exists in Meilisearch Cloud: https://dashboard.test/teams/12/projects/343
    It is in the config file. To send the data again, run \`meili export --project local --project-destination local-cloud --wait\`.
"
`;

exports[`meili teleport > prints its help without any network call 1`] = `
"Move a self-hosted project to Meilisearch Cloud. Interactive command.

USAGE
  $ meili teleport [--debug] [--project <name>]

FLAGS
  --debug           Print every HTTP request and response on stderr, secrets
                    redacted.
  --project=<name>  A project of the config file, the one whose data moves to
                    Meilisearch Cloud. Without it, the command asks.

DESCRIPTION
  Move a self-hosted project to Meilisearch Cloud. Interactive command.

  Moves the data of a Meilisearch project to a new Meilisearch Cloud project, by
  asking questions on the terminal.

  It checks that the source can export, logs in to Meilisearch Cloud, creates a
  project in the region, team and plan chosen, adds it to the config file,
  exports the data to it, and waits until the new project has indexed it. It
  refuses to run without a terminal.

  The same steps, without questions: Run \`meili auth login\`, then \`meili project
  add --name <name> --team-id <id> --resource-id <id> --sync-config --wait\`,
  then \`meili export --project <source> --project-destination <name> --wait\`,
  then \`meili task list --project <name> --statuses enqueued,processing\` until
  it lists no task.

EXAMPLES
  $ meili teleport

  $ meili teleport --project local

"
`;

exports[`meili teleport > refuses to run without a terminal, with the JSON error and the commands to run instead 1`] = `
{
  "exitCode": 2,
  "stderr": "{"error":{"code":"cli_usage","type":"cli","message":"\`meili teleport\` asks questions, so it runs only in a terminal.","hint":"Run \`meili auth login\`, then \`meili project add --name <name> --team-id <id> --resource-id <id> --sync-config --wait\`, then \`meili export --project <source> --project-destination <name> --wait\`, then \`meili task list --project <name> --statuses enqueued,processing\` until it lists no task."}}
",
  "stdout": "",
}
`;

