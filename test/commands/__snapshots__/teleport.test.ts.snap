exports[`meili teleport > names the failed tasks of the new project, and what exists in Meilisearch Cloud 1`] = `
"Logged in to Meilisearch Cloud as ada@example.com.
local-cloud is a free trial project: free for 14 days.
Meilisearch Cloud is creating local-cloud. It can take several minutes.
While you wait, see the plans and prices at https://www.meilisearch.com/pricing
Project local-cloud is running, and is in the config file as \`local-cloud\`.
Sending the data of local to local-cloud.

[2KSending   [##############################] 100%

[2KIndexing  [##############################] 100%  3/3 tasks
Task 2 (indexCreation) failed: Bad document.

Error: 1 task failed in project local-cloud.
Run \`meili get tasks --project local-cloud --statuses failed\` to see them.
Project local-cloud exists in Meilisearch Cloud: https://dashboard.test/teams/12/projects/343
It is in the config file. To send the data again, run \`meili export --project local --project-destination local-cloud --wait\`.
"
`;

exports[`meili teleport > prints its help without any network call 1`] = `
"Move the data of a Meilisearch project to a new Meilisearch Cloud project, by asking questions on the terminal. For humans only: an agent never runs it.

USAGE
  $ meili teleport [-o <mode>] [--debug] [--project <name>]

FLAGS
  -o, --output=<mode>   json (default): one document, the API body as it is,
                        indented in a terminal, compact when piped. ndjson: one
                        item per line, list commands only, streams with --all.
      --debug           Print every HTTP request and response on stderr, secrets
                        redacted.
      --project=<name>  A project of the config file, the one whose data moves
                        to Meilisearch Cloud. Without it, the command asks.

DESCRIPTION
  Move the data of a Meilisearch project to a new Meilisearch Cloud project, by
  asking questions on the terminal. For humans only: an agent never runs it.

  It checks that the source can export, logs in to Meilisearch Cloud, creates a
  project in the region, team and plan chosen, adds it to the config file,
  exports the data to it, and waits until the new project has indexed it. It
  refuses to run without a terminal.

  An agent does the same without questions. Run \`meili auth login\`, then \`meili
  add projects --name <name> --team-id <id> --resource-id <id> --sync-config
  --wait\`, then \`meili export --project <source> --project-destination <name>
  --wait\`, then \`meili get tasks --project <name> --statuses
  enqueued,processing\` until it lists no task.

EXAMPLES
  $ meili teleport

  $ meili teleport --project local

"
`;

exports[`meili teleport > refuses to run without a terminal, with the JSON error and the commands to run instead 1`] = `
{
  "exitCode": 2,
  "stderr": "{"error":{"code":"cli_usage","type":"cli","message":"\`meili teleport\` asks questions, so it runs only in a terminal, for a human.","hint":"Run \`meili auth login\`, then \`meili add projects --name <name> --team-id <id> --resource-id <id> --sync-config --wait\`, then \`meili export --project <source> --project-destination <name> --wait\`, then \`meili get tasks --project <name> --statuses enqueued,processing\` until it lists no task."}}
",
  "stdout": "",
}
`;
