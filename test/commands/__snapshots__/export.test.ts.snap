// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili export > passes the API error of a url that is not a string through and exits 1 1`] = `
{
  "exitCode": 1,
  "stderr": "{"error":{"code":"invalid_export_url","type":"invalid_request","message":"Invalid value type at \`.url\`: expected a string, but found a boolean: \`true\`","link":"https://docs.meilisearch.com/errors#invalid_export_url"}}
",
  "stdout": "",
}
`;

exports[`meili export > prints its help without any network call 1`] = `
"Send the documents and the settings of this instance to the Meilisearch at --url, and answer the task that does it.

USAGE
  $ meili export [-o <mode>] [--debug] [--project-url <url>]
    [--project-api-key <key>] [--project <name>] [--url <url>] [--api-key <key>]
    [--payload-size <size>] [--indexes <json>] [--file <path> | --data <json>]
    [--timeout <duration> --wait]

FLAGS
  -o, --output=<mode>          json (default): one document, the API body as it
                               is, indented in a terminal, compact when piped.
                               ndjson: one item per line, list commands only,
                               streams with --all.
      --api-key=<key>          API key of that instance, the one the export
                               writes with. --project-api-key stays the key of
                               this one.
      --data=<json>            Inline JSON body.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --file=<path>            Read the body from a file. \`-\` reads from stdin.
      --indexes=<json>         The indexes to export and how, as JSON: an index
                               pattern per key, its filter and overrideSettings
                               as value. Every index by default, \`{"*":{}}\`.
      --payload-size=<size>    Maximum size of one request sent to that
                               instance, for example 24MiB.
      --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. Required when the file has
                               several projects.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.
      --timeout=<duration>     Maximum wait time, for example 30s, 2m. Default
                               60s. Only with --wait.
      --url=<url>              URL of the Meilisearch instance the data is sent
                               to.
      --wait                   Poll the task until it reaches a final status,
                               then print the final task.

DESCRIPTION
  Send the documents and the settings of this instance to the Meilisearch at
  --url, and answer the task that does it.

  The export writes on that instance with the credentials of --api-key, and
  --indexes narrows it to the indexes those patterns match.

EXAMPLES
  $ meili export --url https://ms-1234.heaven.meilisearch.com --api-key <key>

  $ meili export --url https://ms-1234.heaven.meilisearch.com --api-key <key> --output json

  $ meili export --url http://localhost:7701 --indexes '{"movies":{"filter":"rating > 4"}}' --wait

  $ meili export --url http://localhost:7701 --payload-size 24MiB

  $ meili export --data '{"url":"http://localhost:7701","indexes":{"*":{"overrideSettings":true}}}'

"
`;

exports[`meili export > prints the enqueued task as the API returned it, without waiting 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":7,"indexUid":null,"status":"enqueued","type":"export","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;
