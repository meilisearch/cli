// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili export > passes the API error of a url that is not a string through and exits 1 1`] = `
{
  "exitCode": 1,
  "stderr": "{"error":{"code":"invalid_export_url","type":"invalid_request","message":"Invalid value type at \`.url\`: expected a string, but found a boolean: \`true\`","link":"https://docs.meilisearch.com/errors#invalid_export_url"}}
",
  "stdout": "",
}
`;

exports[`meili export > prints its help without any network call 1`] = `
"Export the data of the instance to another instance.

USAGE
  $ meili export [--json] [--no-color] [--debug] [--project-url
    <url>] [--project-api-key <key>] [-p <name>] [--api-key <key>]
    [--project-destination <name> | --url <url>] [--payload-size <size>]
    [--indexes <json>] [--file <path> | --data <json>] [--timeout <duration>
    --wait]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  -p, --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. One of --project or
                               --project-url is required.
      --data=<json>            Inline JSON body.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --file=<path>            Read the body from a file. \`-\` reads from stdin.
      --indexes=<json>         The indexes to export and how, as JSON: an index
                               pattern per key, its filter and overrideSettings
                               as value. Every index by default, \`{"*":{}}\`.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.
                               One of --project or --project-url is required.
      --timeout=<duration>     Maximum wait time, for example 30s, 2m. Default
                               10m. Only with --wait.
      --wait                   Poll the task until it reaches a final status,
                               then print the final task.

DESTINATION FLAGS
  --api-key=<key>               API key of the destination instance, the one the
                                export writes with. --project-api-key stays the
                                key of the source.
  --payload-size=<size>         Maximum size of one request sent to the
                                destination, for example 24MiB.
  --project-destination=<name>  A project of the config file, the destination:
                                its URL and its key stand for --url and
                                --api-key. Cannot be combined with --url.
                                --api-key replaces its key.
  --url=<url>                   URL of the destination instance, the one the
                                data is sent to.

DESCRIPTION
  Export the data of the instance to another instance.

  Sends the documents and the settings to the destination instance, and prints
  the task that does it.

  The source is the project this command connects to, named by --project,
  --project-url and --project-api-key as on every command: it receives the
  request and does the export. The destination is --url with --api-key, or
  --project-destination, an entry of the config file. --indexes narrows the
  export to the indexes those patterns match.

EXAMPLES
  $ meili export --project prod --url https://ms-1234.heaven.meilisearch.com --api-key <key>

  $ meili export -p staging --project-destination prod

  $ meili export -p prod --url http://localhost:7701 --indexes '{"movies":{"filter":"rating > 4"}}' --wait

  $ meili export -p prod --url http://localhost:7701 --payload-size 24MiB

  $ meili export -p prod --data '{"url":"http://localhost:7701","indexes":{"*":{"overrideSettings":true}}}'

"
`;

exports[`meili export > prints the enqueued task as the API returned it, without waiting 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":7,"indexUid":null,"status":"enqueued","type":"export","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;

exports[`meili export > tells a human in a terminal what it did 1`] = `
{
  "exitCode": 0,
  "stderr": "◐ Meilisearch received the request. Task 7 will export to https://ms-1234.heaven.meilisearch.com.


The destination does not have the data yet. Follow the task: meili task view --id 7
Next time, wait for the end with --wait.
",
  "stdout": "  Task      7
  Status    enqueued
  Type      export
  Index     none
  Enqueued  2026-09-24T10:00:00Z
",
}
`;
