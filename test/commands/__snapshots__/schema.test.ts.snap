// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili schema > prints its help without any network call 1`] = `
"Describe the commands as JSON.

USAGE
  $ meili schema [--json] [--no-color] [--debug] [--command
    <command>]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  --command=<command>  Print this command in full instead of the index: its API,
                       its routes, its key actions, the flags it declares itself
                       and its examples.
  --debug              Print every HTTP request and response on stderr, secrets
                       redacted.

DESCRIPTION
  Describe the commands as JSON.

  Prints one line per command, or one command in full with --command, from the
  oclif manifest.

EXAMPLES
  $ meili schema

  $ meili schema --command "index list"

  $ meili schema | jq '.commands[].id'

"
`;

exports[`meili schema > refuses an unknown command with cli_usage and exit 2 1`] = `
{
  "error": {
    "code": "cli_usage",
    "hint": "Did you mean \`meili schema --command "index list"\`?",
    "message": "\`get indexs\` is not a command of meili.",
    "type": "cli",
  },
}
`;
