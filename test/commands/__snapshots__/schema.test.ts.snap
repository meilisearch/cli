// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili schema > prints its help without any network call 1`] = `
"Print one line per command, or one command in full with --command, from the oclif manifest.

USAGE
  $ meili schema [-o <mode>] [--debug] [--command <command>]

FLAGS
  -o, --output=<mode>      json (default): one document, the API body as it is,
                           indented in a terminal, compact when piped. ndjson:
                           one item per line, list commands only, streams with
                           --all.
      --command=<command>  Print this command in full instead of the index: its
                           API, its routes, its key actions, the flags it
                           declares itself and its examples.
      --debug              Print every HTTP request and response on stderr,
                           secrets redacted.

DESCRIPTION
  Print one line per command, or one command in full with --command, from the
  oclif manifest.

EXAMPLES
  $ meili schema

  $ meili schema --output json

  $ meili schema --command "get indexes"

  $ meili schema | jq '.commands[].id'

"
`;

exports[`meili schema > refuses an unknown command with cli_usage and exit 2 1`] = `
{
  "error": {
    "code": "cli_usage",
    "hint": "Did you mean \`meili schema --command "get indexes"\`?",
    "message": "\`get indexs\` is not a command of meili.",
    "type": "cli",
  },
}
`;
