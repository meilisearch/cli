// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili schema > prints its help without any network call 1`] = `
"Print one line per command, or one command in full with --command, from the oclif manifest.

USAGE
  $ meili schema [--project-url <url>] [--project-api-key <key>]
    [--project <name>] [-o <mode>] [--debug] [--command <command>]

FLAGS
  -o, --output=<mode>          json (default): one document, the API body as it
                               is, indented in a terminal, compact when piped.
                               ndjson: one item per line, list commands only,
                               streams with --all.
      --command=<command>      Print this command in full instead of the index:
                               its API, its routes, its key actions, its own
                               flags and its examples.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. Required when the file has
                               several projects.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.

DESCRIPTION
  Print one line per command, or one command in full with --command, from the
  oclif manifest.

EXAMPLES
  $ meili schema

  $ meili schema --output json

  $ meili schema --command "get indexes"

  $ meili schema | jq '.commands[].id'

"
`;

exports[`meili schema > prints one command in full with --command, without repeating the global flags 1`] = `
{
  "api": "meilisearch",
  "async": false,
  "description": "List the indexes of the instance, or get one with --id.",
  "examples": [
    "meili get indexes",
    "meili get indexes --output json",
    "meili get indexes --id movies",
    "meili get indexes --limit 5 --offset 10",
    "meili get indexes --all --output ndjson",
  ],
  "flags": [
    {
      "description": "The index to get. Without it, the command lists the indexes.",
      "helpValue": "<index>",
      "name": "id",
      "required": false,
      "type": "option",
    },
    {
      "description": "Passed to the API.",
      "helpValue": "<n>",
      "name": "limit",
      "required": false,
      "type": "option",
    },
    {
      "description": "Passed to the API.",
      "helpValue": "<n>",
      "name": "offset",
      "required": false,
      "type": "option",
    },
    {
      "description": "Fetch every page. Streams with ndjson, buffers into one array with json.",
      "name": "all",
      "required": false,
      "type": "boolean",
    },
  ],
  "id": "get indexes",
  "keyActions": [
    "indexes.get",
  ],
  "routes": [
    "GET /indexes",
    "GET /indexes/{index_uid}",
  ],
}
`;

exports[`meili schema > refuses an unknown command with cli_usage and exit 2 1`] = `
{
  "error": {
    "code": "cli_usage",
    "hint": "Run \`meili schema\` to see every command.",
    "message": "\`get stats\` is not a command of meili.",
    "type": "cli",
  },
}
`;
