// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili version > prints its help without any network call 1`] = `
"Print the version of the CLI.

USAGE
  $ meili version [-o <mode>] [--debug]

FLAGS
  -o, --output=<mode>  json (default): one document, the API body as it is,
                       indented in a terminal, compact when piped. ndjson: one
                       item per line, only for the commands that print a list of
                       items, streams with --all.
      --debug          Print every HTTP request and response on stderr, secrets
                       redacted.

DESCRIPTION
  Print the version of the CLI.

EXAMPLES
  $ meili version

  $ meili version --output json

"
`;

exports[`meili version > rejects ndjson, which is for lists 1`] = `
{
  "exitCode": 2,
  "stderr": "{"error":{"code":"cli_usage","type":"cli","message":"The \`ndjson\` output mode is only available on the commands that print a list of items. Use \`--output json\`."}}
",
  "stdout": "",
}
`;
