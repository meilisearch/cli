// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili version > prints its help without any network call 1`] = `
"Print the CLI version and platform information.

USAGE
  $ meili version [--json] [--no-color] [--debug]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  --debug  Print every HTTP request and response on stderr, secrets redacted.

DESCRIPTION
  Print the CLI version and platform information.

EXAMPLES
  $ meili version

"
`;
