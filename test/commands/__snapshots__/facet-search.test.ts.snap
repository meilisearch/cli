// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili facet-search > passes the API error of an attribute that is not filterable through and exits 1 1`] = `
{
  "exitCode": 1,
  "stderr": "{"error":{"code":"invalid_facet_search_facet_name","type":"invalid_request","message":"Attribute \`title\` is not facet-searchable. Available facet-searchable attributes patterns are: \`genres\`.","link":"https://docs.meilisearch.com/errors#invalid_facet_search_facet_name"}}
",
  "stdout": "",
}
`;

exports[`meili facet-search > prints its help without any network call 1`] = `
"Search the values of one facet attribute of an index, counted on the documents --q and --filter keep.

USAGE
  $ meili facet-search --index <index> [-o <mode>] [--debug]
    [--project-url <url>] [--project-api-key <key>] [--project <name>]
    [--facet-name <attribute>] [--facet-query <query>] [--q <query>] [--filter
    <filter>] [--matching-strategy last|all|frequency]
    [--attributes-to-search-on <fields>] [--ranking-score-threshold <number>]
    [--locales <locales>] [--hybrid <json>] [--vector <numbers>]
    [--exhaustive-facet-count] [--file <path> | --data <json>]

FLAGS
  -o, --output=<mode>                     json (default): one document, the API
                                          body as it is, indented in a terminal,
                                          compact when piped. ndjson: one item
                                          per line, list commands only, streams
                                          with --all.
      --attributes-to-search-on=<fields>  Restrict the search of --q to these
                                          searchable attributes,
                                          comma-separated.
      --data=<json>                       Inline JSON body.
      --debug                             Print every HTTP request and response
                                          on stderr, secrets redacted.
      --exhaustive-facet-count            Count the facet values exhaustively
                                          instead of estimating the counts.
      --facet-name=<attribute>            The facet attribute to search in. It
                                          must be one of the filterable
                                          attributes of the index.
      --facet-query=<query>               The terms the facet values are matched
                                          against, the first word only. Omit it
                                          to return every value, up to 100.
      --file=<path>                       Read the body from a file. \`-\` reads
                                          from stdin.
      --filter=<filter>                   Filter expression, for example \`rating
                                          > 4\`. Its array-of-arrays form goes
                                          through --data.
      --hybrid=<json>                     Hybrid search as JSON, for example
                                          \`{"embedder":"default","semanticRatio"
                                          :0.5}\`.
      --index=<index>                     (required) The index to search the
                                          facet values in.
      --locales=<locales>                 ISO-639 locales of the query,
                                          comma-separated, instead of
                                          auto-detection.
      --matching-strategy=<option>        How the terms of --q are relaxed when
                                          there are not enough results.
                                          <options: last|all|frequency>
      --project=<name>                    A project of the config file. Cannot
                                          be combined with --project-url.
                                          Required when the file has several
                                          projects.
      --project-api-key=<key>             Project API key. \`-\` reads it from
                                          stdin.
      --project-url=<url>                 Project URL, the Meilisearch instance
                                          to talk to.
      --q=<query>                         The search terms that narrow the
                                          documents the facet values are
                                          computed on, not the values
                                          themselves.
      --ranking-score-threshold=<number>  Count only the documents whose ranking
                                          score reaches this value, between 0.0
                                          and 1.0.
      --vector=<numbers>                  Query vector for a user-provided
                                          embedder, comma-separated numbers.

DESCRIPTION
  Search the values of one facet attribute of an index, counted on the documents
  --q and --filter keep.

EXAMPLES
  $ meili facet-search --index movies --facet-name genres --facet-query ac

  $ meili facet-search --index movies --facet-name genres --facet-query ac --output json

  $ meili facet-search --index movies --facet-name genres --q horror --filter 'rating > 4'

  $ meili facet-search --index movies --data '{"facetName":"genres","facetQuery":"ac"}'

"
`;

exports[`meili facet-search > prints the API envelope as it is in JSON 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"facetHits":[{"value":"action","count":273},{"value":"animated","count":15}],"facetQuery":"ac","processingTimeMs":0}
",
}
`;
