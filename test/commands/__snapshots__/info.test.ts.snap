// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili info > passes the API error of a key the instance refuses through and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\`."}}
",
  "stdout": "",
}
`;

exports[`meili info > prints its help without any network call 1`] = `
"Get the version of the instance.

USAGE
  $ meili info [--json] [--no-color] [--debug] [--project-url
    <url>] [--project-api-key <key>] [-p <name>]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  -p, --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. One of --project or
                               --project-url is required.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.
                               One of --project or --project-url is required.

DESCRIPTION
  Get the version of the instance.

  Prints the version of Meilisearch and the commit it was built from.

EXAMPLES
  $ meili info --project prod

"
`;

exports[`meili info > prints the version as the API returned it 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"commitSha":"b46889b5f0f2f8b91438a08a358ba8f05fc09fc1","commitDate":"2026-09-24T10:00:00.000000Z","pkgVersion":"1.54.0"}
",
}
`;
