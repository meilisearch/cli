// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili create indexes > exits 7 with cli_task_failed when --wait sees the task fail, and still prints it 1`] = `
{
  "exitCode": 7,
  "stderr": "{"error":{"code":"cli_task_failed","type":"cli","message":"Task 11 finished with status failed.","hint":"Run \`meili get tasks --ids 11\` to see the error details."}}
",
  "stdout": "{"indexUid":"movies","type":"indexCreation","enqueuedAt":"2026-09-24T10:00:00Z","startedAt":null,"finishedAt":null,"duration":null,"batchUid":null,"canceledBy":null,"error":{"message":"Index \`movies\` already exists.","code":"index_already_exists","type":"invalid_request","link":"https://docs.meilisearch.com/errors#index_already_exists"},"uid":11,"status":"failed"}
",
}
`;

exports[`meili create indexes > passes an authentication error through and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\` or \`MEILI_PROJECT_API_KEY\`."}}
",
  "stdout": "",
}
`;

exports[`meili create indexes > prints its help without any network call 1`] = `
"Create an index, which the API answers with a task.

USAGE
  $ meili create indexes --id <index> [-o <mode>] [--debug] [--project-url
    <url>] [--project-api-key <key>] [--project <name>] [--primary-key <field>]
    [--file <path> | --data <json>] [--timeout <duration> --wait]

FLAGS
  -o, --output=<mode>          json (default): one document, the API body as it
                               is, indented in a terminal, compact when piped.
                               ndjson: one item per line, list commands only,
                               streams with --all.
      --data=<json>            Inline JSON body.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --file=<path>            Read the body from a file. \`-\` reads from stdin.
      --id=<index>             (required) The index to create.
      --primary-key=<field>    The field that holds the identifier of each
                               document.
      --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. Required when the file has
                               several projects.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.
      --timeout=<duration>     Maximum wait time, for example 30s, 2m. Default
                               60s. Only with --wait.
      --wait                   Poll the task until it reaches a final status,
                               then print the final task.

DESCRIPTION
  Create an index, which the API answers with a task.

EXAMPLES
  $ meili create indexes --id movies

  $ meili create indexes --id movies --primary-key id --output json

  $ meili create indexes --id movies --wait

"
`;

exports[`meili create indexes > prints the enqueued task of the API as it is 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":11,"indexUid":"movies","status":"enqueued","type":"indexCreation","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;

exports[`meili create indexes > prints the final task with --wait 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"indexUid":"movies","type":"indexCreation","enqueuedAt":"2026-09-24T10:00:00Z","startedAt":null,"finishedAt":null,"duration":null,"batchUid":null,"canceledBy":null,"details":{"primaryKey":"id"},"uid":11,"status":"succeeded"}
",
}
`;
