exports[`meili trial start > fails with cli_auth_missing and no browser with --no-login when nobody is logged in 1`] = `
{
  "error": {
    "code": "cli_auth_missing",
    "hint": "Run \`meili auth login\`, then run \`meili trial start\` again.",
    "message": "Nobody is logged in to Meilisearch Cloud.",
    "type": "cli",
  },
}
`;

exports[`meili trial start > passes the error of a used free trial through, with the next step 1`] = `
{
  "error": {
    "code": "user_not_entitled_to_free_trial",
    "hint": "Choose a plan at https://www.meilisearch.com/pricing, then run \`meili project add --name my-app --team-id 12 --resource-id <id> --sync-config --wait\`. \`meili resource list --region-id 2\` lists the plans of the region.",
    "link": "https://www.meilisearch.com/docs/reference/errors#user_not_entitled_to_free_trial",
    "message": "You are not entitled to a free trial.",
    "type": "invalid_request",
  },
}
`;

exports[`meili trial start > prints its help without any network call 1`] = `
"Start a free 14-day trial of Meilisearch Cloud.

USAGE
  $ meili trial start [--json] [--no-color] [--debug] [--name <name>]
    [--team-id <id>] [--region-id <id>] [--login]

OUTPUT FLAGS
  --json      Print compact JSON. The default when stdout is not a terminal.
  --no-color  Print without colors. NO_COLOR does the same.

FLAGS
  --debug           Print every HTTP request and response on stderr, secrets
                    redacted.
  --[no-]login      Log in with a browser when no session exists. --no-login
                    fails with cli_auth_missing instead.
  --name=<name>     Name of the project. Default: the name of the current
                    directory.
  --region-id=<id>  Region of the project. Default: the closest region that
                    offers a free trial.
  --team-id=<id>    Team that owns the project. Required when the account has
                    several teams.

DESCRIPTION
  Start a free 14-day trial of Meilisearch Cloud.

  Logs in with a browser when no session exists, creating an account if needed.
  Then creates a free trial project, waits until it runs, and adds it to the
  config file with its master key. Prints the project, and never its master key.
  When a free trial project already exists, prints it with "created": false and
  creates nothing.

EXAMPLES
  $ meili trial start

  $ meili trial start --name my-app --region-id 2

  $ meili trial start --team-id 12

  $ meili trial start --no-login

"
`;

exports[`meili trial start > refuses to choose a team for an account with several 1`] = `
{
  "error": {
    "code": "cli_usage",
    "hint": "The teams: 12 (Search), 13 (Other). Run \`meili trial start --team-id <id>\`.",
    "message": "Give --team-id: the account has several teams.",
    "type": "cli",
  },
}
`;

exports[`meili trial start > tells a human what it did, the end of the trial and what to run next 1`] = `
"✓ Free trial project my-app is running.
The free trial ends at 2026-12-08T17:00:00Z.


It is in the config file as my-app. Use it: meili index list -p my-app
Dashboard: https://dashboard.test/teams/12/projects/343
"
`;
