// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili settings delete > passes an authentication error through with a hint and exits 3 1`] = `
{
  "exitCode": 3,
  "stderr": "{"error":{"code":"invalid_api_key","type":"auth","message":"The provided API key is invalid.","link":"https://docs.meilisearch.com/errors#invalid_api_key","hint":"Provide an API key with \`--project-api-key <key>\`."}}
",
  "stdout": "",
}
`;

exports[`meili settings delete > prints its help without any network call 1`] = `
"Reset the settings of an index.

USAGE
  $ meili settings delete --index <index> --yes [--debug] [--project-url
    <url>] [--project-api-key <key>] [-p <name>] [--timeout <duration> --wait]

FLAGS
  -p, --project=<name>         A project of the config file. Cannot be combined
                               with --project-url. One of --project or
                               --project-url is required.
      --debug                  Print every HTTP request and response on stderr,
                               secrets redacted.
      --index=<index>          (required) The index to reset the settings of.
                               \`settings update --<setting> null\` resets one of
                               them.
      --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
      --project-url=<url>      Project URL, the Meilisearch instance to talk to.
                               One of --project or --project-url is required.
      --timeout=<duration>     Maximum wait time, for example 30s, 2m. Default
                               10m. Only with --wait.
      --wait                   Poll the task until it reaches a final status,
                               then print the final task.
      --yes                    (required) Confirm the deletion. Nothing is sent
                               to the API without it.

DESCRIPTION
  Reset the settings of an index.

  Every setting goes back to its default value, which reindexes the documents.

EXAMPLES
  $ meili settings delete --project prod --index movies --yes

  $ meili settings delete -p prod --index movies --yes --wait

"
`;

exports[`meili settings delete > prints the enqueued task as the API returned it, without waiting 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"taskUid":15,"indexUid":"movies","status":"enqueued","type":"settingsUpdate","enqueuedAt":"2026-09-24T10:00:00Z"}
",
}
`;
