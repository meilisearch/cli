// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meili settings view > passes the API error of a missing index through and exits 4 1`] = `
{
  "exitCode": 4,
  "stderr": "{"error":{"code":"index_not_found","type":"invalid_request","message":"Index \`missing\` not found.","link":"https://docs.meilisearch.com/errors#index_not_found"}}
",
  "stdout": "",
}
`;

exports[`meili settings view > prints its help without any network call 1`] = `
"Get the settings of an index.

USAGE
  $ meili settings view --index <index> [--debug] [--project-url <url>]
    [--project-api-key <key>] [--project <name>]

FLAGS
  --debug                  Print every HTTP request and response on stderr,
                           secrets redacted.
  --index=<index>          (required) The index to read the settings of.
  --project=<name>         A project of the config file. Cannot be combined with
                           --project-url. One of --project or --project-url is
                           required.
  --project-api-key=<key>  Project API key. \`-\` reads it from stdin.
  --project-url=<url>      Project URL, the Meilisearch instance to talk to. One
                           of --project or --project-url is required.

DESCRIPTION
  Get the settings of an index.

  Each setting has its current value or its default.

EXAMPLES
  $ meili settings view --project prod --index movies

"
`;

exports[`meili settings view > prints the settings as the API returned them 1`] = `
{
  "exitCode": 0,
  "stderr": "",
  "stdout": "{"displayedAttributes":["*"],"searchableAttributes":["title","overview"],"filterableAttributes":["genres"],"sortableAttributes":[],"rankingRules":["words","typo","proximity","attribute","sort","exactness"],"stopWords":["the"],"synonyms":{"phone":["iPhone"]},"distinctAttribute":null,"typoTolerance":{"enabled":true,"minWordSizeForTypos":{"oneTypo":5,"twoTypos":9}},"pagination":{"maxTotalHits":1000},"searchCutoffMs":null,"facetSearch":true,"prefixSearch":"indexingTime"}
",
}
`;
