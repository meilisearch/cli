exports[`meili region list > prints its help without any network call 1`] = `
"List the Meilisearch Cloud regions.

USAGE
  $ meili region list [--debug]

FLAGS
  --debug  Print every HTTP request and response on stderr, secrets redacted.

DESCRIPTION
  List the Meilisearch Cloud regions.

  The regions where a project can run.

EXAMPLES
  $ meili region list

"
`;
