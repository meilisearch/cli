// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`--help > lays out a topic: the usage, the global flags, then the commands 1`] = `
"Indexes of the instance. The commands that write answer with a task: they print it and return at once, and --wait polls it to a final status instead. A delete command requires --yes.

USAGE
  $ meili index COMMAND

GLOBAL FLAGS
  --debug  Print every HTTP request and response on stderr, secrets redacted.

COMMANDS
  index add     Create an index.
  index delete  Delete an index.
  index list    List the indexes of the instance.
  index update  Change the primary key or the name of an index.
  index view    Get one index.

"
`;

exports[`--help > lays out the root help: the resources by API, then the global flags and the variables 1`] = `
"The Meilisearch command line tool.

USAGE
  $ meili <command> <subcommand> [flags]

CLI COMMANDS
  auth      login, logout, refresh, status
  config    list, update, set, sync-with-cloud, unset
  schema    Describe the commands as JSON.
  teleport  Interactive command. Move a project to Meilisearch Cloud.
  version   Print the version of the CLI.

MEILISEARCH COMMANDS
  batch         list, view
  document      list, view, add, update, delete
  export        Export the data of the instance to another instance.
  facet-search  Search the values of a facet.
  health        Check that the instance is available.
  index         list, view, add, update, delete
  info          Get the version of the instance.
  key           list, view, add, update, delete
  multi-search  Run several searches in one request.
  search        Search the documents of an index.
  settings      view, update, delete
  similar       Find the documents similar to one document.
  stats         Get the statistics of the instance, or of one index.
  task          list, view, delete, cancel

CLOUD MANAGEMENT COMMANDS
  organization  list, view, update, delete
  project       list, view, add, update, delete
  region        list
  resource      list
  team          list, view, add, update, delete

GLOBAL FLAGS
  --debug  Print every HTTP request and response on stderr, secrets redacted.

ENVIRONMENT VARIABLES
  MEILI_CONFIG        Config file path. Default ~/.config/meili/config.json.
                      Give each agent its own file, read-only.
  MEILI_TIMEOUT       Default --timeout for --wait.
  MEILI_NO_ANALYTICS  \`true\` or \`1\` turns off the anonymous usage data the CLI
                      sends. \`DO_NOT_TRACK=1\` and \`CI\` turn it off too.

"
`;
