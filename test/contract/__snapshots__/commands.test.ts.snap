    {
      "api": "meilisearch",
      "description": "Find the documents similar to one document.

--id names the document, and --embedder the embedder that compares them.",
      "examples": [
        "meili similar --project prod --index movies --id 143 --embedder default",
        "meili similar -p prod -i movies --id 143 --embedder default --filter 'genres = horror' --limit 5",
        "meili similar -p prod -i movies --data '{"id":143,"embedder":"default","retrieveVectors":true}'",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to. One of --project or --project-url is required.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "char": "p",
          "description": "A project of the config file. Cannot be combined with --project-url. One of --project or --project-url is required.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "char": "i",
          "description": "The index to search in.",
          "helpValue": "<index>",
          "name": "index",
          "required": true,
          "type": "option",
        },
        {
          "description": "The document to compare with, by its primary key value.",
          "helpValue": "<id>",
          "name": "id",
          "type": "option",
        },
        {
          "description": "The embedder the similarity is computed with, one of those the index settings configure.",
          "helpValue": "<embedder>",
          "name": "embedder",
          "type": "option",
        },
        {
          "description": "Number of documents to skip.",
          "helpValue": "<n>",
          "name": "offset",
          "type": "option",
        },
        {
          "description": "Maximum number of documents to return, 20 by default.",
          "helpValue": "<n>",
          "name": "limit",
          "type": "option",
        },
        {
          "description": "Filter expression, for example \`genres = horror\`. Its array-of-arrays form goes through --data.",
          "helpValue": "<filter>",
          "name": "filter",
          "type": "option",
        },
        {
          "description": "Document attributes to return, comma-separated. Defaults to the displayed ones.",
          "helpValue": "<fields>",
          "name": "attributes-to-retrieve",
          "type": "option",
