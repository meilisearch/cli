// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`oclif.manifest.json > \`meili schema\` is a snapshot, the index and every command in full, so a renamed command or flag is visible in review 1`] = `
{
  "commands": [
    {
      "api": "meilisearch",
      "async": true,
      "description": "Add documents to an index, replacing the ones that already have the same primary key.",
      "examples": [
        "meili add documents --index movies --file movies.json",
        "meili add documents --index movies --file movies.json --output json",
        "cat movies.json | meili add documents --index movies --file -",
        "meili add documents --index movies --data '[{"id":1,"title":"Nosferatu"}]' --primary-key id",
        "meili add documents --index movies --file movies.json --wait",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "description": "A project of the config file. Cannot be combined with --project-url. Required when the file has several projects.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "description": "The index to add the documents to.",
          "helpValue": "<index>",
          "name": "index",
          "required": true,
          "type": "option",
        },
        {
          "description": "Primary key of the index. Only taken into account on its first documents.",
          "helpValue": "<field>",
          "name": "primary-key",
          "type": "option",
        },
        {
          "description": "String attached to the task, returned in the task object.",
          "helpValue": "<string>",
          "name": "custom-metadata",
          "type": "option",
        },
        {
          "description": "Only update documents that already exist, ignore the new ones.",
          "name": "skip-creation",
          "type": "boolean",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
        {
          "description": "Poll the task until it reaches a final status, then print the final task.",
          "name": "wait",
          "type": "boolean",
        },
        {
          "dependsOn": [
            "wait",
          ],
          "description": "Maximum wait time, for example 30s, 2m. Default 60s. Only with --wait.",
          "helpValue": "<duration>",
          "name": "timeout",
          "type": "option",
        },
      ],
      "id": "add documents",
      "keyActions": [
        "documents.add",
      ],
      "routes": [
        "POST /indexes/{index_uid}/documents",
      ],
    },
    {
      "api": "meilisearch",
      "async": true,
      "description": "Create an empty index, named by --id, with --primary-key as its primary key.",
      "examples": [
        "meili add indexes --id movies",
        "meili add indexes --id movies --primary-key id --output json",
        "meili add indexes --id movies --wait",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "description": "A project of the config file. Cannot be combined with --project-url. Required when the file has several projects.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "description": "The index to create.",
          "helpValue": "<index>",
          "name": "id",
          "required": true,
          "type": "option",
        },
        {
          "description": "The field that holds the identifier of each document. Without it, Meilisearch infers it from the first documents.",
          "helpValue": "<field>",
          "name": "primary-key",
          "type": "option",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
        {
          "description": "Poll the task until it reaches a final status, then print the final task.",
          "name": "wait",
          "type": "boolean",
        },
        {
          "dependsOn": [
            "wait",
          ],
          "description": "Maximum wait time, for example 30s, 2m. Default 60s. Only with --wait.",
          "helpValue": "<duration>",
          "name": "timeout",
          "type": "option",
        },
      ],
      "id": "add indexes",
      "keyActions": [
        "indexes.create",
      ],
      "routes": [
        "POST /indexes",
      ],
    },
    {
      "api": "none",
      "description": "Log in to Meilisearch Cloud with a browser, and store the token for the management commands.",
      "examples": [
        "meili auth login",
        "meili auth login --output json",
        "meili auth login --no-browser",
      ],
      "flags": [
        {
          "description": "The OAuth application to log in with, on a Cloud that is not Meilisearch Cloud. Also MEILI_MANAGEMENT_CLIENT_ID.",
          "helpValue": "<uid>",
          "name": "management-client-id",
          "type": "option",
        },
        {
          "description": "Management API base URL, which holds the token endpoint.",
          "helpValue": "<url>",
          "name": "management-url",
          "type": "option",
        },
        {
          "description": "Dashboard URL, which hosts the consent page.",
          "helpValue": "<url>",
          "name": "management-dashboard-url",
          "type": "option",
        },
        {
          "description": "Open the consent page in a browser. --no-browser only prints the URL.",
          "name": "browser",
          "type": "boolean",
        },
      ],
      "id": "auth login",
    },
    {
      "api": "none",
      "description": "Revoke the token of \`auth login\` and forget it. Does nothing when nobody is logged in.",
      "examples": [
        "meili auth logout",
        "meili auth logout --output json",
      ],
      "flags": [],
      "id": "auth logout",
    },
    {
      "api": "none",
      "description": "Trade the refresh token of the stored session for a new access token, before it expires.",
      "examples": [
        "meili auth refresh",
        "meili auth refresh --output json",
      ],
      "flags": [],
      "id": "auth refresh",
    },
    {
      "api": "none",
      "description": "Say whether a session of \`auth login\` exists and whether the authorization server still accepts it.",
      "examples": [
        "meili auth status",
        "meili auth status --output json",
      ],
      "flags": [],
      "id": "auth status",
    },
    {
      "api": "none",
      "description": "Print the config file path and its projects as JSON, keys masked.",
      "examples": [
        "meili config list",
        "meili config list --output json",
        "MEILI_CONFIG=./meili.json meili config list",
      ],
      "flags": [],
      "id": "config list",
    },
    {
      "api": "none",
      "description": "Set a project in the config file, creating the file owner-only; refuses a name that exists.

The file holds API keys and decides where every later command goes, for every process that reads it: an agent runs this only when the human asked for it explicitly.",
      "examples": [
        "meili config set --project local --project-url http://localhost:7700",
        "meili config set --project prod --project-url https://ms-abc.sfo.meilisearch.io --project-api-key - < key.txt",
        "meili config set --project local --project-url http://localhost:7700 --output json",
      ],
      "flags": [
        {
          "description": "Name of the project to set.",
          "helpValue": "<name>",
          "name": "project",
          "required": true,
          "type": "option",
        },
        {
          "description": "URL of the project.",
          "helpValue": "<url>",
          "name": "project-url",
          "required": true,
          "type": "option",
        },
        {
          "description": "API key of the project. \`-\` reads it from stdin, out of the shell history.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
      ],
      "id": "config set",
    },
    {
      "api": "none",
      "description": "Remove a project from the config file.

The file holds API keys and decides where every later command goes, for every process that reads it: an agent runs this only when the human asked for it explicitly.",
      "examples": [
        "meili config unset --project prod",
        "meili config unset --project prod --output json",
      ],
      "flags": [
        {
          "description": "Name of the project to remove.",
          "helpValue": "<name>",
          "name": "project",
          "required": true,
          "type": "option",
        },
      ],
      "id": "config unset",
    },
    {
      "api": "meilisearch",
      "async": true,
      "description": "Delete the documents of an index named by --ids, matched by --filter, or every one of them with --all.",
      "examples": [
        "meili delete documents --index movies --ids 42,1344 --yes",
        "meili delete documents --index movies --ids 42 --yes --output json",
        "meili delete documents --index movies --filter 'rating < 2' --yes",
        "meili delete documents --index movies --file ids.json --yes",
        "meili delete documents --index movies --all --yes --wait",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "description": "A project of the config file. Cannot be combined with --project-url. Required when the file has several projects.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "description": "The index to delete the documents from.",
          "helpValue": "<index>",
          "name": "index",
          "required": true,
          "type": "option",
        },
        {
          "description": "Document identifiers to delete, comma-separated.",
          "exclusive": [
            "filter",
            "all",
          ],
          "helpValue": "<ids>",
          "name": "ids",
          "type": "option",
        },
        {
          "description": "Delete the documents matching this filter expression, for example \`rating < 2\`.",
          "exclusive": [
            "ids",
            "all",
          ],
          "helpValue": "<filter>",
          "name": "filter",
          "type": "option",
        },
        {
          "description": "Delete every document of the index.",
          "exclusive": [
            "ids",
            "filter",
            "file",
            "data",
          ],
          "name": "all",
          "type": "boolean",
        },
        {
          "description": "String attached to the task, returned in the task object.",
          "helpValue": "<string>",
          "name": "custom-metadata",
          "type": "option",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
        {
          "description": "Poll the task until it reaches a final status, then print the final task.",
          "name": "wait",
          "type": "boolean",
        },
        {
          "dependsOn": [
            "wait",
          ],
          "description": "Maximum wait time, for example 30s, 2m. Default 60s. Only with --wait.",
          "helpValue": "<duration>",
          "name": "timeout",
          "type": "option",
        },
        {
          "description": "Confirm the deletion. Nothing is sent to the API without it.",
          "name": "yes",
          "required": true,
          "type": "boolean",
        },
      ],
      "id": "delete documents",
      "keyActions": [
        "documents.delete",
      ],
      "routes": [
        "DELETE /indexes/{index_uid}/documents",
        "POST /indexes/{index_uid}/documents/delete",
        "POST /indexes/{index_uid}/documents/delete-batch",
      ],
    },
    {
      "api": "meilisearch",
      "async": true,
      "description": "Delete an index, with its documents, its settings and its task history.",
      "examples": [
        "meili delete indexes --id movies --yes",
        "meili delete indexes --id movies --yes --output json",
        "meili delete indexes --id movies --yes --wait",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "description": "A project of the config file. Cannot be combined with --project-url. Required when the file has several projects.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "description": "The index to delete.",
          "helpValue": "<index>",
          "name": "id",
          "required": true,
          "type": "option",
        },
        {
          "description": "Poll the task until it reaches a final status, then print the final task.",
          "name": "wait",
          "type": "boolean",
        },
        {
          "dependsOn": [
            "wait",
          ],
          "description": "Maximum wait time, for example 30s, 2m. Default 60s. Only with --wait.",
          "helpValue": "<duration>",
          "name": "timeout",
          "type": "option",
        },
        {
          "description": "Confirm the deletion. Nothing is sent to the API without it.",
          "name": "yes",
          "required": true,
          "type": "boolean",
        },
      ],
      "id": "delete indexes",
      "keyActions": [
        "indexes.delete",
      ],
      "routes": [
        "DELETE /indexes/{index_uid}",
      ],
    },
    {
      "api": "meilisearch",
      "description": "List the documents of an index, narrowed by --ids or by --filter.",
      "examples": [
        "meili get documents --index movies",
        "meili get documents --index movies --output json",
        "meili get documents --index movies --ids 42,1344 --fields id,title",
        "meili get documents --index movies --filter 'rating > 4' --sort rating:desc",
        "meili get documents --index movies --all --output ndjson",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "description": "A project of the config file. Cannot be combined with --project-url. Required when the file has several projects.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "description": "The index to read the documents from.",
          "helpValue": "<index>",
          "name": "index",
          "required": true,
          "type": "option",
        },
        {
          "description": "Document identifiers to return, comma-separated.",
          "helpValue": "<ids>",
          "name": "ids",
          "type": "option",
        },
        {
          "description": "Filter expression, for example \`rating > 4\`. Its array-of-arrays form goes through --data.",
          "helpValue": "<filter>",
          "name": "filter",
          "type": "option",
        },
        {
          "description": "Document attributes to return, comma-separated. Defaults to all of them.",
          "helpValue": "<fields>",
          "name": "fields",
          "type": "option",
        },
        {
          "description": "Attributes to sort on, comma-separated, each as \`attribute:asc\` or \`:desc\`.",
          "helpValue": "<sort>",
          "name": "sort",
          "type": "option",
        },
        {
          "description": "Include the vector embeddings of the documents that have them.",
          "name": "retrieve-vectors",
          "type": "boolean",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "limit",
          "type": "option",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "offset",
          "type": "option",
        },
        {
          "description": "Fetch every page. Streams with ndjson, buffers into one array with json.",
          "name": "all",
          "type": "boolean",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
      ],
      "id": "get documents",
      "keyActions": [
        "documents.get",
      ],
      "routes": [
        "POST /indexes/{index_uid}/documents/fetch",
      ],
    },
    {
      "api": "meilisearch",
      "description": "Check that the Meilisearch instance is available.",
      "examples": [
        "meili get health",
        "meili get health --output json",
        "MEILI_PROJECT_URL=http://localhost:7700 meili get health",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "description": "A project of the config file. Cannot be combined with --project-url. Required when the file has several projects.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
      ],
      "id": "get health",
      "routes": [
        "GET /health",
      ],
    },
    {
      "api": "meilisearch",
      "description": "List the indexes of the instance, or get one with --id.",
      "examples": [
        "meili get indexes",
        "meili get indexes --output json",
        "meili get indexes --id movies",
        "meili get indexes --limit 5 --offset 10",
        "meili get indexes --all --output ndjson",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "description": "A project of the config file. Cannot be combined with --project-url. Required when the file has several projects.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "description": "The index to get. Without it, the command lists the indexes.",
          "helpValue": "<index>",
          "name": "id",
          "type": "option",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "limit",
          "type": "option",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "offset",
          "type": "option",
        },
        {
          "description": "Fetch every page. Streams with ndjson, buffers into one array with json.",
          "name": "all",
          "type": "boolean",
        },
      ],
      "id": "get indexes",
      "keyActions": [
        "indexes.get",
      ],
      "routes": [
        "GET /indexes",
        "GET /indexes/{index_uid}",
      ],
    },
    {
      "api": "none",
      "description": "Print one line per command, or one command in full with --command, from the oclif manifest.",
      "examples": [
        "meili schema",
        "meili schema --output json",
        "meili schema --command "get indexes"",
        "meili schema | jq '.commands[].id'",
      ],
      "flags": [
        {
          "description": "Print this command in full instead of the index: its API, its routes, its key actions, the flags it declares itself and its examples.",
          "helpValue": "<command>",
          "name": "command",
          "type": "option",
        },
      ],
      "id": "schema",
    },
    {
      "api": "meilisearch",
      "description": "Search the documents of an index, with --q and the search parameters of the route.",
      "examples": [
        "meili search --index movies --q nosferatu",
        "meili search --index movies --q nosferatu --output json",
        "meili search --index movies --q horror --filter 'rating > 4' --sort rating:desc --limit 5",
        "meili search --index movies --facets genres --attributes-to-retrieve id,title",
        "meili search --index movies --data '{"q":"nosferatu","hybrid":{"embedder":"default","semanticRatio":0.5}}'",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "description": "A project of the config file. Cannot be combined with --project-url. Required when the file has several projects.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "description": "The index to search in.",
          "helpValue": "<index>",
          "name": "index",
          "required": true,
          "type": "option",
        },
        {
          "description": "The search terms. Omit it for a placeholder search, which returns everything.",
          "helpValue": "<query>",
          "name": "q",
          "type": "option",
        },
        {
          "description": "Number of documents to skip. Ignored when --page or --hits-per-page is given.",
          "helpValue": "<n>",
          "name": "offset",
          "type": "option",
        },
        {
          "description": "Maximum number of documents to return, 20 by default. Ignored when --page or --hits-per-page is given.",
          "helpValue": "<n>",
          "name": "limit",
          "type": "option",
        },
        {
          "description": "Page to return, 1-indexed. The response then carries totalHits and totalPages instead of estimatedTotalHits.",
          "helpValue": "<n>",
          "name": "page",
          "type": "option",
        },
        {
          "description": "Number of documents per page, used with --page. 0 counts without returning any.",
          "helpValue": "<n>",
          "name": "hits-per-page",
          "type": "option",
        },
        {
          "description": "Document attributes to return, comma-separated. Defaults to the displayed ones.",
          "helpValue": "<fields>",
          "name": "attributes-to-retrieve",
          "type": "option",
        },
        {
          "description": "Attributes to crop in _formatted, comma-separated, each optionally as \`attribute:length\`.",
          "helpValue": "<fields>",
          "name": "attributes-to-crop",
          "type": "option",
        },
        {
          "description": "Maximum number of words in a cropped value, 10 by default.",
          "helpValue": "<n>",
          "name": "crop-length",
          "type": "option",
        },
        {
          "description": "String marking where a cropped value was cut, \`…\` by default.",
          "helpValue": "<string>",
          "name": "crop-marker",
          "type": "option",
        },
        {
          "description": "Attributes to highlight in _formatted, comma-separated.",
          "helpValue": "<fields>",
          "name": "attributes-to-highlight",
          "type": "option",
        },
        {
          "description": "String inserted before each highlighted term, \`<em>\` by default.",
          "helpValue": "<string>",
          "name": "highlight-pre-tag",
          "type": "option",
        },
        {
          "description": "String inserted after each highlighted term, \`</em>\` by default.",
          "helpValue": "<string>",
          "name": "highlight-post-tag",
          "type": "option",
        },
        {
          "description": "Add _matchesPosition to each hit, the byte offset of every matched term.",
          "name": "show-matches-position",
          "type": "boolean",
        },
        {
          "description": "Filter expression, for example \`rating > 4\`. Its array-of-arrays form goes through --data.",
          "helpValue": "<filter>",
          "name": "filter",
          "type": "option",
        },
        {
          "description": "Attributes to sort on, comma-separated, each as \`attribute:asc\` or \`:desc\`.",
          "helpValue": "<sort>",
          "name": "sort",
          "type": "option",
        },
        {
          "description": "Return one document per value of this attribute, which must be filterable.",
          "helpValue": "<attribute>",
          "name": "distinct",
          "type": "option",
        },
        {
          "description": "Attributes to count in facetDistribution, comma-separated. Patterns such as \`*\` are accepted.",
          "helpValue": "<facets>",
          "name": "facets",
          "type": "option",
        },
        {
          "description": "How query terms are relaxed when there are not enough results.",
          "name": "matching-strategy",
          "options": [
            "last",
            "all",
            "frequency",
          ],
          "type": "option",
        },
        {
          "description": "Restrict the search to these searchable attributes, comma-separated.",
          "helpValue": "<fields>",
          "name": "attributes-to-search-on",
          "type": "option",
        },
        {
          "description": "Drop the hits whose ranking score is below this value, between 0.0 and 1.0.",
          "helpValue": "<number>",
          "name": "ranking-score-threshold",
          "type": "option",
        },
        {
          "description": "ISO-639 locales of the query, comma-separated, instead of auto-detection.",
          "helpValue": "<locales>",
          "name": "locales",
          "type": "option",
        },
        {
          "description": "Hybrid search as JSON, for example \`{"embedder":"default","semanticRatio":0.5}\`.",
          "helpValue": "<json>",
          "name": "hybrid",
          "type": "option",
        },
        {
          "description": "Query vector for a user-provided embedder, comma-separated numbers.",
          "helpValue": "<numbers>",
          "name": "vector",
          "type": "option",
        },
        {
          "description": "Add _vectors to each hit, the embeddings of the document.",
          "name": "retrieve-vectors",
          "type": "boolean",
        },
        {
          "description": "Add _rankingScore to each hit, between 0.0 and 1.0.",
          "name": "show-ranking-score",
          "type": "boolean",
        },
        {
          "description": "Add _rankingScoreDetails to each hit, the score of every ranking rule.",
          "name": "show-ranking-score-details",
          "type": "boolean",
        },
        {
          "description": "Add performanceDetails to the response, a timing breakdown of the query.",
          "name": "show-performance-details",
          "type": "boolean",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
      ],
      "id": "search",
      "keyActions": [
        "search",
      ],
      "routes": [
        "POST /indexes/{index_uid}/search",
      ],
    },
    {
      "api": "meilisearch",
      "async": true,
      "description": "Add documents to an index, merging their fields into the ones that already have the same primary key.",
      "examples": [
        "meili update documents --index movies --file changes.json",
        "meili update documents --index movies --file changes.json --output json",
        "cat changes.json | meili update documents --index movies --file -",
        "meili update documents --index movies --data '[{"id":1,"rating":4}]'",
        "meili update documents --index movies --file changes.json --wait",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "description": "A project of the config file. Cannot be combined with --project-url. Required when the file has several projects.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "description": "The index to update the documents of.",
          "helpValue": "<index>",
          "name": "index",
          "required": true,
          "type": "option",
        },
        {
          "description": "Primary key of the index. Only taken into account on its first documents.",
          "helpValue": "<field>",
          "name": "primary-key",
          "type": "option",
        },
        {
          "description": "String attached to the task, returned in the task object.",
          "helpValue": "<string>",
          "name": "custom-metadata",
          "type": "option",
        },
        {
          "description": "Only update documents that already exist, ignore the new ones.",
          "name": "skip-creation",
          "type": "boolean",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
        {
          "description": "Poll the task until it reaches a final status, then print the final task.",
          "name": "wait",
          "type": "boolean",
        },
        {
          "dependsOn": [
            "wait",
          ],
          "description": "Maximum wait time, for example 30s, 2m. Default 60s. Only with --wait.",
          "helpValue": "<duration>",
          "name": "timeout",
          "type": "option",
        },
      ],
      "id": "update documents",
      "keyActions": [
        "documents.add",
      ],
      "routes": [
        "PUT /indexes/{index_uid}/documents",
      ],
    },
    {
      "api": "meilisearch",
      "async": true,
      "description": "Change the primary key of an index with --primary-key, or rename it with --new-id.",
      "examples": [
        "meili update indexes --id movies --primary-key movie_id",
        "meili update indexes --id movies --primary-key movie_id --output json",
        "meili update indexes --id movies --new-id films",
        "meili update indexes --id movies --new-id films --wait",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "description": "A project of the config file. Cannot be combined with --project-url. Required when the file has several projects.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "description": "The index to update.",
          "helpValue": "<index>",
          "name": "id",
          "required": true,
          "type": "option",
        },
        {
          "description": "New uid of the index, which renames it.",
          "helpValue": "<index>",
          "name": "new-id",
          "type": "option",
        },
        {
          "description": "The field that holds the identifier of each document.",
          "helpValue": "<field>",
          "name": "primary-key",
          "type": "option",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
        {
          "description": "Poll the task until it reaches a final status, then print the final task.",
          "name": "wait",
          "type": "boolean",
        },
        {
          "dependsOn": [
            "wait",
          ],
          "description": "Maximum wait time, for example 30s, 2m. Default 60s. Only with --wait.",
          "helpValue": "<duration>",
          "name": "timeout",
          "type": "option",
        },
      ],
      "id": "update indexes",
      "keyActions": [
        "indexes.update",
      ],
      "routes": [
        "PATCH /indexes/{index_uid}",
      ],
    },
  ],
  "index": {
    "commands": [
      {
        "description": "Add documents to an index, replacing the ones that already have the same primary key.",
        "id": "add documents",
        "routes": [
          "POST /indexes/{index_uid}/documents",
        ],
      },
      {
        "description": "Create an empty index, named by --id, with --primary-key as its primary key.",
        "id": "add indexes",
        "routes": [
          "POST /indexes",
        ],
      },
      {
        "description": "Log in to Meilisearch Cloud with a browser, and store the token for the management commands.",
        "id": "auth login",
      },
      {
        "description": "Revoke the token of \`auth login\` and forget it. Does nothing when nobody is logged in.",
        "id": "auth logout",
      },
      {
        "description": "Trade the refresh token of the stored session for a new access token, before it expires.",
        "id": "auth refresh",
      },
      {
        "description": "Say whether a session of \`auth login\` exists and whether the authorization server still accepts it.",
        "id": "auth status",
      },
      {
        "description": "Print the config file path and its projects as JSON, keys masked.",
        "id": "config list",
      },
      {
        "description": "Set a project in the config file, creating the file owner-only; refuses a name that exists.",
        "id": "config set",
      },
      {
        "description": "Remove a project from the config file.",
        "id": "config unset",
      },
      {
        "description": "Delete the documents of an index named by --ids, matched by --filter, or every one of them with --all.",
        "id": "delete documents",
        "routes": [
          "DELETE /indexes/{index_uid}/documents",
          "POST /indexes/{index_uid}/documents/delete",
          "POST /indexes/{index_uid}/documents/delete-batch",
        ],
      },
      {
        "description": "Delete an index, with its documents, its settings and its task history.",
        "id": "delete indexes",
        "routes": [
          "DELETE /indexes/{index_uid}",
        ],
      },
      {
        "description": "List the documents of an index, narrowed by --ids or by --filter.",
        "id": "get documents",
        "routes": [
          "POST /indexes/{index_uid}/documents/fetch",
        ],
      },
      {
        "description": "Check that the Meilisearch instance is available.",
        "id": "get health",
        "routes": [
          "GET /health",
        ],
      },
      {
        "description": "List the indexes of the instance, or get one with --id.",
        "id": "get indexes",
        "routes": [
          "GET /indexes",
          "GET /indexes/{index_uid}",
        ],
      },
      {
        "description": "Print one line per command, or one command in full with --command, from the oclif manifest.",
        "id": "schema",
      },
      {
        "description": "Search the documents of an index, with --q and the search parameters of the route.",
        "id": "search",
        "routes": [
          "POST /indexes/{index_uid}/search",
        ],
      },
      {
        "description": "Add documents to an index, merging their fields into the ones that already have the same primary key.",
        "id": "update documents",
        "routes": [
          "PUT /indexes/{index_uid}/documents",
        ],
      },
      {
        "description": "Change the primary key of an index with --primary-key, or rename it with --new-id.",
        "id": "update indexes",
        "routes": [
          "PATCH /indexes/{index_uid}",
        ],
      },
    ],
    "globalFlags": [
      {
        "char": "o",
        "description": "json (default): one document, the API body as it is, indented in a terminal, compact when piped. ndjson: one item per line, list commands only, streams with --all.",
        "helpValue": "<mode>",
        "name": "output",
        "options": [
          "json",
          "ndjson",
        ],
        "type": "option",
      },
      {
        "description": "Print every HTTP request and response on stderr, secrets redacted.",
        "name": "debug",
        "type": "boolean",
      },
    ],
    "name": "meili",
    "version": "0.0.0",
  },
}
`;
