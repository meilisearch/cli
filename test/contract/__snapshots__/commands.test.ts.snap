// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`oclif.manifest.json > \`meili schema\` is a snapshot, the index and every command in full, so a renamed command or flag is visible in review 1`] = `
{
  "commands": [
    {
      "api": "none",
      "description": "Add a project to the config file, creating it owner-only; refuses a name that exists.

The file holds API keys and decides where every later command goes, for every process that reads it: an agent runs this only when the human asked for it explicitly.",
      "examples": [
        "meili config add --project local --project-url http://localhost:7700",
        "meili config add --project prod --project-url https://ms-abc.sfo.meilisearch.io --project-api-key - < key.txt",
        "meili config add --project local --project-url http://localhost:7700 --output json",
      ],
      "flags": [
        {
          "description": "Name of the project to add.",
          "helpValue": "<name>",
          "name": "project",
          "required": true,
          "type": "option",
        },
        {
          "description": "URL of the project.",
          "helpValue": "<url>",
          "name": "project-url",
          "required": true,
          "type": "option",
        },
      ],
      "id": "config add",
    },
    {
      "api": "none",
      "description": "Print the config file path and its projects as JSON, keys masked.",
      "examples": [
        "meili config list",
        "meili config list --output json",
        "MEILI_CONFIG=./meili.json meili config list",
      ],
      "flags": [],
      "id": "config list",
    },
    {
      "api": "none",
      "description": "Remove a project from the config file.

The file holds API keys and decides where every later command goes, for every process that reads it: an agent runs this only when the human asked for it explicitly.",
      "examples": [
        "meili config remove --project prod",
        "meili config remove --project prod --output json",
      ],
      "flags": [
        {
          "description": "Name of the project to remove.",
          "helpValue": "<name>",
          "name": "project",
          "required": true,
          "type": "option",
        },
      ],
      "id": "config remove",
    },
    {
      "api": "meilisearch",
      "description": "Check that the Meilisearch instance is available.",
      "examples": [
        "meili get health",
        "meili get health --output json",
        "MEILI_PROJECT_URL=http://localhost:7700 meili get health",
      ],
      "flags": [],
      "id": "get health",
      "routes": [
        "GET /health",
      ],
    },
    {
      "api": "meilisearch",
      "description": "List the indexes of the instance, or get one with --id.",
      "examples": [
        "meili get indexes",
        "meili get indexes --output json",
        "meili get indexes --id movies",
        "meili get indexes --limit 5 --offset 10",
        "meili get indexes --all --output ndjson",
      ],
      "flags": [
        {
          "description": "The index to get. Without it, the command lists the indexes.",
          "helpValue": "<index>",
          "name": "id",
          "type": "option",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "limit",
          "type": "option",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "offset",
          "type": "option",
        },
        {
          "description": "Fetch every page. Streams with ndjson, buffers into one array with json.",
          "name": "all",
          "type": "boolean",
        },
      ],
      "id": "get indexes",
      "keyActions": [
        "indexes.get",
      ],
      "routes": [
        "GET /indexes",
        "GET /indexes/{index_uid}",
      ],
    },
    {
      "api": "none",
      "description": "Print one line per command, or one command in full with --command, from the oclif manifest.",
      "examples": [
        "meili schema",
        "meili schema --output json",
        "meili schema --command "get indexes"",
        "meili schema | jq '.commands[].id'",
      ],
      "flags": [
        {
          "description": "Print this command in full instead of the index: its API, its routes, its key actions, the flags it declares itself and its examples.",
          "helpValue": "<command>",
          "name": "command",
          "type": "option",
        },
      ],
      "id": "schema",
    },
  ],
  "index": {
    "commands": [
      {
        "description": "Add a project to the config file, creating it owner-only; refuses a name that exists.",
        "id": "config add",
      },
      {
        "description": "Print the config file path and its projects as JSON, keys masked.",
        "id": "config list",
      },
      {
        "description": "Remove a project from the config file.",
        "id": "config remove",
      },
      {
        "description": "Check that the Meilisearch instance is available.",
        "id": "get health",
        "routes": [
          "GET /health",
        ],
      },
      {
        "description": "List the indexes of the instance, or get one with --id.",
        "id": "get indexes",
        "routes": [
          "GET /indexes",
          "GET /indexes/{index_uid}",
        ],
      },
      {
        "description": "Print one line per command, or one command in full with --command, from the oclif manifest.",
        "id": "schema",
      },
    ],
    "globalFlags": [
      {
        "description": "Project URL, the Meilisearch instance to talk to.",
        "helpValue": "<url>",
        "name": "project-url",
        "type": "option",
      },
      {
        "description": "Project API key. \`-\` reads it from stdin.",
        "helpValue": "<key>",
        "name": "project-api-key",
        "type": "option",
      },
      {
        "description": "A project of the config file. Cannot be combined with --project-url. Required when the file has several projects.",
        "helpValue": "<name>",
        "name": "project",
        "type": "option",
      },
      {
        "char": "o",
        "description": "json (default): one document, the API body as it is, indented in a terminal, compact when piped. ndjson: one item per line, list commands only, streams with --all.",
        "helpValue": "<mode>",
        "name": "output",
        "options": [
          "json",
          "ndjson",
        ],
        "type": "option",
      },
      {
        "description": "Print every HTTP request and response on stderr, secrets redacted.",
        "name": "debug",
        "type": "boolean",
      },
    ],
    "name": "meili",
    "version": "0.0.0",
  },
}
`;
