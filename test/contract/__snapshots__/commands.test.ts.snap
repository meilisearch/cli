// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`oclif.manifest.json > \`meili schema\` is a snapshot, the index and every command in full, so a renamed command or flag is visible in review 1`] = `
{
  "commands": [
    {
      "api": "none",
      "description": "Add a project to the config file, creating it owner-only; refuses a name that exists.

The file holds API keys and decides where every later command goes, for every process that reads it: an agent runs this only when the human asked for it explicitly.",
      "examples": [
        "meili config add --project local --project-url http://localhost:7700",
        "meili config add --project prod --project-url https://ms-abc.sfo.meilisearch.io --project-api-key - < key.txt",
        "meili config add --project local --project-url http://localhost:7700 --output json",
      ],
      "flags": [
        {
          "description": "Name of the project to add.",
          "helpValue": "<name>",
          "name": "project",
          "required": true,
          "type": "option",
        },
        {
          "description": "URL of the project.",
          "helpValue": "<url>",
          "name": "project-url",
          "required": true,
          "type": "option",
        },
      ],
      "id": "config add",
    },
    {
      "api": "none",
      "description": "Print the config file path and its projects as JSON, keys masked.",
      "examples": [
        "meili config list",
        "meili config list --output json",
        "MEILI_CONFIG=./meili.json meili config list",
      ],
      "flags": [],
      "id": "config list",
    },
    {
      "api": "none",
      "description": "Remove a project from the config file.

The file holds API keys and decides where every later command goes, for every process that reads it: an agent runs this only when the human asked for it explicitly.",
      "examples": [
        "meili config remove --project prod",
        "meili config remove --project prod --output json",
      ],
      "flags": [
        {
          "description": "Name of the project to remove.",
          "helpValue": "<name>",
          "name": "project",
          "required": true,
          "type": "option",
        },
      ],
      "id": "config remove",
    },
    {
      "api": "meilisearch",
      "async": true,
      "description": "Create an index, which the API answers with a task.",
      "examples": [
        "meili create indexes --id movies",
        "meili create indexes --id movies --primary-key id --output json",
        "meili create indexes --id movies --wait",
      ],
      "flags": [
        {
          "description": "The index to create.",
          "helpValue": "<index>",
          "name": "id",
          "required": true,
          "type": "option",
        },
        {
          "description": "The field that holds the identifier of each document.",
          "helpValue": "<field>",
          "name": "primary-key",
          "type": "option",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
        {
          "description": "Poll the task until it reaches a final status, then print the final task.",
          "name": "wait",
          "type": "boolean",
        },
        {
          "dependsOn": [
            "wait",
          ],
          "description": "Maximum wait time, for example 30s, 2m. Default 60s. Only with --wait.",
          "helpValue": "<duration>",
          "name": "timeout",
          "type": "option",
        },
      ],
      "id": "create indexes",
      "keyActions": [
        "indexes.create",
      ],
      "routes": [
        "POST /indexes",
      ],
    },
    {
      "api": "meilisearch",
      "description": "List the documents of an index, or the ones --ids or --filter selects.",
      "examples": [
        "meili get documents --index movies --limit 5 --output json",
        "meili get documents --index movies --ids 1,2",
        "meili get documents --index movies --filter 'year > 1920' --fields id,title",
        "meili get documents --index movies --all --output ndjson",
      ],
      "flags": [
        {
          "description": "The index to read the documents from.",
          "helpValue": "<index>",
          "name": "index",
          "required": true,
          "type": "option",
        },
        {
          "description": "Identifiers of the documents to return.",
          "helpValue": "<ids>",
          "name": "ids",
          "type": "option",
        },
        {
          "description": "A filter expression, on the filterable attributes of the index.",
          "helpValue": "<filter>",
          "name": "filter",
          "type": "option",
        },
        {
          "description": "Attributes to keep in each document.",
          "helpValue": "<attributes>",
          "name": "fields",
          "type": "option",
        },
        {
          "description": "Attributes to sort by, each one as attribute:asc or attribute:desc.",
          "helpValue": "<attributes>",
          "name": "sort",
          "type": "option",
        },
        {
          "description": "Add the embeddings of each document under _vectors.",
          "name": "retrieve-vectors",
          "type": "boolean",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "limit",
          "type": "option",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "offset",
          "type": "option",
        },
        {
          "description": "Fetch every page. Streams with ndjson, buffers into one array with json.",
          "name": "all",
          "type": "boolean",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
      ],
      "id": "get documents",
      "keyActions": [
        "documents.get",
      ],
      "routes": [
        "POST /indexes/{index_uid}/documents/fetch",
      ],
    },
    {
      "api": "meilisearch",
      "description": "Check that the Meilisearch instance is available.",
      "examples": [
        "meili get health",
        "meili get health --output json",
        "MEILI_PROJECT_URL=http://localhost:7700 meili get health",
      ],
      "flags": [],
      "id": "get health",
      "routes": [
        "GET /health",
      ],
    },
    {
      "api": "meilisearch",
      "description": "List the indexes of the instance, or get one with --id.",
      "examples": [
        "meili get indexes",
        "meili get indexes --output json",
        "meili get indexes --id movies",
        "meili get indexes --limit 5 --offset 10",
        "meili get indexes --all --output ndjson",
      ],
      "flags": [
        {
          "description": "The index to get. Without it, the command lists the indexes.",
          "helpValue": "<index>",
          "name": "id",
          "type": "option",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "limit",
          "type": "option",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "offset",
          "type": "option",
        },
        {
          "description": "Fetch every page. Streams with ndjson, buffers into one array with json.",
          "name": "all",
          "type": "boolean",
        },
      ],
      "id": "get indexes",
      "keyActions": [
        "indexes.get",
      ],
      "routes": [
        "GET /indexes",
        "GET /indexes/{index_uid}",
      ],
    },
    {
      "api": "meilisearch",
      "description": "List the tasks of the instance, which every write command enqueues, and filter them with the flags.",
      "examples": [
        "meili get tasks --ids 42 --output json",
        "meili get tasks --statuses failed --limit 5",
        "meili get tasks --index-ids movies --types documentAdditionOrUpdate",
        "meili get tasks --all --output ndjson",
      ],
      "flags": [
        {
          "description": "Identifiers of the tasks to return.",
          "helpValue": "<uids>",
          "name": "ids",
          "type": "option",
        },
        {
          "description": "Statuses to keep: enqueued, processing, succeeded, failed or canceled, comma-separated.",
          "helpValue": "<statuses>",
          "name": "statuses",
          "type": "option",
        },
        {
          "description": "Task types to keep, as the API spells them, comma-separated.",
          "helpValue": "<types>",
          "name": "types",
          "type": "option",
        },
        {
          "description": "Keep the tasks of these indexes.",
          "helpValue": "<indexes>",
          "name": "index-ids",
          "type": "option",
        },
        {
          "description": "Keep the tasks of these batches.",
          "helpValue": "<uids>",
          "name": "batch-ids",
          "type": "option",
        },
        {
          "description": "Keep the tasks canceled by these task identifiers.",
          "helpValue": "<uids>",
          "name": "canceled-by",
          "type": "option",
        },
        {
          "description": "Return the oldest tasks first.",
          "name": "reverse",
          "type": "boolean",
        },
        {
          "description": "Keep the tasks enqueued after this date, as RFC 3339.",
          "helpValue": "<date>",
          "name": "after-enqueued-at",
          "type": "option",
        },
        {
          "description": "Keep the tasks enqueued before this date, as RFC 3339.",
          "helpValue": "<date>",
          "name": "before-enqueued-at",
          "type": "option",
        },
        {
          "description": "Keep the tasks started after this date, as RFC 3339.",
          "helpValue": "<date>",
          "name": "after-started-at",
          "type": "option",
        },
        {
          "description": "Keep the tasks started before this date, as RFC 3339.",
          "helpValue": "<date>",
          "name": "before-started-at",
          "type": "option",
        },
        {
          "description": "Keep the tasks finished after this date, as RFC 3339.",
          "helpValue": "<date>",
          "name": "after-finished-at",
          "type": "option",
        },
        {
          "description": "Keep the tasks finished before this date, as RFC 3339.",
          "helpValue": "<date>",
          "name": "before-finished-at",
          "type": "option",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "limit",
          "type": "option",
        },
        {
          "description": "Identifier of the first item of the page. Passed to the API.",
          "helpValue": "<uid>",
          "name": "from",
          "type": "option",
        },
        {
          "description": "Fetch every page. Streams with ndjson, buffers into one array with json.",
          "name": "all",
          "type": "boolean",
        },
      ],
      "id": "get tasks",
      "keyActions": [
        "tasks.get",
      ],
      "routes": [
        "GET /tasks",
      ],
    },
    {
      "api": "none",
      "description": "Print one line per command, or one command in full with --command, from the oclif manifest.",
      "examples": [
        "meili schema",
        "meili schema --output json",
        "meili schema --command "get indexes"",
        "meili schema | jq '.commands[].id'",
      ],
      "flags": [
        {
          "description": "Print this command in full instead of the index: its API, its routes, its key actions, the flags it declares itself and its examples.",
          "helpValue": "<command>",
          "name": "command",
          "type": "option",
        },
      ],
      "id": "schema",
    },
    {
      "api": "meilisearch",
      "description": "Search an index, and get the hits with the API envelope around them.",
      "examples": [
        "meili search --index movies --q nosferatu",
        "meili search --index movies --q vampire --limit 5 --output json",
        "meili search --index movies --filter 'year > 1920' --sort year:asc",
        "meili search --index movies --data '{"q":"vampire","hybrid":{"embedder":"default"}}'",
      ],
      "flags": [
        {
          "description": "The index to search.",
          "helpValue": "<index>",
          "name": "index",
          "required": true,
          "type": "option",
        },
        {
          "description": "The search terms.",
          "helpValue": "<query>",
          "name": "q",
          "type": "option",
        },
        {
          "description": "A filter expression, on the filterable attributes of the index.",
          "helpValue": "<filter>",
          "name": "filter",
          "type": "option",
        },
        {
          "description": "Attributes to sort by, each one as attribute:asc or attribute:desc.",
          "helpValue": "<attributes>",
          "name": "sort",
          "type": "option",
        },
        {
          "description": "Maximum number of hits.",
          "helpValue": "<n>",
          "name": "limit",
          "type": "option",
        },
        {
          "description": "Number of hits to skip.",
          "helpValue": "<n>",
          "name": "offset",
          "type": "option",
        },
        {
          "description": "Page of hits to return. The envelope then carries totalHits and totalPages instead of estimatedTotalHits.",
          "helpValue": "<n>",
          "name": "page",
          "type": "option",
        },
        {
          "description": "Hits per page.",
          "helpValue": "<n>",
          "name": "hits-per-page",
          "type": "option",
        },
        {
          "description": "Attributes to return facet counts for.",
          "helpValue": "<attributes>",
          "name": "facets",
          "type": "option",
        },
        {
          "description": "Attributes to keep in each hit.",
          "helpValue": "<attributes>",
          "name": "attributes-to-retrieve",
          "type": "option",
        },
        {
          "description": "Attributes to search in, among the searchable ones.",
          "helpValue": "<attributes>",
          "name": "attributes-to-search-on",
          "type": "option",
        },
        {
          "description": "Return one hit per distinct value of this attribute.",
          "helpValue": "<attribute>",
          "name": "distinct",
          "type": "option",
        },
        {
          "description": "How the engine drops query terms when a document matches none of them.",
          "helpValue": "<strategy>",
          "name": "matching-strategy",
          "options": [
            "last",
            "all",
            "frequency",
          ],
          "type": "option",
        },
        {
          "description": "Add _rankingScore to every hit.",
          "name": "show-ranking-score",
          "type": "boolean",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
