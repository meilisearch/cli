        "meili update settings --index movies --filterable-attributes genres,release_date --output json",
        "meili update settings --index movies --stop-words null",
        "meili update settings --index movies --typo-tolerance '{"enabled":false}' --wait",
        "meili update settings --index movies --file settings.json",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
