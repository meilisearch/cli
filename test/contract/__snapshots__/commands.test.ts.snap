          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
      ],
      "id": "multi-search",
      "keyActions": [
        "search",
      ],
      "routes": [
        "POST /multi-search",
      ],
