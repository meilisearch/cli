    {
      "api": "management",
      "async": true,
      "description": "Create a Meilisearch Cloud project.

Creates it in a team, on a resource. The master key is printed masked: give --sync-config to write it to the config file instead.",
      "examples": [
        "meili project add --name demo --team-id 12 --resource-id 3",
        "meili project add --name demo --team-id 12 --resource-id 3 --sync-config",
        "meili project add --name demo --team-id 12 --resource-id 3 --wait --sync-config",
        "meili project add --name demo --team-id 12 --resource-id 3 --ms-version v1.54.0",
        "meili project add --data '{"name":"demo","teamId":12,"resourceId":3}'",
        "meili project add --file project.json --name other-name",
      ],
      "flags": [
        {
          "description": "Name of the project.",
          "helpValue": "<name>",
          "name": "name",
          "type": "option",
        },
        {
          "description": "Team that owns the project.",
          "helpValue": "<id>",
          "name": "team-id",
          "type": "option",
        },
        {
          "description": "Resource of the project: its plan and its region.",
          "helpValue": "<id>",
          "name": "resource-id",
          "type": "option",
        },
        {
          "description": "Meilisearch version of the project, the latest by default.",
          "helpValue": "<version>",
          "name": "ms-version",
          "type": "option",
        },
        {
          "description": "Add the project to the config file, as an entry named after it with its URL, its master key and its cloud identifiers.",
          "name": "sync-config",
          "type": "boolean",
        },
        {
          "description": "Poll the project until its status is running or failed, then print it.",
          "name": "wait",
          "type": "boolean",
        },
        {
          "dependsOn": [
            "wait",
          ],
          "description": "Maximum wait time, for example 30s, 2m. Default 10m. Only with --wait.",
          "helpValue": "<duration>",
          "name": "timeout",
          "type": "option",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
      ],
      "id": "project add",
      "routes": [
        "POST /api/v2/projects",
      ],
