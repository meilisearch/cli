    {
      "api": "meilisearch",
      "async": true,
      "description": "Reset the settings of an index.

Every setting goes back to its default value, which reindexes the documents.",
      "examples": [
        "meili settings delete --project prod --index movies --yes",
        "meili settings delete -p prod -i movies --yes --wait",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to. One of --project or --project-url is required.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "char": "p",
          "description": "A project of the config file. Cannot be combined with --project-url. One of --project or --project-url is required.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "char": "i",
          "description": "The index to reset the settings of. \`settings update --<setting> null\` resets one of them.",
          "helpValue": "<index>",
          "name": "index",
          "required": true,
          "type": "option",
        },
        {
          "description": "Poll the task until it reaches a final status, then print the final task.",
          "name": "wait",
          "type": "boolean",
        },
        {
          "dependsOn": [
            "wait",
          ],
          "description": "Maximum wait time, for example 30s, 2m. Default 10m. Only with --wait.",
          "helpValue": "<duration>",
          "name": "timeout",
          "type": "option",
        },
        {
          "description": "Confirm the deletion. Nothing is sent to the API without it.",
          "name": "yes",
          "required": true,
          "type": "boolean",
        },
      ],
      "id": "settings delete",
      "keyActions": [
        "settings.update",
      ],
      "routes": [
        "DELETE /indexes/{index_uid}/settings",
      ],
    },
    {
      "api": "meilisearch",
