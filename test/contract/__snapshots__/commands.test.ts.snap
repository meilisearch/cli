      "api": "meilisearch",
      "description": "List the tasks of the instance.

--ids, --statuses, --types and the other filters of the route narrow the list.",
      "examples": [
        "meili task list --project prod",
        "meili task list -p prod --ids 42",
        "meili task list -p prod --statuses failed,canceled --limit 5",
        "meili task list -p prod --index-ids movies --types documentAdditionOrUpdate",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to. One of --project or --project-url is required.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "char": "p",
          "description": "A project of the config file. Cannot be combined with --project-url. One of --project or --project-url is required.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "description": "Task uids to match, comma-separated. \`*\` matches every one.",
          "helpValue": "<uids>",
          "name": "ids",
          "type": "option",
        },
        {
          "description": "Match the tasks of these batch uids, comma-separated. \`*\` matches every one.",
          "helpValue": "<uids>",
          "name": "batch-ids",
          "type": "option",
        },
        {
          "description": "Match the tasks of these indexes, comma-separated. \`*\` matches every one.",
          "helpValue": "<indexes>",
          "name": "index-ids",
          "type": "option",
        },
        {
          "description": "Match the tasks canceled by these taskCancelation uids, comma-separated. \`*\` matches every one.",
          "helpValue": "<uids>",
          "name": "canceled-by",
          "type": "option",
        },
        {
          "description": "Task types to match, comma-separated, as the \`type\` field of a task spells them, for example \`documentAdditionOrUpdate\`. \`*\` matches every one.",
          "helpValue": "<types>",
          "name": "types",
          "type": "option",
        },
        {
          "description": "Task statuses to match, comma-separated: enqueued, processing, succeeded, failed or canceled. \`*\` matches every one.",
          "helpValue": "<statuses>",
          "name": "statuses",
          "type": "option",
        },
        {
          "description": "Match the tasks enqueued after this date, in RFC 3339 format.",
          "helpValue": "<date>",
          "name": "after-enqueued-at",
          "type": "option",
        },
        {
          "description": "Match the tasks enqueued before this date, in RFC 3339 format.",
          "helpValue": "<date>",
          "name": "before-enqueued-at",
          "type": "option",
        },
        {
          "description": "Match the tasks started after this date, in RFC 3339 format.",
          "helpValue": "<date>",
          "name": "after-started-at",
          "type": "option",
        },
        {
          "description": "Match the tasks started before this date, in RFC 3339 format.",
          "helpValue": "<date>",
          "name": "before-started-at",
          "type": "option",
        },
        {
          "description": "Match the tasks finished after this date, in RFC 3339 format.",
          "helpValue": "<date>",
          "name": "after-finished-at",
          "type": "option",
        },
        {
          "description": "Match the tasks finished before this date, in RFC 3339 format.",
          "helpValue": "<date>",
          "name": "before-finished-at",
          "type": "option",
        },
        {
          "description": "Return the tasks from the oldest uid up, instead of the newest down.",
          "name": "reverse",
          "type": "boolean",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "limit",
          "type": "option",
        },
        {
          "description": "Passed to the API: the uid the page starts at, going down.",
          "helpValue": "<uid>",
          "name": "from",
          "type": "option",
        },
        {
          "description": "Fetch every page, and print them as one list.",
          "name": "all",
          "type": "boolean",
        },
      ],
      "id": "task list",
      "keyActions": [
        "tasks.get",
