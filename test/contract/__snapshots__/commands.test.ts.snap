          "helpValue": "<command>",
          "name": "command",
          "type": "option",
        },
      ],
      "id": "schema",
    },
    {
      "api": "meilisearch",
      "async": true,
      "description": "Update documents of an index, merging each one into the stored document that shares its identifier.",
      "examples": [
        "meili update documents --index movies --file patch.json",
        "meili update documents --index movies --file - --wait --output json",
        "meili update documents --index movies --data '[{"id":1,"rating":9}]'",
