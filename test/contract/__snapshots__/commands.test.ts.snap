      "api": "meilisearch",
      "description": "List the API keys of the instance.

The answer is the API body as it is, so it carries the \`key\` field of every key it returns: credentials that work, on stdout, like any other data.",
      "examples": [
        "meili key list --project prod",
        "meili key list -p prod --limit 5 --offset 10",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to. One of --project or --project-url is required.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "char": "p",
          "description": "A project of the config file. Cannot be combined with --project-url. One of --project or --project-url is required.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "limit",
          "type": "option",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "offset",
          "type": "option",
        },
        {
          "description": "Fetch every page, and print them as one list.",
          "name": "all",
          "type": "boolean",
        },
      ],
      "id": "key list",
      "keyActions": [
        "keys.get",
      ],
      "routes": [
        "GET /keys",
      ],
    },
    {
      "api": "meilisearch",
      "description": "Change the name or the description of an API key.

These are the two fields the route takes. The value null resets one.",
      "examples": [
        "meili key update --project prod --id 52787ccd-48ff-48e5-9c4b-03cd76978a60 --name 'CI indexer'",
        "meili key update -p prod --id 52787ccd-48ff-48e5-9c4b-03cd76978a60 --description 'Indexes the catalog nightly'",
        "meili key update -p prod --id 52787ccd-48ff-48e5-9c4b-03cd76978a60 --description null",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to. One of --project or --project-url is required.",
