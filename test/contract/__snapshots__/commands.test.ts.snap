// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`oclif.manifest.json > \`meili schema\` is a snapshot, the index and every command in full, so a renamed command or flag is visible in review 1`] = `
{
  "commands": [
    {
      "api": "none",
      "description": "Log in to Meilisearch Cloud, or create an account, in a browser.

Stores the token for the management commands.",
      "examples": [
        "meili auth login",
        "meili auth login --no-browser",
      ],
      "flags": [
        {
          "description": "Open the consent page in a browser. --no-browser only prints the URL.",
          "name": "browser",
          "type": "boolean",
        },
      ],
      "id": "auth login",
    },
    {
      "api": "none",
      "description": "Log out of Meilisearch Cloud.

Revokes the token of \`auth login\` and forgets it. Does nothing when nobody is logged in.",
      "examples": [
        "meili auth logout",
      ],
      "flags": [],
      "id": "auth logout",
    },
    {
      "api": "none",
      "description": "Refresh the Meilisearch Cloud session.

Trades the refresh token of the stored session for a new access token, before it expires.",
      "examples": [
        "meili auth refresh",
      ],
      "flags": [],
      "id": "auth refresh",
    },
    {
      "api": "none",
      "description": "Show the Meilisearch Cloud session.

Says whether a session of \`auth login\` exists, whether the authorization server still accepts it, and who it logs in.",
      "examples": [
        "meili auth status",
      ],
      "flags": [],
      "id": "auth status",
    },
    {
      "api": "meilisearch",
      "description": "List the batches of tasks.

--ids, --task-ids, --statuses and the other filters of the route narrow the list.",
      "examples": [
        "meili batch list --project prod",
        "meili batch list -p prod --ids 7",
        "meili batch list -p prod --task-ids 42",
        "meili batch list -p prod --statuses failed --index-ids movies --limit 5",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to. One of --project or --project-url is required.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "char": "p",
          "description": "A project of the config file. Cannot be combined with --project-url. One of --project or --project-url is required.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "description": "Batch uids to match, comma-separated. \`*\` matches every one.",
          "helpValue": "<uids>",
          "name": "ids",
          "type": "option",
        },
        {
          "description": "Match the batches of these task uids, comma-separated. \`*\` matches every one.",
          "helpValue": "<uids>",
          "name": "task-ids",
          "type": "option",
        },
        {
          "description": "Match the tasks of these indexes, comma-separated. \`*\` matches every one.",
          "helpValue": "<indexes>",
          "name": "index-ids",
          "type": "option",
        },
        {
          "description": "Match the tasks canceled by these taskCancelation uids, comma-separated. \`*\` matches every one.",
          "helpValue": "<uids>",
          "name": "canceled-by",
          "type": "option",
        },
        {
          "description": "Task types to match, comma-separated, as the \`type\` field of a task spells them, for example \`documentAdditionOrUpdate\`. \`*\` matches every one.",
          "helpValue": "<types>",
          "name": "types",
          "type": "option",
        },
        {
          "description": "Task statuses to match, comma-separated: enqueued, processing, succeeded, failed or canceled. \`*\` matches every one.",
          "helpValue": "<statuses>",
          "name": "statuses",
          "type": "option",
        },
        {
          "description": "Match the tasks enqueued after this date, in RFC 3339 format.",
          "helpValue": "<date>",
          "name": "after-enqueued-at",
          "type": "option",
        },
        {
          "description": "Match the tasks enqueued before this date, in RFC 3339 format.",
          "helpValue": "<date>",
          "name": "before-enqueued-at",
          "type": "option",
        },
        {
          "description": "Match the tasks started after this date, in RFC 3339 format.",
          "helpValue": "<date>",
          "name": "after-started-at",
          "type": "option",
        },
        {
          "description": "Match the tasks started before this date, in RFC 3339 format.",
          "helpValue": "<date>",
          "name": "before-started-at",
          "type": "option",
        },
        {
          "description": "Match the tasks finished after this date, in RFC 3339 format.",
          "helpValue": "<date>",
          "name": "after-finished-at",
          "type": "option",
        },
        {
          "description": "Match the tasks finished before this date, in RFC 3339 format.",
          "helpValue": "<date>",
          "name": "before-finished-at",
          "type": "option",
        },
        {
          "description": "Return the batches from the oldest uid up, instead of the newest down.",
          "name": "reverse",
          "type": "boolean",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "limit",
          "type": "option",
        },
        {
          "description": "Passed to the API: the uid the page starts at, going down.",
          "helpValue": "<uid>",
          "name": "from",
          "type": "option",
        },
        {
          "description": "Fetch every page, and print them as one list.",
          "name": "all",
          "type": "boolean",
        },
      ],
      "id": "batch list",
      "keyActions": [
        "tasks.get",
      ],
      "routes": [
        "GET /batches",
      ],
    },
    {
      "api": "meilisearch",
      "description": "Get one batch of tasks.",
      "examples": [
        "meili batch view --project prod --id 7",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to. One of --project or --project-url is required.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "char": "p",
          "description": "A project of the config file. Cannot be combined with --project-url. One of --project or --project-url is required.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "description": "The batch uid.",
          "helpValue": "<uid>",
          "name": "id",
          "required": true,
          "type": "option",
        },
      ],
      "id": "batch view",
      "keyActions": [
        "tasks.get",
      ],
      "routes": [
        "GET /batches/{batch_id}",
      ],
    },
    {
      "api": "none",
      "description": "List the projects of the config file.

Prints the path of the file and its projects as JSON, keys masked.",
      "examples": [
        "meili config list",
        "MEILI_CONFIG=./meili.json meili config list",
      ],
      "flags": [],
      "id": "config list",
    },
    {
      "api": "none",
      "description": "Add a project to the config file.

Creates the file, owner-only, and refuses a name that exists. Talks to the Management API only with --sync-with-cloud.",
      "examples": [
        "meili config set --project local --project-url http://localhost:7700",
        "meili config set -p prod --project-url https://ms-abc.sfo.meilisearch.io --project-api-key - < key.txt",
        "meili config set -p prod --project-url https://ms-abc.sfo.meilisearch.io --sync-with-cloud",
      ],
      "flags": [
        {
          "char": "p",
          "description": "Name of the project to set.",
          "helpValue": "<name>",
          "name": "project",
          "required": true,
          "type": "option",
        },
        {
          "description": "URL of the project.",
          "helpValue": "<url>",
          "name": "project-url",
          "required": true,
          "type": "option",
        },
        {
          "description": "API key of the project. \`-\` reads it from stdin, out of the shell history.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "description": "Write the entry's cloud identifiers from Meilisearch Cloud, and its master key when the entry has no key. Never replaces a key.",
          "name": "sync-with-cloud",
          "type": "boolean",
        },
      ],
      "id": "config set",
    },
    {
      "api": "management",
      "description": "Add the Meilisearch Cloud projects to the config file.

Gives every project of the scope an entry, with its cloud identifiers, and its master key when the entry has no key. Never replaces a key, never removes an entry. Prints one item per project.",
      "examples": [
        "meili config sync-with-cloud --all",
        "meili config sync-with-cloud --team-ids 12,13",
        "meili config sync-with-cloud --project-name prod",
        "meili config sync-with-cloud --project-url https://ms-abc.sfo.meilisearch.io",
      ],
      "flags": [
        {
          "description": "Every project the token sees.",
          "name": "all",
          "type": "boolean",
        },
        {
          "description": "The projects of these teams, comma-separated.",
          "helpValue": "<ids>",
          "name": "team-ids",
          "type": "option",
        },
        {
          "description": "The projects with exactly this name, in any team.",
          "helpValue": "<name>",
          "name": "project-name",
          "type": "option",
        },
        {
          "description": "The project with this URL, same scheme and host.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
      ],
      "id": "config sync-with-cloud",
    },
    {
      "api": "none",
      "description": "Remove a project from the config file.",
      "examples": [
        "meili config unset --project prod",
      ],
      "flags": [
        {
          "char": "p",
          "description": "Name of the project to remove.",
          "helpValue": "<name>",
          "name": "project",
          "required": true,
          "type": "option",
        },
      ],
      "id": "config unset",
    },
    {
      "api": "none",
      "description": "Change a project of the config file.

Changes the fields given, and refuses a name that does not exist. Talks to the Management API only with --sync-with-cloud.",
      "examples": [
        "meili config update --project prod --sync-with-cloud",
        "meili config update -p prod --project-api-key - < key.txt",
        "meili config update -p local --project-url http://localhost:7701",
      ],
      "flags": [
        {
          "char": "p",
          "description": "Name of the project to change.",
          "helpValue": "<name>",
          "name": "project",
          "required": true,
          "type": "option",
        },
        {
          "description": "New URL of the project.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "New API key of the project. \`-\` reads it from stdin, out of the shell history.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "description": "Write the entry's cloud identifiers from Meilisearch Cloud, and its master key when the entry has no key. Never replaces a key.",
          "name": "sync-with-cloud",
          "type": "boolean",
        },
      ],
      "id": "config update",
    },
    {
      "api": "meilisearch",
      "async": true,
      "description": "Add or replace documents in an index.

A document replaces the one that has the same primary key.",
      "examples": [
        "meili document add --project prod --index movies --file movies.json",
        "cat movies.json | meili document add -p prod -i movies --file -",
        "meili document add -p prod -i movies --data '[{"id":1,"title":"Nosferatu"}]' --primary-key id",
        "meili document add -p prod -i movies --file movies.json --wait",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to. One of --project or --project-url is required.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "char": "p",
          "description": "A project of the config file. Cannot be combined with --project-url. One of --project or --project-url is required.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "char": "i",
          "description": "The index to add the documents to.",
          "helpValue": "<index>",
          "name": "index",
          "required": true,
          "type": "option",
        },
        {
          "description": "Primary key of the index. Only taken into account on its first documents.",
          "helpValue": "<field>",
          "name": "primary-key",
          "type": "option",
        },
        {
          "description": "String attached to the task, returned in the task object.",
          "helpValue": "<string>",
          "name": "custom-metadata",
          "type": "option",
        },
        {
          "description": "Only update documents that already exist, ignore the new ones.",
          "name": "skip-creation",
          "type": "boolean",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
        {
          "description": "Poll the task until it reaches a final status, then print the final task.",
          "name": "wait",
          "type": "boolean",
        },
        {
          "dependsOn": [
            "wait",
          ],
          "description": "Maximum wait time, for example 30s, 2m. Default 10m. Only with --wait.",
          "helpValue": "<duration>",
          "name": "timeout",
          "type": "option",
        },
      ],
      "id": "document add",
      "keyActions": [
        "documents.add",
      ],
      "routes": [
        "POST /indexes/{index_uid}/documents",
      ],
    },
    {
      "api": "meilisearch",
      "async": true,
      "description": "Delete documents from an index.

Deletes the documents named by --ids, matched by --filter, or every one of them with --all.",
      "examples": [
        "meili document delete --project prod --index movies --ids 42,1344 --yes",
        "meili document delete -p prod -i movies --ids 42 --yes",
        "meili document delete -p prod -i movies --filter 'rating < 2' --yes",
        "meili document delete -p prod -i movies --file ids.json --yes",
        "meili document delete -p prod -i movies --all --yes --wait",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to. One of --project or --project-url is required.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "char": "p",
          "description": "A project of the config file. Cannot be combined with --project-url. One of --project or --project-url is required.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "char": "i",
          "description": "The index to delete the documents from.",
          "helpValue": "<index>",
          "name": "index",
          "required": true,
          "type": "option",
        },
        {
          "description": "Document identifiers to delete, comma-separated.",
          "exclusive": [
            "filter",
            "all",
          ],
          "helpValue": "<ids>",
          "name": "ids",
          "type": "option",
        },
        {
          "description": "Delete the documents matching this filter expression, for example \`rating < 2\`.",
          "exclusive": [
            "ids",
            "all",
          ],
          "helpValue": "<filter>",
          "name": "filter",
          "type": "option",
        },
        {
          "description": "Delete every document of the index.",
          "exclusive": [
            "ids",
            "filter",
            "file",
            "data",
          ],
          "name": "all",
          "type": "boolean",
        },
        {
          "description": "String attached to the task, returned in the task object.",
          "helpValue": "<string>",
          "name": "custom-metadata",
          "type": "option",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
        {
          "description": "Poll the task until it reaches a final status, then print the final task.",
          "name": "wait",
          "type": "boolean",
        },
        {
          "dependsOn": [
            "wait",
          ],
          "description": "Maximum wait time, for example 30s, 2m. Default 10m. Only with --wait.",
          "helpValue": "<duration>",
          "name": "timeout",
          "type": "option",
        },
        {
          "description": "Confirm the deletion. Nothing is sent to the API without it.",
          "name": "yes",
          "required": true,
          "type": "boolean",
        },
      ],
      "id": "document delete",
      "keyActions": [
        "documents.delete",
      ],
      "routes": [
        "DELETE /indexes/{index_uid}/documents",
        "POST /indexes/{index_uid}/documents/delete",
        "POST /indexes/{index_uid}/documents/delete-batch",
      ],
    },
    {
      "api": "meilisearch",
      "description": "List the documents of an index.

--ids or --filter narrow the list. --limit and --offset page through it. There is no --all: an index can hold millions of documents.",
      "examples": [
        "meili document list --project prod --index movies",
        "meili document list -p prod -i movies --ids 42,1344 --fields id,title",
        "meili document list -p prod -i movies --filter 'rating > 4' --sort rating:desc",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to. One of --project or --project-url is required.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "char": "p",
          "description": "A project of the config file. Cannot be combined with --project-url. One of --project or --project-url is required.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "char": "i",
          "description": "The index to read the documents from.",
          "helpValue": "<index>",
          "name": "index",
          "required": true,
          "type": "option",
        },
        {
          "description": "Document identifiers to return, comma-separated.",
          "helpValue": "<ids>",
          "name": "ids",
          "type": "option",
        },
        {
          "description": "Filter expression, for example \`rating > 4\`. Its array-of-arrays form goes through --data.",
          "helpValue": "<filter>",
          "name": "filter",
          "type": "option",
        },
        {
          "description": "Document attributes to return, comma-separated. Defaults to all of them.",
          "helpValue": "<fields>",
          "name": "fields",
          "type": "option",
        },
        {
          "description": "Attributes to sort on, comma-separated, each as \`attribute:asc\` or \`:desc\`.",
          "helpValue": "<sort>",
          "name": "sort",
          "type": "option",
        },
        {
          "description": "Include the vector embeddings of the documents that have them.",
          "name": "retrieve-vectors",
          "type": "boolean",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "limit",
          "type": "option",
        },
        {
          "description": "Passed to the API.",
          "helpValue": "<n>",
          "name": "offset",
          "type": "option",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
      ],
      "id": "document list",
      "keyActions": [
        "documents.get",
      ],
      "routes": [
        "POST /indexes/{index_uid}/documents/fetch",
      ],
    },
    {
      "api": "meilisearch",
      "async": true,
      "description": "Add or update documents in an index.

The fields of a document are merged into the one that has the same primary key.",
      "examples": [
        "meili document update --project prod --index movies --file changes.json",
        "cat changes.json | meili document update -p prod -i movies --file -",
        "meili document update -p prod -i movies --data '[{"id":1,"rating":4}]'",
        "meili document update -p prod -i movies --file changes.json --wait",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to. One of --project or --project-url is required.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "char": "p",
          "description": "A project of the config file. Cannot be combined with --project-url. One of --project or --project-url is required.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "char": "i",
          "description": "The index to update the documents of.",
          "helpValue": "<index>",
          "name": "index",
          "required": true,
          "type": "option",
        },
        {
          "description": "Primary key of the index. Only taken into account on its first documents.",
          "helpValue": "<field>",
          "name": "primary-key",
          "type": "option",
        },
        {
          "description": "String attached to the task, returned in the task object.",
          "helpValue": "<string>",
          "name": "custom-metadata",
          "type": "option",
        },
        {
          "description": "Only update documents that already exist, ignore the new ones.",
          "name": "skip-creation",
          "type": "boolean",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
        {
          "description": "Poll the task until it reaches a final status, then print the final task.",
          "name": "wait",
          "type": "boolean",
        },
        {
          "dependsOn": [
            "wait",
          ],
          "description": "Maximum wait time, for example 30s, 2m. Default 10m. Only with --wait.",
          "helpValue": "<duration>",
          "name": "timeout",
          "type": "option",
        },
      ],
      "id": "document update",
      "keyActions": [
        "documents.add",
      ],
      "routes": [
        "PUT /indexes/{index_uid}/documents",
      ],
    },
    {
      "api": "meilisearch",
      "description": "Get one document of an index.",
      "examples": [
        "meili document view --project prod --index movies --id 42",
        "meili document view -p prod -i movies --id 42 --fields id,title",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to. One of --project or --project-url is required.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "char": "p",
          "description": "A project of the config file. Cannot be combined with --project-url. One of --project or --project-url is required.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "char": "i",
          "description": "The index to read the document from.",
          "helpValue": "<index>",
          "name": "index",
          "required": true,
          "type": "option",
        },
        {
          "description": "The document identifier.",
          "helpValue": "<id>",
          "name": "id",
          "required": true,
          "type": "option",
        },
        {
          "description": "Document attributes to return, comma-separated. Defaults to all of them.",
          "helpValue": "<fields>",
          "name": "fields",
          "type": "option",
        },
        {
          "description": "Include the vector embeddings of the document, if it has them.",
          "name": "retrieve-vectors",
          "type": "boolean",
        },
      ],
      "id": "document view",
      "keyActions": [
        "documents.get",
      ],
      "routes": [
        "GET /indexes/{index_uid}/documents/{document_id}",
      ],
    },
    {
      "api": "meilisearch",
      "async": true,
      "description": "Export the data of the instance to another instance.

Sends the documents and the settings to the destination instance, and prints the task that does it.

The source is the project this command connects to, named by --project, --project-url and --project-api-key as on every command: it receives the request and does the export. The destination is --url with --api-key, or --project-destination, an entry of the config file. --indexes narrows the export to the indexes those patterns match.",
      "examples": [
        "meili export --project prod --url https://ms-1234.heaven.meilisearch.com --api-key <key>",
        "meili export -p staging --project-destination prod",
        "meili export -p prod --url http://localhost:7701 --indexes '{"movies":{"filter":"rating > 4"}}' --wait",
        "meili export -p prod --url http://localhost:7701 --payload-size 24MiB",
        "meili export -p prod --data '{"url":"http://localhost:7701","indexes":{"*":{"overrideSettings":true}}}'",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to. One of --project or --project-url is required.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "char": "p",
          "description": "A project of the config file. Cannot be combined with --project-url. One of --project or --project-url is required.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "description": "URL of the destination instance, the one the data is sent to.",
          "helpValue": "<url>",
          "name": "url",
          "type": "option",
        },
        {
          "description": "API key of the destination instance, the one the export writes with. --project-api-key stays the key of the source.",
          "helpValue": "<key>",
          "name": "api-key",
          "type": "option",
        },
        {
          "description": "A project of the config file, the destination: its URL and its key stand for --url and --api-key. Cannot be combined with --url. --api-key replaces its key.",
          "exclusive": [
            "url",
          ],
          "helpValue": "<name>",
          "name": "project-destination",
          "type": "option",
        },
        {
          "description": "Maximum size of one request sent to the destination, for example 24MiB.",
          "helpValue": "<size>",
          "name": "payload-size",
          "type": "option",
        },
        {
          "description": "The indexes to export and how, as JSON: an index pattern per key, its filter and overrideSettings as value. Every index by default, \`{"*":{}}\`.",
          "helpValue": "<json>",
          "name": "indexes",
          "type": "option",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
        {
          "description": "Poll the task until it reaches a final status, then print the final task.",
          "name": "wait",
          "type": "boolean",
        },
        {
          "dependsOn": [
            "wait",
          ],
          "description": "Maximum wait time, for example 30s, 2m. Default 10m. Only with --wait.",
          "helpValue": "<duration>",
          "name": "timeout",
          "type": "option",
        },
      ],
      "id": "export",
      "keyActions": [
        "export",
      ],
      "routes": [
        "POST /export",
      ],
    },
    {
      "api": "meilisearch",
      "description": "Search the values of a facet.

Counts the values on the documents that --q and --filter keep.",
      "examples": [
        "meili facet-search --project prod --index movies --facet-name genres --facet-query ac",
        "meili facet-search -p prod -i movies --facet-name genres --q horror --filter 'rating > 4'",
        "meili facet-search -p prod -i movies --data '{"facetName":"genres","facetQuery":"ac"}'",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to. One of --project or --project-url is required.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "char": "p",
          "description": "A project of the config file. Cannot be combined with --project-url. One of --project or --project-url is required.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "char": "i",
          "description": "The index to search the facet values in.",
          "helpValue": "<index>",
          "name": "index",
          "required": true,
          "type": "option",
        },
        {
          "description": "The facet attribute to search in. It must be one of the filterable attributes of the index.",
          "helpValue": "<attribute>",
          "name": "facet-name",
          "type": "option",
        },
        {
          "description": "The terms the facet values are matched against, the first word only. Omit it to return every value, up to 100.",
          "helpValue": "<query>",
          "name": "facet-query",
          "type": "option",
        },
        {
          "description": "The search terms that narrow the documents the facet values are computed on, not the values themselves.",
          "helpValue": "<query>",
          "name": "q",
          "type": "option",
        },
        {
          "description": "Filter expression, for example \`rating > 4\`. Its array-of-arrays form goes through --data.",
          "helpValue": "<filter>",
          "name": "filter",
          "type": "option",
        },
        {
          "description": "How the terms of --q are relaxed when there are not enough results.",
          "name": "matching-strategy",
          "options": [
            "last",
            "all",
            "frequency",
          ],
          "type": "option",
        },
        {
          "description": "Restrict the search of --q to these searchable attributes, comma-separated.",
          "helpValue": "<fields>",
          "name": "attributes-to-search-on",
          "type": "option",
        },
        {
          "description": "Count only the documents whose ranking score reaches this value, between 0.0 and 1.0.",
          "helpValue": "<number>",
          "name": "ranking-score-threshold",
          "type": "option",
        },
        {
          "description": "ISO-639 locales of the query, comma-separated, instead of auto-detection.",
          "helpValue": "<locales>",
          "name": "locales",
          "type": "option",
        },
        {
          "description": "Hybrid search as JSON, for example \`{"embedder":"default","semanticRatio":0.5}\`.",
          "helpValue": "<json>",
          "name": "hybrid",
          "type": "option",
        },
        {
          "description": "Query vector for a user-provided embedder, comma-separated numbers.",
          "helpValue": "<numbers>",
          "name": "vector",
          "type": "option",
        },
        {
          "description": "Count the facet values exhaustively instead of estimating the counts.",
          "name": "exhaustive-facet-count",
          "type": "boolean",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
            "data",
          ],
          "helpValue": "<path>",
          "name": "file",
          "type": "option",
        },
        {
          "description": "Inline JSON body.",
          "helpValue": "<json>",
          "name": "data",
          "type": "option",
        },
      ],
      "id": "facet-search",
      "keyActions": [
        "search",
      ],
      "routes": [
        "POST /indexes/{index_uid}/facet-search",
      ],
    },
