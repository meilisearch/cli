        ],
      },
      {
        "description": "List the indexes of the instance, or get one with --id.",
        "id": "get indexes",
        "routes": [
          "GET /indexes",
          "GET /indexes/{index_uid}",
        ],
      },
      {
        "description": "List the tasks of the instance, which every write command enqueues, and filter them with the flags.",
        "id": "get tasks",
        "routes": [
