    {
      "api": "meilisearch",
      "description": "Run several searches in one request.

Each query of --queries names its index. The results come side by side, or merged into one ranked list with --federation.",
      "examples": [
        "meili multi-search --project prod --queries '[{"indexUid":"movies","q":"nosferatu"},{"indexUid":"books","q":"nosferatu"}]'",
        "meili multi-search -p prod --queries '[{"indexUid":"movies","q":"nosferatu"}]'",
        "meili multi-search -p prod --queries '[{"indexUid":"movies","q":"horror"},{"indexUid":"books","q":"horror"}]' --federation '{"limit":5}'",
        "cat queries.json | meili multi-search -p prod --file -",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to. One of --project or --project-url is required.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "char": "p",
          "description": "A project of the config file. Cannot be combined with --project-url. One of --project or --project-url is required.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "description": "The search queries as a JSON array, each one an index to search and its search parameters: \`[{"indexUid":"movies","q":"nosferatu"}]\`.",
          "helpValue": "<json>",
          "name": "queries",
          "type": "option",
        },
        {
          "description": "Merge the hits of every query into one ranked list, as JSON: \`{}\` for the defaults, \`{"limit":5}\` to narrow it. Without it each query answers its own envelope.",
          "helpValue": "<json>",
          "name": "federation",
          "type": "option",
        },
        {
          "description": "Read the body from a file. \`-\` reads from stdin.",
          "exclusive": [
