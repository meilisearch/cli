  "index": {
    "commands": [
      {
        "description": "Add documents to an index, replacing the ones that already have the same primary key.",
        "id": "add documents",
        "routes": [
          "POST /indexes/{index_uid}/documents",
        ],
      },
      {
        "description": "Create an empty index, named by --id, with --primary-key as its primary key.",
        "id": "add indexes",
        "routes": [
          "POST /indexes",
        ],
      },
      {
        "description": "Log in to Meilisearch Cloud with a browser, and store the token for the management commands.",
        "id": "auth login",
      },
      {
        "description": "Revoke the token of \`auth login\` and forget it. Does nothing when nobody is logged in.",
        "id": "auth logout",
      },
      {
        "description": "Trade the refresh token of the stored session for a new access token, before it expires.",
        "id": "auth refresh",
      },
      {
        "description": "Say whether a session of \`auth login\` exists and whether the authorization server still accepts it.",
        "id": "auth status",
      },
      {
        "description": "Cancel the enqueued and processing tasks matched by --ids, --statuses, --types and the other filters of the route.",
        "id": "cancel tasks",
        "routes": [
          "POST /tasks/cancel",
        ],
      },
      {
        "description": "Print the config file path and its projects as JSON, keys masked.",
        "id": "config list",
      },
      {
        "description": "Set a project in the config file, creating the file owner-only; refuses a name that exists.",
        "id": "config set",
      },
      {
        "description": "Remove a project from the config file.",
        "id": "config unset",
      },
      {
        "description": "Delete the documents of an index named by --ids, matched by --filter, or every one of them with --all.",
        "id": "delete documents",
        "routes": [
          "DELETE /indexes/{index_uid}/documents",
          "POST /indexes/{index_uid}/documents/delete",
          "POST /indexes/{index_uid}/documents/delete-batch",
        ],
      },
      {
        "description": "Delete an index, with its documents, its settings and its task history.",
        "id": "delete indexes",
        "routes": [
          "DELETE /indexes/{index_uid}",
        ],
      },
      {
        "description": "Reset every setting of an index to its default value, which reindexes the documents.",
        "id": "delete settings",
        "routes": [
          "DELETE /indexes/{index_uid}/settings",
        ],
      },
      {
        "description": "Delete the finished tasks matched by --ids, --statuses, --types and the other filters of the route.",
        "id": "delete tasks",
        "routes": [
          "DELETE /tasks",
        ],
      },
      {
        "description": "List the documents of an index, narrowed by --ids or by --filter.",
        "id": "get documents",
        "routes": [
          "POST /indexes/{index_uid}/documents/fetch",
        ],
      },
      {
        "description": "Check that the Meilisearch instance is available.",
        "id": "get health",
        "routes": [
          "GET /health",
        ],
      },
      {
        "description": "List the indexes of the instance, or get one with --id.",
        "id": "get indexes",
        "routes": [
          "GET /indexes",
          "GET /indexes/{index_uid}",
        ],
      },
      {
        "description": "Get every setting of an index, each with its current value or its default.",
        "id": "get settings",
        "routes": [
          "GET /indexes/{index_uid}/settings",
        ],
      },
      {
        "description": "List the tasks of the instance, narrowed by --ids, --statuses, --types and the other filters of the route.",
        "id": "get tasks",
        "routes": [
          "GET /tasks",
        ],
      },
      {
        "description": "Run several search queries in one request, each naming its index in --queries, returned side by side or merged into one ranked list with --federation.",
        "id": "multi-search",
        "routes": [
          "POST /multi-search",
        ],
      },
      {
        "description": "Print one line per command, or one command in full with --command, from the oclif manifest.",
        "id": "schema",
      },
      {
        "description": "Search the documents of an index, with --q and the search parameters of the route.",
        "id": "search",
        "routes": [
          "POST /indexes/{index_uid}/search",
        ],
      },
      {
        "description": "Find the documents an index holds that are closest to one of its documents, named by --id and compared with --embedder.",
        "id": "similar",
        "routes": [
          "POST /indexes/{index_uid}/similar",
        ],
      },
      {
        "description": "Add documents to an index, merging their fields into the ones that already have the same primary key.",
        "id": "update documents",
        "routes": [
          "PUT /indexes/{index_uid}/documents",
        ],
      },
      {
        "description": "Change the primary key of an index with --primary-key, or rename it with --new-id.",
        "id": "update indexes",
        "routes": [
          "PATCH /indexes/{index_uid}",
        ],
      },
      {
        "description": "Change the settings given, leave the others as they are, and reset one with the value null.",
        "id": "update settings",
        "routes": [
          "PATCH /indexes/{index_uid}/settings",
        ],
      },
    ],
    "globalFlags": [
      {
        "char": "o",
        "description": "json (default): one document, the API body as it is, indented in a terminal, compact when piped. ndjson: one item per line, list commands only, streams with --all.",
        "helpValue": "<mode>",
        "name": "output",
        "options": [
          "json",
          "ndjson",
        ],
        "type": "option",
      },
      {
        "description": "Print every HTTP request and response on stderr, secrets redacted.",
        "name": "debug",
        "type": "boolean",
      },
    ],
    "name": "meili",
    "version": "0.0.0",
  },
}
`;
