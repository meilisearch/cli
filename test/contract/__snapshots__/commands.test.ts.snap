    {
      "api": "none",
      "description": "Log in to Meilisearch Cloud with a browser, and store the token for the management commands.",
      "examples": [
        "meili auth login",
        "meili auth login --output json",
        "meili auth login --no-browser",
      ],
      "flags": [
        {
          "description": "The OAuth application to log in with, on a Cloud that is not Meilisearch Cloud. Also MEILI_MANAGEMENT_CLIENT_ID.",
          "helpValue": "<uid>",
          "name": "management-client-id",
          "type": "option",
        },
        {
          "description": "Management API base URL, which holds the token endpoint.",
          "helpValue": "<url>",
          "name": "management-url",
          "type": "option",
        },
        {
          "description": "Dashboard URL, which hosts the consent page.",
          "helpValue": "<url>",
          "name": "management-dashboard-url",
          "type": "option",
        },
        {
          "description": "Open the consent page in a browser. --no-browser only prints the URL.",
          "name": "browser",
          "type": "boolean",
        },
      ],
      "id": "auth login",
    },
    {
      "api": "none",
      "description": "Revoke the token of \`auth login\` and forget it. Does nothing when nobody is logged in.",
      "examples": [
        "meili auth logout",
        "meili auth logout --output json",
      ],
      "flags": [],
      "id": "auth logout",
    },
    {
      "api": "none",
      "description": "Trade the refresh token of the stored session for a new access token, before it expires.",
      "examples": [
        "meili auth refresh",
        "meili auth refresh --output json",
      ],
      "flags": [],
      "id": "auth refresh",
    },
    {
      "api": "none",
      "description": "Say whether a session of \`auth login\` exists and whether the authorization server still accepts it.",
      "examples": [
        "meili auth status",
        "meili auth status --output json",
      ],
      "flags": [],
      "id": "auth status",
    },
    {
      "api": "meilisearch",
      "async": true,
      "description": "Cancel the enqueued and processing tasks matched by --ids, --statuses, --types and the other filters of the route.",
      "examples": [
        "meili cancel tasks --ids 42,1344",
        "meili cancel tasks --ids 42 --output json",
        "meili cancel tasks --statuses enqueued --index-ids movies",
        "meili cancel tasks --statuses processing --wait",
      ],
      "flags": [
        {
          "description": "Project URL, the Meilisearch instance to talk to.",
          "helpValue": "<url>",
          "name": "project-url",
          "type": "option",
        },
        {
          "description": "Project API key. \`-\` reads it from stdin.",
          "helpValue": "<key>",
          "name": "project-api-key",
          "type": "option",
        },
        {
          "description": "A project of the config file. Cannot be combined with --project-url. Required when the file has several projects.",
          "helpValue": "<name>",
          "name": "project",
          "type": "option",
        },
        {
          "description": "Task uids to match, comma-separated. \`*\` matches every one.",
          "helpValue": "<uids>",
          "name": "ids",
          "type": "option",
        },
        {
          "description": "Match the tasks of these batch uids, comma-separated. \`*\` matches every one.",
          "helpValue": "<uids>",
          "name": "batch-ids",
          "type": "option",
        },
        {
          "description": "Match the tasks of these indexes, comma-separated. \`*\` matches every one.",
          "helpValue": "<indexes>",
          "name": "index-ids",
          "type": "option",
        },
        {
          "description": "Match the tasks canceled by these taskCancelation uids, comma-separated. \`*\` matches every one.",
          "helpValue": "<uids>",
          "name": "canceled-by",
          "type": "option",
        },
        {
          "description": "Task types to match, comma-separated, as the \`type\` field of a task spells them, for example \`documentAdditionOrUpdate\`. \`*\` matches every one.",
          "helpValue": "<types>",
          "name": "types",
          "type": "option",
        },
        {
          "description": "Task statuses to match, comma-separated: enqueued, processing, succeeded, failed or canceled. \`*\` matches every one.",
          "helpValue": "<statuses>",
          "name": "statuses",
          "type": "option",
        },
        {
          "description": "Match the tasks enqueued after this date, in RFC 3339 format.",
          "helpValue": "<date>",
