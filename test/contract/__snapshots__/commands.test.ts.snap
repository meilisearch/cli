          "name": "ranking-rules",
          "type": "option",
        },
        {
          "description": "Words ignored when they appear in a search query, comma-separated.",
          "helpValue": "<words>",
          "name": "stop-words",
          "type": "option",
        },
        {
          "description": "Characters removed from the default separators, comma-separated, so that they no longer split words.",
